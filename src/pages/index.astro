                    <span style="font-family:var(--font-mono);font-size:0.72rem;color:var(--text-muted);">{g.dates}</span>
                  </div>
                  <h4 style="font-size:1.15rem;font-weight:800;margin-bottom:0.35rem;letter-spacing:-0.02em;">{g.name}</h4>
                  <p style="font-size:0.82rem;color:var(--text-secondary);line-height:1.5;margin-bottom:0.85rem;">{g.tagline}</p>
                  
                  <div style="font-size:0.78rem;font-style:italic;color:var(--text-primary);background:var(--bg-card);border-left:3px solid var(--m-Sky-glow);padding:0.65rem 0.85rem;border-radius:0 8px 8px 0;margin-bottom:0.95rem;line-height:1.45;">
