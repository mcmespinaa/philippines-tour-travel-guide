---
import { DESTINATION_HUBS, FLIGHT_ROUTES, DAILY_ITINERARY, PACKING_CATEGORIES, ESSENTIAL_APPS, DESTINATION_GUIDES, RC_CAR_VENUES, TOP_MUSEUMS } from '../data/tourData';

const totalHotels = DESTINATION_HUBS.reduce((acc, h) => acc + h.hotels.length, 0);
const totalPackingItems = PACKING_CATEGORIES.reduce((acc, c) => acc + c.items.length, 0);
const cartoApiKey = import.meta.env.PUBLIC_CARTO_API_KEY || '';
---

<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0, viewport-fit=cover" />
  <meta name="theme-color" content="#0A0D12" />
  <meta name="apple-mobile-web-app-capable" content="yes" />
  <meta name="apple-mobile-web-app-status-bar-style" content="black-translucent" />
  <title>MC TRAVEL OS · Philippines 32-Day Nordic &amp; M-Sport Travel Cockpit (Maria &amp; Christian)</title>
  <link rel="icon" type="image/svg+xml" href="./favicon.svg" />
  <link rel="manifest" href="./manifest.webmanifest" />

  <!-- Google Fonts: Plus Jakarta Sans (Nordic Geometric UI) & JetBrains Mono (Tabular M-Telemetry) -->
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=JetBrains+Mono:wght@400;500;600;700&family=Plus+Jakarta+Sans:wght@400;500;600;700;800&display=swap" rel="stylesheet">

  <!-- Leaflet Interactive Map CSS & JS -->
  <link rel="stylesheet" href="https://unpkg.com/leaflet@1.9.4/dist/leaflet.css" integrity="sha256-p4NxAoJBhIIN+hmNHrzRCf9tD/miZyoHS5obTRR9BMY=" crossorigin="" />
  <script is:inline src="https://unpkg.com/leaflet@1.9.4/dist/leaflet.js" integrity="sha256-20nQCchB9co0qIjJZRGuk2/Z9VM+kNiyxNV1lvTlZBo=" crossorigin=""></script>

  <style>
    :root {
      /* Default: BMW M-Sport Carbon Dark × Nordic Precision */
      --bg-canvas: #0A0D12;
      --bg-panel: #111620;
      --bg-card: #161C28;
      --bg-card-hover: #1C2433;
      --bg-elevated: #0D1119;
      --bg-glass: rgba(17, 22, 32, 0.9);
      --text-primary: #F8FAFC;
      --text-secondary: #94A3B8;
      --text-muted: #64748B;
      --border-hairline: rgba(255, 255, 255, 0.08);
      --border-strong: rgba(255, 255, 255, 0.16);

      /* Authentic BMW ///M Tri-Color System & Nordic Accents */
      --m-light-blue: #0066B1;
      --m-Sky-glow: #2E9AFE;
      --m-violet-navy: #1C2674;
      --m-indigo-pill: #6366F1;
      --m-red: #E30613;
      --m-red-glow: #FF2836;
      --nordic-mint: #10B981;
      --amber-telemetry: #F59E0B;

      /* Airy Google & Airbnb Design Tokens */
      --radius-card: 18px;
      --radius-panel: 22px;
      --radius-pill: 9999px;
      --shadow-panel: 0 18px 40px rgba(0, 0, 0, 0.35);
      --shadow-airbnb: 0 12px 32px rgba(0, 0, 0, 0.28);
      --font-sans: 'Plus Jakarta Sans', -apple-system, BlinkMacSystemFont, sans-serif;
      --font-mono: 'JetBrains Mono', monospace;
    }

    /* 1-Click Nordic Alpine Daylight Theme */
    body.theme-nordic-light {
      --bg-canvas: #F4F6F9;
      --bg-panel: #FFFFFF;
      --bg-card: #FFFFFF;
      --bg-card-hover: #F8FAFC;
      --bg-elevated: #EEF2F6;
      --bg-glass: rgba(255, 255, 255, 0.94);
      --text-primary: #0F172A;
      --text-secondary: #475569;
      --text-muted: #64748B;
      --border-hairline: rgba(15, 23, 42, 0.08);
      --border-strong: rgba(15, 23, 42, 0.15);
      --shadow-panel: 0 14px 34px rgba(15, 23, 42, 0.06);
      --shadow-airbnb: 0 8px 24px rgba(15, 23, 42, 0.05);
    }

    * {
      box-sizing: border-box;
      margin: 0;
      padding: 0;
      -webkit-tap-highlight-color: transparent;
    }

    html {
      scroll-behavior: smooth;
    }

    body {
      background-color: var(--bg-canvas);
      color: var(--text-primary);
      font-family: var(--font-sans);
      line-height: 1.48;
      overflow-x: hidden;
      padding-bottom: 80px;
      transition: background-color 0.2s ease, color 0.2s ease;
    }

    /* Authentic BMW ///M Tri-Color Skewed Stripe */
    .m-tricolor-strip {
      height: 4px;
      width: 100%;
      background: linear-gradient(
        90deg,
        #0066B1 0%,
        #0066B1 33.3%,
        #1C2674 33.3%,
        #1C2674 66.6%,
        #E30613 66.6%,
        #E30613 100%
      );
      position: sticky;
      top: 0;
      z-index: 1100;
    }

    .m-badge-inline {
      display: inline-flex;
      align-items: center;
      font-family: var(--font-mono);
      font-weight: 800;
      font-style: italic;
      font-size: 0.76rem;
      letter-spacing: -0.03em;
      padding: 0.12rem 0.45rem;
      border-radius: 5px;
      background: rgba(255, 255, 255, 0.06);
      border: 1px solid var(--border-strong);
    }
    .m-slash-1 { color: #2E9AFE; }
    .m-slash-2 { color: #6366F1; }
    .m-slash-3 { color: #FF2836; margin-right: 2px; }

    /* Sticky Top Telemetry Header */
    .top-command-bar {
      display: flex;
      flex-wrap: wrap;
      justify-content: space-between;
      align-items: center;
      gap: 1.15rem;
      padding: 0.95rem 1.85rem;
      background: var(--bg-glass);
      backdrop-filter: blur(20px);
      -webkit-backdrop-filter: blur(20px);
      border-bottom: 1px solid var(--border-hairline);
      position: sticky;
      top: 4px;
      z-index: 1050;
      box-shadow: 0 4px 20px rgba(0, 0, 0, 0.15);
    }

    .brand-cluster {
      display: flex;
      align-items: center;
      gap: 0.95rem;
    }

    .m-crest {
      width: 48px;
      height: 38px;
      padding: 0 4px;
      border-radius: 12px;
      background: var(--bg-card);
      border: 1px solid var(--border-strong);
      display: grid;
      place-items: center;
      position: relative;
      overflow: hidden;
      flex-shrink: 0;
      box-shadow: 0 4px 14px rgba(0, 0, 0, 0.25);
    }

    .m-crest::before {
      content: '';
      position: absolute;
      inset: 0;
      background: linear-gradient(135deg, rgba(0, 102, 177, 0.28), rgba(28, 38, 116, 0.25), rgba(227, 6, 19, 0.28));
    }

    .brand-titles h1 {
      font-size: 1.18rem;
      font-weight: 800;
      letter-spacing: -0.03em;
      color: var(--text-primary);
      display: flex;
      flex-wrap: wrap;
      align-items: center;
      gap: 0.55rem;
    }

    .brand-titles p {
      font-size: 0.74rem;
      color: var(--text-secondary);
      font-family: var(--font-mono);
      margin-top: 0.1rem;
    }

    .badge-pill {
      font-family: var(--font-mono);
      font-size: 0.68rem;
      font-weight: 700;
      text-transform: uppercase;
      letter-spacing: 0.05em;
      padding: 0.22rem 0.65rem;
      border-radius: var(--radius-pill);
      background: rgba(46, 154, 254, 0.12);
      color: var(--m-Sky-glow);
      border: 1px solid rgba(46, 154, 254, 0.3);
    }

    .badge-m-red {
      background: rgba(227, 6, 19, 0.14);
      color: var(--m-red-glow);
      border-color: rgba(227, 6, 19, 0.35);
    }

    .kpi-ribbon {
      display: flex;
      flex-wrap: wrap;
      gap: 0.65rem;
      align-items: center;
    }

    .kpi-chip {
      background: var(--bg-card);
      border: 1px solid var(--border-hairline);
      border-radius: 12px;
      padding: 0.42rem 0.85rem;
      display: flex;
      flex-direction: column;
      box-shadow: 0 2px 8px rgba(0, 0, 0, 0.12);
      transition: all 0.18s ease;
    }

    .kpi-chip:hover {
      border-color: var(--border-strong);
      transform: translateY(-1px);
    }

    .kpi-chip span.label {
      font-family: var(--font-mono);
      font-size: 0.6rem;
      text-transform: uppercase;
      letter-spacing: 0.07em;
      color: var(--text-secondary);
      margin-bottom: 0.05rem;
    }

    .kpi-chip span.val {
      font-family: var(--font-mono);
      font-size: 0.84rem;
      font-weight: 700;
      font-variant-numeric: tabular-nums;
      color: var(--text-primary);
    }

    .kpi-chip.target-green {
      border-color: rgba(16, 185, 129, 0.4);
    }
    .kpi-chip.target-green span.val {
      color: var(--nordic-mint);
    }

    .kpi-chip.target-red {
      border-color: rgba(227, 6, 19, 0.45);
    }
    .kpi-chip.target-red span.val {
      color: var(--m-red-glow);
    }

    .badge-mini-toggle {
      font-family: var(--font-mono);
      font-size: 0.55rem;
      font-weight: 800;
      text-transform: uppercase;
      padding: 0.12rem 0.45rem;
      border-radius: var(--radius-pill);
      background: rgba(16, 185, 129, 0.15);
      color: #10B981;
      border: 1px solid rgba(16, 185, 129, 0.3);
      cursor: pointer;
      transition: all 0.15s ease;
    }

    .badge-mini-toggle:hover {
      background: rgba(16, 185, 129, 0.28);
    }

    .badge-mini-toggle.mid-mode {
      background: rgba(46, 154, 254, 0.15);
      color: var(--m-Sky-glow);
      border-color: rgba(46, 154, 254, 0.3);
    }

    /* Currency & Theme Toggles */
    .segmented-control {
      display: inline-flex;
      background: var(--bg-card);
      border: 1px solid var(--border-strong);
      border-radius: var(--radius-pill);
      overflow: hidden;
      box-shadow: 0 2px 8px rgba(0, 0, 0, 0.1);
    }

    .curr-btn, .theme-toggle-btn {
      font-family: var(--font-mono);
      font-size: 0.72rem;
      font-weight: 700;
      padding: 0.45rem 0.72rem;
      border: none;
      background: transparent;
      color: var(--text-secondary);
      cursor: pointer;
      transition: all 0.15s ease;
    }

    .curr-btn.active {
      background: var(--m-light-blue);
      color: #FFFFFF;
    }

    .theme-toggle-btn {
      background: var(--bg-card);
      border: 1px solid var(--border-strong);
      border-radius: var(--radius-pill);
      color: var(--text-primary);
      display: inline-flex;
      align-items: center;
      gap: 0.35rem;
      box-shadow: 0 2px 8px rgba(0, 0, 0, 0.1);
    }

    .theme-toggle-btn:hover {
      border-color: var(--m-Sky-glow);
    }

    .sheet-sync-btn {
      display: inline-flex;
      align-items: center;
      gap: 0.4rem;
      padding: 0.45rem 0.85rem;
      border-radius: var(--radius-pill);
      font-family: var(--font-mono);
      font-size: 0.72rem;
      font-weight: 700;
      text-decoration: none;
      background: var(--bg-card);
      color: var(--text-primary);
      border: 1px solid var(--border-strong);
      transition: all 0.15s ease;
      white-space: nowrap;
      box-shadow: 0 2px 8px rgba(0, 0, 0, 0.1);
    }

    .sheet-sync-btn:hover {
      border-color: var(--m-Sky-glow);
      color: var(--m-Sky-glow);
    }

    /* Sub-Header: 7 Destination Hubs Strip */
    .hub-nav-strip {
      display: flex;
      align-items: center;
      gap: 0.65rem;
      padding: 0.85rem 1.85rem;
      background: var(--bg-panel);
      border-bottom: 1px solid var(--border-hairline);
      overflow-x: auto;
      scrollbar-width: none;
      position: sticky;
      top: 68px;
      z-index: 1020;
    }

    .hub-nav-strip::-webkit-scrollbar {
      display: none;
    }

    .hub-tab-btn {
      display: flex;
      align-items: center;
      gap: 0.5rem;
      padding: 0.52rem 1.15rem;
      border-radius: var(--radius-pill);
      background: var(--bg-card);
      border: 1px solid var(--border-hairline);
      color: var(--text-secondary);
      font-family: var(--font-sans);
      font-size: 0.8rem;
      font-weight: 600;
      cursor: pointer;
      white-space: nowrap;
      transition: all 0.2s cubic-bezier(0.16, 1, 0.3, 1);
      flex-shrink: 0;
      box-shadow: 0 2px 8px rgba(0, 0, 0, 0.1);
    }

    .hub-tab-btn:hover {
      background: var(--bg-card-hover);
      color: var(--text-primary);
      transform: translateY(-1px);
    }

    .hub-tab-btn.active {
      background: var(--m-light-blue);
      color: #FFFFFF;
      border-color: var(--m-Sky-glow);
      box-shadow: 0 4px 16px rgba(0, 102, 177, 0.4);
    }

    .hub-tab-btn .num {
      font-family: var(--font-mono);
      font-size: 0.66rem;
      font-weight: 700;
      padding: 0.12rem 0.45rem;
      border-radius: var(--radius-pill);
      background: rgba(0, 0, 0, 0.28);
      color: #E2E8F0;
    }

    /* Balanced Split-Screen iDrive Cockpit Grid (Eliminates Empty Left Column) */
    .cockpit-grid {
      display: grid;
      grid-template-columns: 42% 58%;
      gap: 1.75rem;
      padding: 1.5rem 1.85rem 4rem;
      max-width: 1920px;
      margin: 0 auto;
      align-items: start;
    }

    /* Left Column: Sticky Full-Viewport Map + Live 7-Hub Budget Telemetry */
    .map-column {
      position: sticky;
      top: 130px;
      display: flex;
      flex-direction: column;
      gap: 1.25rem;
    }

    .map-frame-card {
      background: var(--bg-panel);
      border: 1px solid var(--border-hairline);
      border-radius: var(--radius-panel);
      overflow: hidden;
      box-shadow: var(--shadow-panel);
      display: flex;
      flex-direction: column;
    }

    .map-toolbar {
      display: flex;
      flex-wrap: wrap;
      justify-content: space-between;
      align-items: center;
      gap: 0.65rem;
      padding: 0.85rem 1.15rem;
      background: var(--bg-card);
      border-bottom: 1px solid var(--border-hairline);
    }

    .map-toolbar-title {
      display: flex;
      align-items: center;
      gap: 0.5rem;
      font-family: var(--font-mono);
      font-size: 0.74rem;
      font-weight: 700;
      color: var(--text-primary);
    }

    .live-dot {
      width: 8px;
      height: 8px;
      border-radius: 50%;
      background: var(--m-red-glow);
      box-shadow: 0 0 8px var(--m-red-glow);
      flex-shrink: 0;
    }

    .map-control-group {
      display: flex;
      flex-wrap: wrap;
      gap: 0.4rem;
    }

    .map-btn {
      font-family: var(--font-mono);
      font-size: 0.7rem;
      font-weight: 600;
      padding: 0.4rem 0.82rem;
      border-radius: var(--radius-pill);
      border: 1px solid var(--border-hairline);
      background: var(--bg-panel);
      color: var(--text-primary);
      cursor: pointer;
      transition: all 0.16s ease;
      box-shadow: 0 2px 6px rgba(0, 0, 0, 0.08);
    }

    .map-btn:hover, .map-btn.active {
      background: var(--m-light-blue);
      color: #FFFFFF;
      border-color: var(--m-Sky-glow);
    }

    .map-btn.m-sport-btn {
      background: rgba(227, 6, 19, 0.14);
      border-color: rgba(227, 6, 19, 0.4);
      color: var(--m-red-glow);
    }
    .map-btn.m-sport-btn:hover, .map-btn.m-sport-btn.active {
      background: var(--m-red);
      color: #FFFFFF;
    }

    #ph-interactive-map {
      width: 100%;
      height: calc(100vh - 340px);
      min-height: 390px;
      max-height: 560px;
      background: #070B10;
      z-index: 1;
    }

    #ph-interactive-map.map-filter-dark :global(.leaflet-tile-pane) {
      filter: invert(100%) hue-rotate(190deg) brightness(90%) contrast(96%) saturate(120%);
    }

    .map-legend-footer {
      display: flex;
      flex-wrap: wrap;
      justify-content: space-between;
      align-items: center;
      gap: 0.5rem;
      padding: 0.5rem 0.85rem;
      background: var(--bg-card);
      border-top: 1px solid var(--border-hairline);
      font-family: var(--font-mono);
      font-size: 0.66rem;
      color: var(--text-secondary);
    }

    .legend-items {
      display: flex;
      flex-wrap: wrap;
      gap: 0.65rem;
      align-items: center;
    }

    .legend-item {
      display: flex;
      align-items: center;
      gap: 0.3rem;
    }

    .legend-swatch {
      width: 9px;
      height: 9px;
      border-radius: 2px;
      display: inline-block;
    }

    /* Compact Left-Column Telemetry Dock (7-Hub Selected Stays & Budget Meter) */
    .left-telemetry-card {
      background: var(--bg-panel);
      border: 1px solid var(--border-hairline);
      border-radius: var(--radius-card);
      padding: 1.15rem 1.25rem;
      box-shadow: var(--shadow-panel);
    }

    .budget-meter-labels {
      display: flex;
      justify-content: space-between;
      align-items: center;
      font-family: var(--font-mono);
      font-size: 0.72rem;
      color: var(--text-secondary);
      margin-bottom: 0.55rem;
    }

    .budget-bar-track {
      height: 10px;
      background: var(--bg-elevated);
      border-radius: var(--radius-pill);
      position: relative;
      overflow: hidden;
      border: 1px solid var(--border-hairline);
    }

    .budget-target-zone {
      position: absolute;
      top: 0;
      bottom: 0;
      left: 45%;
      width: 11%;
      background: rgba(16, 185, 129, 0.25);
      border-left: 1px dashed var(--nordic-mint);
      border-right: 1px dashed var(--nordic-mint);
      z-index: 1;
    }

    .budget-bar-fill {
      height: 100%;
      background: linear-gradient(90deg, #0066B1 0%, #10B981 65%, #E30613 100%);
      border-radius: var(--radius-pill);
      transition: width 0.3s ease;
    }

    .hub-breakdown-grid {
      display: grid;
      grid-template-columns: repeat(7, minmax(0, 1fr));
      gap: 0.45rem;
      margin-top: 0.85rem;
      width: 100%;
    }

    .hub-mini-summary {
      background: var(--bg-card);
      border: 1px solid var(--border-hairline);
      border-radius: 10px;
      padding: 0.45rem 0.4rem;
      font-size: 0.66rem;
      cursor: pointer;
      transition: all 0.16s ease;
      min-width: 0;
      overflow: hidden;
      box-shadow: 0 2px 6px rgba(0, 0, 0, 0.08);
    }

    .hub-mini-summary:hover {
      border-color: var(--m-Sky-glow);
      transform: translateY(-2px);
      box-shadow: 0 4px 12px rgba(46, 154, 254, 0.2);
    }

    /* Right Column: M-Drive Mode Switcher & Workspace Deck */
    .right-deck-column {
      display: flex;
      flex-direction: column;
      gap: 1.85rem;
      min-width: 0;
    }

    /* Segmented BMW iDrive Mode Bar */
    .m-drive-mode-bar {
      display: flex;
      flex-wrap: wrap;
      align-items: center;
      justify-content: space-between;
      gap: 0.65rem;
      padding: 0.65rem 0.85rem;
      background: var(--bg-panel);
      border: 1px solid var(--border-strong);
      border-radius: 18px;
      box-shadow: var(--shadow-panel);
    }

    .m-mode-tabs {
      display: flex;
      flex-wrap: wrap;
      gap: 0.45rem;
      flex: 1;
    }

    .m-mode-btn {
      font-family: var(--font-mono);
      font-size: 0.76rem;
      font-weight: 700;
      padding: 0.52rem 1.05rem;
      border-radius: var(--radius-pill);
      border: 1px solid transparent;
      background: transparent;
      color: var(--text-secondary);
      cursor: pointer;
      transition: all 0.18s ease;
      display: inline-flex;
      align-items: center;
      gap: 0.45rem;
      white-space: nowrap;
    }

    .m-mode-btn:hover {
      color: var(--text-primary);
      background: var(--bg-card);
    }

    .m-mode-btn.active {
      background: var(--bg-card);
      color: var(--text-primary);
      border-color: var(--m-Sky-glow);
      box-shadow: 0 2px 10px rgba(0, 102, 177, 0.25);
    }

    .m-mode-btn.m-red-tab.active {
      border-color: var(--m-red-glow);
      box-shadow: 0 2px 10px rgba(227, 6, 19, 0.25);
      color: var(--m-red-glow);
    }

    /* Deck Panels visibility controlled by active Drive Mode */
    .deck-mode-section {
      display: none;
      flex-direction: column;
      gap: 1.85rem;
    }

    .deck-mode-section.mode-active {
      display: flex;
    }

    /* Budget Optimizer Panel (Nordic Clean Bento) */
    .budget-optimizer-card {
      background: var(--bg-panel);
      border: 1px solid var(--border-hairline);
      border-top: 3px solid var(--m-light-blue);
      border-radius: var(--radius-panel);
      padding: 1.5rem 1.75rem;
      box-shadow: var(--shadow-panel);
      display: flex;
      flex-direction: column;
      gap: 1.25rem;
    }

    .budget-opt-header {
      display: flex;
      flex-wrap: wrap;
      justify-content: space-between;
      align-items: center;
      gap: 0.75rem;
    }

    .budget-opt-title {
      font-size: 1.05rem;
      font-weight: 800;
      letter-spacing: -0.02em;
      color: var(--text-primary);
      display: flex;
      align-items: center;
      gap: 0.55rem;
    }

    .budget-status-pill {
      font-family: var(--font-mono);
      font-size: 0.72rem;
      font-weight: 700;
      padding: 0.32rem 0.85rem;
      border-radius: var(--radius-pill);
      background: rgba(16, 185, 129, 0.14);
      border: 1px solid rgba(16, 185, 129, 0.45);
      color: var(--nordic-mint);
    }

    .budget-status-pill.over-target {
      background: rgba(227, 6, 19, 0.14);
      border-color: rgba(227, 6, 19, 0.45);
      color: var(--m-red-glow);
    }

    .preset-grid {
      display: grid;
      grid-template-columns: repeat(4, 1fr);
      gap: 0.85rem;
    }

    .preset-btn {
      background: var(--bg-card);
      border: 1px solid var(--border-hairline);
      border-radius: 14px;
      padding: 0.85rem 1rem;
      text-align: left;
      cursor: pointer;
      transition: all 0.2s cubic-bezier(0.16, 1, 0.3, 1);
      display: flex;
      flex-direction: column;
      gap: 0.35rem;
      color: var(--text-primary);
      box-shadow: 0 2px 8px rgba(0, 0, 0, 0.08);
    }

    .preset-btn:hover {
      background: var(--bg-card-hover);
      border-color: var(--m-Sky-glow);
      transform: translateY(-2px);
      box-shadow: 0 6px 16px rgba(0, 0, 0, 0.16);
    }

    .preset-btn.active {
      border-color: var(--m-Sky-glow);
      background: rgba(0, 102, 177, 0.14);
      box-shadow: 0 4px 16px rgba(46, 154, 254, 0.2), inset 3px 0 0 var(--m-light-blue);
    }

    .preset-btn .p-top {
      display: flex;
      justify-content: space-between;
      align-items: center;
      gap: 0.35rem;
      font-family: var(--font-mono);
      font-size: 0.72rem;
      font-weight: 700;
    }

    .preset-btn .p-price {
      color: var(--m-Sky-glow);
      font-variant-numeric: tabular-nums;
    }

    .preset-btn .p-desc {
      font-size: 0.72rem;
      color: var(--text-secondary);
      line-height: 1.4;
    }

    .stay-filter-bar {
      display: flex;
      flex-wrap: wrap;
      align-items: center;
      justify-content: space-between;
      gap: 0.75rem;
      padding-top: 0.85rem;
      border-top: 1px solid var(--border-hairline);
    }

    .stay-filter-pills {
      display: flex;
      flex-wrap: wrap;
      gap: 0.45rem;
    }

    .stay-filter-btn {
      font-family: var(--font-mono);
      font-size: 0.72rem;
      font-weight: 600;
      padding: 0.38rem 0.85rem;
      border-radius: var(--radius-pill);
      border: 1px solid var(--border-hairline);
      background: var(--bg-card);
      color: var(--text-secondary);
      cursor: pointer;
      transition: all 0.16s ease;
      box-shadow: 0 2px 6px rgba(0, 0, 0, 0.08);
    }

    .stay-filter-btn.active, .stay-filter-btn:hover {
      background: var(--m-light-blue);
      color: #FFFFFF;
      border-color: var(--m-Sky-glow);
    }

    /* Hub Spotlight Panel & Spacious Airbnb-Style Hotel Grid */
    .hub-spotlight-panel {
      display: none;
      flex-direction: column;
      gap: 1.65rem;
      background: var(--bg-panel);
      border: 1px solid var(--border-hairline);
      border-radius: var(--radius-panel);
      padding: 1.75rem 1.85rem;
      box-shadow: var(--shadow-panel);
    }

    .hub-spotlight-panel.active {
      display: flex;
    }

    .hub-banner-head {
      display: flex;
      flex-wrap: wrap;
      justify-content: space-between;
      align-items: flex-start;
      gap: 1rem;
      padding-bottom: 1.15rem;
      border-bottom: 1px solid var(--border-hairline);
    }

    .hub-title-block .region-kicker {
      font-family: var(--font-mono);
      font-size: 0.72rem;
      font-weight: 700;
      text-transform: uppercase;
      letter-spacing: 0.08em;
      color: var(--m-Sky-glow);
      margin-bottom: 0.25rem;
    }

    .hub-title-block h2 {
      font-size: 1.55rem;
      font-weight: 800;
      letter-spacing: -0.025em;
      color: var(--text-primary);
    }

    .hub-title-block p.tagline {
      font-size: 0.84rem;
      color: var(--text-secondary);
      margin-top: 0.25rem;
      line-height: 1.45;
    }

    .hub-meta-badges {
      display: flex;
      flex-wrap: wrap;
      gap: 0.55rem;
      align-items: center;
    }

    .hub-dates-pill, .hub-weather-pill {
      font-family: var(--font-mono);
      font-size: 0.72rem;
      font-weight: 600;
      padding: 0.38rem 0.85rem;
      border-radius: var(--radius-pill);
      background: var(--bg-card);
      border: 1px solid var(--border-strong);
      color: var(--text-primary);
      box-shadow: 0 2px 6px rgba(0, 0, 0, 0.08);
    }

    /* Landmarks Chip Row */
    .landmarks-bar {
      display: flex;
      flex-wrap: wrap;
      align-items: center;
      gap: 0.55rem;
    }

    .landmark-chip {
      background: var(--bg-card);
      border: 1px solid var(--border-hairline);
      color: var(--text-primary);
      padding: 0.42rem 0.95rem;
      border-radius: var(--radius-pill);
      cursor: pointer;
      transition: all 0.16s ease;
      font-size: 0.78rem;
      text-align: left;
      box-shadow: 0 2px 6px rgba(0, 0, 0, 0.08);
    }

    .landmark-chip:hover {
      border-color: var(--m-Sky-glow);
      background: var(--bg-card-hover);
      transform: translateY(-1px);
    }

    /* Spacious Dual Highlights Row */
    .dual-highlights-grid {
      display: grid;
      grid-template-columns: repeat(3, 1fr);
      gap: 0.95rem;
    }

    .highlight-box {
      background: var(--bg-card);
      border: 1px solid var(--border-hairline);
      border-radius: 14px;
      padding: 0.95rem 1.15rem;
      box-shadow: 0 2px 8px rgba(0, 0, 0, 0.08);
    }

    .highlight-box.m-sport-box {
      border-left: 3.5px solid var(--m-red);
    }

    .highlight-box.nordic-romance-box {
      border-left: 3.5px solid var(--m-indigo-pill);
    }

    .highlight-box.cebpac-box {
      border-left: 3.5px solid var(--m-light-blue);
    }

    .highlight-box .h-label {
      font-family: var(--font-mono);
      font-size: 0.68rem;
      font-weight: 700;
      text-transform: uppercase;
      letter-spacing: 0.06em;
      margin-bottom: 0.28rem;
    }

    .highlight-box p {
      font-size: 0.78rem;
      color: var(--text-secondary);
      line-height: 1.5;
    }

    /* Airy Airbnb-Style Hotel Grid */
    .hotels-grid {
      display: grid;
      grid-template-columns: repeat(auto-fit, minmax(350px, 1fr));
      gap: 1.25rem;
    }

    .hotel-card {
      background: var(--bg-card);
      border: 1px solid var(--border-hairline);
      border-radius: var(--radius-card);
      padding: 1.45rem 1.6rem;
      display: flex;
      flex-direction: column;
      justify-content: space-between;
      gap: 0.95rem;
      transition: all 0.22s cubic-bezier(0.16, 1, 0.3, 1);
      box-shadow: 0 4px 16px rgba(0, 0, 0, 0.15);
      position: relative;
    }

    .hotel-card:hover {
      border-color: var(--m-Sky-glow);
      background: var(--bg-card-hover);
      transform: translateY(-2px);
      box-shadow: 0 10px 28px rgba(0, 0, 0, 0.25);
    }

    .hotel-card.selected-stay {
      border: 2px solid var(--m-Sky-glow) !important;
      box-shadow: 0 8px 32px rgba(46, 154, 254, 0.25), inset 4px 0 0 var(--m-light-blue);
      background: rgba(0, 102, 177, 0.12) !important;
    }

    .hotel-card.filtered-out {
      display: none !important;
    }

    .hotel-card-header {
      display: flex;
      justify-content: space-between;
      align-items: center;
      gap: 0.65rem;
    }

    .option-badge {
      font-family: var(--font-mono);
      font-size: 0.68rem;
      font-weight: 700;
      padding: 0.22rem 0.65rem;
      border-radius: var(--radius-pill);
      background: rgba(46, 154, 254, 0.12);
      color: var(--m-Sky-glow);
      border: 1px solid rgba(46, 154, 254, 0.3);
    }

    .tier-tag-serviced {
      background: rgba(99, 102, 241, 0.14);
      color: #818CF8;
      border-color: rgba(99, 102, 241, 0.35);
    }

    .tier-tag-airbnb {
      background: rgba(16, 185, 129, 0.14);
      color: var(--nordic-mint);
      border-color: rgba(16, 185, 129, 0.35);
    }

    .rate-pill {
      font-family: var(--font-mono);
      font-size: 0.88rem;
      font-weight: 800;
      font-variant-numeric: tabular-nums;
      color: var(--text-primary);
      background: var(--bg-elevated);
      border: 1px solid var(--border-strong);
      padding: 0.25rem 0.65rem;
      border-radius: var(--radius-pill);
      white-space: nowrap;
      box-shadow: 0 2px 6px rgba(0, 0, 0, 0.1);
    }

    .hotel-name {
      font-size: 1.12rem;
      font-weight: 800;
      letter-spacing: -0.02em;
      color: var(--text-primary);
      line-height: 1.35;
    }

    .stars-line {
      font-family: var(--font-mono);
      font-size: 0.72rem;
      color: var(--text-secondary);
      display: flex;
      justify-content: space-between;
      align-items: center;
    }

    .proximity-box {
      background: var(--bg-elevated);
      border-left: 3px solid var(--m-light-blue);
      padding: 0.55rem 0.85rem;
      border-radius: 0 10px 10px 0;
      font-size: 0.78rem;
      color: var(--text-secondary);
      line-height: 1.45;
    }

    .proximity-box strong {
      color: var(--text-primary);
      font-family: var(--font-mono);
      font-size: 0.72rem;
      margin-right: 0.35rem;
    }

    .hotel-highlight {
      font-size: 0.82rem;
      color: var(--text-secondary);
      line-height: 1.5;
    }

    .hotel-card-footer {
      display: flex;
      justify-content: space-between;
      align-items: center;
      gap: 0.65rem;
      padding-top: 0.85rem;
      border-top: 1px solid var(--border-hairline);
      margin-top: 0.25rem;
    }

    .locate-pin-btn, .shortlist-btn {
      font-family: var(--font-mono);
      font-size: 0.74rem;
      font-weight: 700;
      padding: 0.45rem 0.95rem;
      border-radius: var(--radius-pill);
      border: 1px solid var(--border-strong);
      background: var(--bg-panel);
      color: var(--text-primary);
      cursor: pointer;
      transition: all 0.16s ease;
      min-height: 40px;
      display: inline-flex;
      align-items: center;
      justify-content: center;
      gap: 0.35rem;
    }

    .locate-pin-btn:hover, .shortlist-btn:hover {
      background: var(--m-light-blue);
      color: #FFFFFF;
      border-color: var(--m-Sky-glow);
    }

    .shortlist-btn.active {
      background: var(--m-light-blue);
      border-color: var(--m-Sky-glow);
      color: #FFFFFF;
      box-shadow: 0 2px 10px rgba(0, 102, 177, 0.35);
    }

    .hotel-book-btn {
      font-family: var(--font-mono);
      font-size: 0.74rem;
      font-weight: 700;
      padding: 0.45rem 1rem;
      border-radius: var(--radius-pill);
      background: var(--text-primary);
      color: var(--bg-canvas);
      text-decoration: none;
      transition: opacity 0.15s ease;
      min-height: 40px;
      display: inline-flex;
      align-items: center;
      justify-content: center;
    }

    .hotel-book-btn:hover {
      opacity: 0.9;
    }

    /* Spacious Dining Strip */
    .dining-strip {
      padding-top: 1rem;
      border-top: 1px solid var(--border-hairline);
    }

    .dining-grid {
      display: grid;
      grid-template-columns: repeat(auto-fill, minmax(280px, 1fr));
      gap: 0.95rem;
      margin-top: 0.85rem;
    }

    .dining-card {
      background: var(--bg-card);
      border: 1px solid var(--border-hairline);
      border-radius: 14px;
      padding: 1rem 1.15rem;
      font-size: 0.8rem;
      line-height: 1.5;
      box-shadow: 0 2px 8px rgba(0, 0, 0, 0.08);
      transition: all 0.16s ease;
    }

    .dining-card:hover {
      border-color: var(--m-Sky-glow);
      transform: translateY(-2px);
      box-shadow: 0 6px 18px rgba(0, 0, 0, 0.16);
    }

    .dining-cat {
      font-family: var(--font-mono);
      font-size: 0.68rem;
      color: var(--m-Sky-glow);
      text-transform: uppercase;
      font-weight: 700;
      margin-bottom: 0.25rem;
    }

    /* Mode 2: ///M Auto Shows & Cebu -> Bohol Roadtrip Cards */
    .surface-card {
      background: var(--bg-panel);
      border: 1px solid var(--border-hairline);
      border-radius: var(--radius-panel);
      padding: 1.65rem 1.85rem;
      box-shadow: var(--shadow-panel);
    }

    .m-event-card {
      background: var(--bg-card);
      border: 1px solid var(--border-hairline);
      border-left: 3.5px solid var(--m-light-blue);
      border-radius: 14px;
      padding: 1.15rem 1.35rem;
      cursor: pointer;
      transition: all 0.18s ease;
      box-shadow: 0 2px 8px rgba(0, 0, 0, 0.08);
    }

    .m-event-card:hover {
      border-color: var(--m-Sky-glow);
      background: var(--bg-card-hover);
      transform: translateY(-2px);
      box-shadow: 0 8px 22px rgba(0, 0, 0, 0.2);
    }

    .m-event-card.m-red-accent {
      border-left-color: var(--m-red);
    }

    /* Mode 3: 32-Day Schedule Table */
    .filter-pills {
      display: flex;
      flex-wrap: wrap;
      gap: 0.45rem;
    }

    .filter-pill {
      font-family: var(--font-mono);
      font-size: 0.72rem;
      font-weight: 600;
      padding: 0.38rem 0.85rem;
      border-radius: var(--radius-pill);
      border: 1px solid var(--border-hairline);
      background: var(--bg-card);
      color: var(--text-secondary);
      cursor: pointer;
      transition: all 0.16s ease;
      box-shadow: 0 2px 6px rgba(0, 0, 0, 0.08);
    }

    .filter-pill.active, .filter-pill:hover {
      background: var(--m-light-blue);
      color: #FFFFFF;
      border-color: var(--m-Sky-glow);
    }

    .itinerary-table-wrap {
      overflow-x: auto;
      margin-top: 1.15rem;
      border-radius: 16px;
      border: 1px solid var(--border-hairline);
      box-shadow: 0 4px 16px rgba(0, 0, 0, 0.1);
    }

    table.itinerary-table {
      width: 100%;
      border-collapse: collapse;
      font-size: 0.8rem;
    }

    table.itinerary-table th {
      background: var(--bg-card);
      color: var(--text-secondary);
      font-family: var(--font-mono);
      font-size: 0.7rem;
      text-transform: uppercase;
      letter-spacing: 0.06em;
      padding: 0.85rem 1.15rem;
      text-align: left;
      border-bottom: 1px solid var(--border-strong);
    }

    table.itinerary-table td {
      padding: 0.95rem 1.15rem;
      border-bottom: 1px solid var(--border-hairline);
      vertical-align: top;
      line-height: 1.55;
    }

    table.itinerary-table tr.day-row {
      cursor: pointer;
      transition: background 0.16s ease;
    }

    table.itinerary-table tr.day-row:hover {
      background: var(--bg-card-hover);
    }

    .day-badge {
      font-family: var(--font-mono);
      font-weight: 700;
      color: var(--m-Sky-glow);
      white-space: nowrap;
    }

    /* Mode 4: Flight & Ferry Cards */
    .svg-flight-banner {
      width: 100%;
      background: var(--bg-elevated);
      border: 1px solid var(--border-hairline);
      border-radius: 14px;
      padding: 0.85rem;
      margin-bottom: 1.15rem;
      overflow-x: auto;
    }

    .svg-flight-banner svg {
      min-width: 600px;
    }

    .flight-arc-line {
      stroke-dasharray: 6 5;
      animation: dashFlow 18s linear infinite;
    }

    @keyframes dashFlow {
      to { stroke-dashoffset: -240; }
    }

    .flight-legs-grid {
      display: grid;
      grid-template-columns: repeat(auto-fit, minmax(320px, 1fr));
      gap: 1.15rem;
    }

    .flight-leg-card {
      background: var(--bg-card);
      border: 1px solid var(--border-hairline);
      border-radius: 16px;
      padding: 1.25rem 1.45rem;
      display: flex;
      flex-direction: column;
      justify-content: space-between;
      gap: 0.85rem;
      cursor: pointer;
      transition: all 0.2s cubic-bezier(0.16, 1, 0.3, 1);
      box-shadow: 0 4px 14px rgba(0, 0, 0, 0.12);
    }

    .flight-leg-card:hover {
      border-color: var(--m-Sky-glow);
      background: var(--bg-card-hover);
      transform: translateY(-2px);
      box-shadow: 0 8px 24px rgba(0, 0, 0, 0.2);
    }

    .route-code {
      font-family: var(--font-mono);
      font-size: 0.88rem;
      font-weight: 700;
      color: var(--m-Sky-glow);
    }

    .fare-tag {
      font-family: var(--font-mono);
      font-size: 0.74rem;
      font-weight: 700;
      padding: 0.22rem 0.65rem;
      border-radius: var(--radius-pill);
      background: rgba(16, 185, 129, 0.14);
      color: var(--nordic-mint);
    }

    .cebpac-book-link {
      font-family: var(--font-mono);
      font-size: 0.72rem;
      font-weight: 700;
      color: #FFFFFF;
      background: var(--m-light-blue);
      padding: 0.42rem 0.95rem;
      border-radius: var(--radius-pill);
      text-decoration: none;
      display: inline-flex;
      align-items: center;
      gap: 0.35rem;
      transition: opacity 0.15s ease;
    }
    .cebpac-book-link:hover {
      opacity: 0.9;
    }

    /* Mode 5: Packing Checklist */
    .packing-grid {
      display: grid;
      grid-template-columns: repeat(auto-fit, minmax(340px, 1fr));
      gap: 1.25rem;
      margin-top: 1.15rem;
    }

    .packing-box {
      background: var(--bg-card);
      border: 1px solid var(--border-hairline);
      border-radius: 16px;
      padding: 1.35rem 1.55rem;
      box-shadow: 0 4px 14px rgba(0, 0, 0, 0.1);
    }

    .packing-box h3 {
      font-size: 0.96rem;
      font-weight: 800;
      margin-bottom: 0.75rem;
      color: var(--text-primary);
      display: flex;
      align-items: center;
      gap: 0.5rem;
    }

    .pack-item-label {
      display: flex;
      align-items: flex-start;
      gap: 0.55rem;
      font-size: 0.8rem;
      color: var(--text-primary);
      padding: 0.45rem 0.35rem;
      cursor: pointer;
      border-bottom: 1px solid var(--border-hairline);
      border-radius: 6px;
      transition: background 0.14s ease;
    }

    .pack-item-label:hover {
      background: rgba(255, 255, 255, 0.03);
    }

    .pack-item-label input[type="checkbox"] {
      margin-top: 0.18rem;
      accent-color: var(--m-light-blue);
      width: 16px;
      height: 16px;
      flex-shrink: 0;
    }

    .pack-item-label.checked span {
      text-decoration: line-through;
      color: var(--text-muted);
    }

    /* Home View Travel Checklist Widget */
    .home-checklist-card {
      background: var(--bg-card);
      border: 1px solid var(--border-hairline);
      border-radius: 16px;
      padding: 1.25rem 1.5rem;
      margin-top: 1.25rem;
      margin-bottom: 1.25rem;
      position: relative;
      overflow: hidden;
      box-shadow: 0 4px 16px rgba(0, 0, 0, 0.12);
    }

    .home-checklist-card::before {
      content: '';
      position: absolute;
      top: 0;
      left: 0;
      width: 4px;
      bottom: 0;
      background: linear-gradient(180deg, var(--m-light-blue), #10B981);
    }

    .home-checklist-header {
      display: flex;
      justify-content: space-between;
      align-items: center;
      flex-wrap: wrap;
      gap: 0.65rem;
      margin-bottom: 0.75rem;
    }

    .home-checklist-title {
      display: flex;
      align-items: center;
      gap: 0.55rem;
      font-size: 0.98rem;
      font-weight: 800;
      color: var(--text-primary);
    }

    .home-checklist-progress {
      font-family: var(--font-mono);
      font-size: 0.78rem;
      font-weight: 700;
      color: #10B981;
    }

    .home-checklist-bar-track {
      width: 100%;
      height: 6px;
      background: rgba(255, 255, 255, 0.08);
      border-radius: var(--radius-pill);
      margin-bottom: 1rem;
      overflow: hidden;
    }

    .home-checklist-bar-fill {
      height: 100%;
      background: linear-gradient(90deg, var(--m-light-blue), #10B981);
      border-radius: var(--radius-pill);
      transition: width 0.3s ease;
    }

    .home-checklist-grid {
      display: grid;
      grid-template-columns: repeat(2, 1fr);
      gap: 1rem;
    }

    @media (max-width: 768px) {
      .home-checklist-grid {
        grid-template-columns: 1fr;
      }
    }

    .home-checklist-col {
      background: var(--bg-surface);
      border: 1px solid var(--border-hairline);
      border-radius: 12px;
      padding: 0.85rem 1.05rem;
    }

    .home-checklist-col-title {
      font-family: var(--font-mono);
      font-size: 0.74rem;
      font-weight: 700;
      color: var(--m-Sky-glow);
      margin-bottom: 0.45rem;
      display: flex;
      align-items: center;
      gap: 0.35rem;
    }

    /* Sub-tab controls for Home Readiness Widget */
    .home-subtab-bar {
      display: flex;
      gap: 0.5rem;
      margin-bottom: 0.85rem;
    }

    .home-subtab-btn {
      font-family: var(--font-mono);
      font-size: 0.72rem;
      font-weight: 700;
      padding: 0.38rem 0.85rem;
      border-radius: var(--radius-pill);
      border: 1px solid var(--border-hairline);
      background: var(--bg-surface);
      color: var(--text-secondary);
      cursor: pointer;
      transition: all 0.15s ease;
    }

    .home-subtab-btn.active {
      background: var(--bg-elevated);
      color: var(--text-primary);
      border-color: var(--m-Sky-glow);
      box-shadow: 0 0 10px rgba(46, 154, 254, 0.2);
    }

    /* Essential Apps Grid */
    .apps-bento-grid {
      display: grid;
      grid-template-columns: repeat(auto-fill, minmax(320px, 1fr));
      gap: 1.15rem;
      margin-top: 0.85rem;
    }

    .app-card {
      background: var(--bg-surface);
      border: 1px solid var(--border-hairline);
      border-radius: 14px;
      padding: 1.15rem 1.25rem;
      display: flex;
      flex-direction: column;
      justify-content: space-between;
      gap: 0.65rem;
      transition: all 0.18s ease;
      box-shadow: 0 2px 8px rgba(0, 0, 0, 0.08);
    }

    .app-card:hover {
      border-color: rgba(46, 154, 254, 0.45);
      background: var(--bg-card);
      transform: translateY(-2px);
      box-shadow: 0 8px 22px rgba(0, 0, 0, 0.16);
    }

    .app-card-head {
      display: flex;
      justify-content: space-between;
      align-items: center;
      margin-bottom: 0.25rem;
    }

    .app-name-wrap {
      display: flex;
      align-items: center;
      gap: 0.5rem;
      font-weight: 800;
      font-size: 0.94rem;
      color: var(--text-primary);
    }

    .app-badge-tag {
      font-family: var(--font-mono);
      font-size: 0.64rem;
      font-weight: 700;
      color: var(--m-Sky-glow);
      background: rgba(46, 154, 254, 0.12);
      padding: 0.18rem 0.55rem;
      border-radius: var(--radius-pill);
      border: 1px solid rgba(46, 154, 254, 0.25);
    }

    .app-desc {
      font-size: 0.78rem;
      color: var(--text-secondary);
      line-height: 1.45;
      margin-bottom: 0.25rem;
    }

    .app-tip-box {
      font-size: 0.72rem;
      color: var(--text-muted);
      background: rgba(0, 0, 0, 0.25);
      border-left: 3px solid #10B981;
      padding: 0.42rem 0.65rem;
      border-radius: 0 8px 8px 0;
      margin-bottom: 0.35rem;
      line-height: 1.4;
    }

    .app-links {
      display: flex;
      gap: 0.55rem;
      align-items: center;
      flex-wrap: wrap;
      font-family: var(--font-mono);
      font-size: 0.68rem;
      margin-top: 0.35rem;
    }

    .app-link-btn {
      color: var(--m-Sky-glow);
      text-decoration: none;
      font-weight: 700;
      padding: 0.24rem 0.65rem;
      border-radius: var(--radius-pill);
      background: rgba(46, 154, 254, 0.1);
      border: 1px solid rgba(46, 154, 254, 0.2);
      transition: all 0.15s ease;
    }

    .app-link-btn:hover {
      background: rgba(46, 154, 254, 0.25);
      text-decoration: none;
      transform: translateY(-1px);
    }

    /* Mobile Sticky Bottom Dock */
    .mobile-bottom-dock {
      display: none;
      position: fixed;
      bottom: 0;
      left: 0;
      right: 0;
      background: var(--bg-glass);
      backdrop-filter: blur(18px);
      border-top: 1px solid var(--border-strong);
      padding: 0.35rem 0.4rem calc(0.35rem + env(safe-area-inset-bottom));
      z-index: 1500;
      justify-content: space-around;
      align-items: center;
    }

    .dock-btn {
      display: flex;
      flex-direction: column;
      align-items: center;
      gap: 0.1rem;
      background: none;
      border: none;
      color: var(--text-secondary);
      font-family: var(--font-mono);
      font-size: 0.6rem;
      font-weight: 700;
      padding: 0.25rem 0.5rem;
      border-radius: 6px;
      cursor: pointer;
    }

    .dock-btn.active {
      color: var(--m-Sky-glow);
      background: rgba(0, 102, 177, 0.14);
    }

    /* Responsive Breakpoints */
    @media (max-width: 1180px) {
      .cockpit-grid {
        grid-template-columns: 1fr;
      }
      .map-column {
        position: static;
      }
      #ph-interactive-map {
        height: 320px;
      }
      .preset-grid {
        grid-template-columns: repeat(2, 1fr);
      }
    }

    @media (max-width: 768px) {
      body {
        padding-bottom: 90px;
      }
      /* Mobile Single-Row Sleek Header */
      .top-command-bar {
        padding: 0.45rem 0.75rem;
        position: sticky;
        top: 0;
        z-index: 1050;
        gap: 0.4rem;
      }
      .brand-cluster {
        gap: 0.45rem;
      }
      .m-crest {
        width: 38px;
        height: 32px;
      }
      .brand-titles h1 {
        font-size: 0.88rem;
        gap: 0.3rem;
      }
      .brand-titles p {
        display: none;
      }
      .badge-m-red {
        display: none;
      }
      .kpi-ribbon {
        width: 100%;
        display: flex;
        justify-content: space-between;
        align-items: center;
        gap: 0.35rem;
      }
      .sheet-sync-btn {
        display: none;
      }
      .kpi-chip {
        flex: 1;
        padding: 0.28rem 0.5rem;
      }
      .kpi-chip .val {
        font-size: 0.82rem;
      }
      .segmented-control .curr-btn {
        padding: 0.26rem 0.42rem;
        font-size: 0.65rem;
        min-height: 32px;
      }
      .theme-toggle-btn {
        padding: 0.26rem 0.42rem;
        font-size: 0.65rem;
        min-height: 32px;
      }

      /* Hub Nav Strip Horizontal Touch Carousel */
      .hub-nav-strip {
        padding: 0.35rem 0.75rem;
        position: static;
        top: auto;
        gap: 0.35rem;
        scroll-snap-type: x mandatory;
        -webkit-overflow-scrolling: touch;
      }
      .hub-tab-btn {
        scroll-snap-align: start;
        padding: 0.42rem 0.85rem;
        font-size: 0.76rem;
        min-height: 38px;
        border-radius: var(--radius-pill);
      }

      /* Mobile Interactive Map */
      .cockpit-grid {
        padding: 0.65rem 0.85rem 5.5rem;
        gap: 1.15rem;
      }
      #ph-interactive-map {
        height: 250px;
        transition: height 0.3s cubic-bezier(0.16, 1, 0.3, 1);
        border-radius: 16px;
      }
      #ph-interactive-map.map-expanded {
        height: 68vh !important;
      }
      .map-control-group {
        display: flex;
        overflow-x: auto;
        -webkit-overflow-scrolling: touch;
        scrollbar-width: none;
        gap: 0.45rem;
        padding-bottom: 3px;
        flex-wrap: nowrap;
      }
      .map-control-group::-webkit-scrollbar {
        display: none;
      }
      .map-btn {
        white-space: nowrap;
        flex-shrink: 0;
        padding: 0.4rem 0.75rem;
        font-size: 0.68rem;
        min-height: 36px;
        border-radius: var(--radius-pill);
      }

      /* Grids and Touch Targets */
      .hotels-grid,
      .dual-highlights-grid,
      .dining-grid,
      .flight-legs-grid,
      .packing-grid,
      .preset-grid {
        grid-template-columns: 1fr;
        gap: 1rem;
      }
      .hotel-card {
        padding: 1.25rem 1.35rem;
        border-radius: 16px;
      }
      .locate-pin-btn, .shortlist-btn {
        padding: 0.45rem 0.85rem;
        font-size: 0.74rem;
        min-height: 40px;
        border-radius: var(--radius-pill);
        display: inline-flex;
        align-items: center;
        justify-content: center;
      }
      .hotel-card-footer a {
        padding: 0.45rem 0.85rem !important;
        font-size: 0.74rem !important;
        min-height: 40px;
        border-radius: var(--radius-pill);
        display: inline-flex;
        align-items: center;
        justify-content: center;
      }
      .hub-breakdown-grid {
        grid-template-columns: repeat(4, 1fr);
        gap: 0.45rem;
      }
      .hub-col {
        padding: 0.45rem 0.55rem;
      }

      /* Mobile Bottom Dock */
      .mobile-bottom-dock {
        display: flex;
        padding: 0.35rem 0.25rem calc(0.45rem + env(safe-area-inset-bottom));
        background: rgba(10, 13, 18, 0.95);
        backdrop-filter: blur(20px);
        -webkit-backdrop-filter: blur(20px);
        width: 100%;
        box-sizing: border-box;
      }
      .dock-btn {
        flex: 1 1 0;
        min-width: 0;
        padding: 0.25rem 0.05rem;
        font-size: 0.58rem;
        min-height: 44px;
        border-radius: 8px;
        display: flex;
        flex-direction: column;
        align-items: center;
        justify-content: center;
        text-align: center;
      }
      .dock-btn span:first-child {
        font-size: 1.1rem;
        line-height: 1;
      }
      .dock-btn span:last-child {
        white-space: nowrap;
        overflow: hidden;
        text-overflow: ellipsis;
        max-width: 100%;
      }
    }

    /* Custom Leaflet Popup Styling */
    :global(.leaflet-popup-content-wrapper) {
      background: #111620 !important;
      color: #F8FAFC !important;
      border: 1px solid rgba(46, 154, 254, 0.45);
      border-radius: 10px !important;
      box-shadow: 0 12px 28px rgba(0, 0, 0, 0.65) !important;
    }
    :global(.leaflet-popup-tip) {
      background: #111620 !important;
    }
    :global(.custom-pin-marker) {
      display: flex;
      align-items: center;
      justify-content: center;
      border-radius: 6px;
      font-family: 'JetBrains Mono', monospace;
      font-weight: 800;
      font-size: 10px;
      color: #FFFFFF;
      box-shadow: 0 2px 8px rgba(0, 0, 0, 0.65);
      border: 1.5px solid #FFFFFF;
    }
  </style>
</head>
<body>
  <!-- Authentic BMW ///M Tri-Color Accent Bar -->
  <div class="m-tricolor-strip"></div>

  <!-- Sticky Top Telemetry Header -->
  <header class="top-command-bar" id="top-cockpit">
    <div class="brand-cluster">
      <div class="m-crest" title="MC TRAVEL OS · Nordic &amp; M-Sport Travel OS">
        <span style="font-family:var(--font-mono);font-weight:800;font-style:italic;font-size:0.78rem;z-index:1;letter-spacing:-0.03em;">
          <span class="m-slash-1">/</span><span class="m-slash-2">/</span><span class="m-slash-3">/</span>MC
        </span>
      </div>
      <div class="brand-titles">
        <h1>
          MC TRAVEL OS
          <span class="m-badge-inline"><span class="m-slash-1">/</span><span class="m-slash-2">/</span><span class="m-slash-3">/</span>MC</span>
          <span class="badge-pill">Maria &amp; Christian</span>
          <span class="badge-pill badge-m-red">Clark Track · Liberty Walk · Cebu→Bohol 4x4</span>
        </h1>
        <p>32D Philippines Cockpit · {totalHotels} Stays (Ayala Triangle, Las Cabañas &amp; Lio) · Nov 8 – Dec 9, 2026</p>
      </div>
    </div>

    <div class="kpi-ribbon">
      <div class="kpi-chip target-green" id="kpi-shortlist-chip" style="cursor:pointer;" title="Click chip to jump to Budget Optimizer · Click toggle to switch Dynamic / Mid">
        <div style="display:flex;justify-content:space-between;align-items:center;gap:0.45rem;">
          <span class="label" id="shortlist-label-text">29N Lodging · Dynamic</span>
          <button type="button" class="badge-mini-toggle" id="btn-toggle-badge-mode" title="Toggle between Dynamic Live Selection and 25k–30k Mid Benchmark">⚡ Dynamic</button>
        </div>
        <span class="val" id="shortlist-total-badge">28,260 DKK (29N)</span>
      </div>
      <div class="segmented-control" role="group" aria-label="Currency Converter">
        <button type="button" class="curr-btn active" data-curr="DKK">DKK</button>
        <button type="button" class="curr-btn" data-curr="PHP">PHP (₱)</button>
        <button type="button" class="curr-btn" data-curr="EUR">EUR (€)</button>
      </div>
      <button type="button" class="theme-toggle-btn" id="btn-theme-toggle" title="Switch between BMW M Carbon Dark and Nordic Alpine Daylight">
        <span id="theme-toggle-label">☀️ Nordic Light</span>
      </button>
      <a
        class="sheet-sync-btn"
        href="./guides/"
        style="border-color:rgba(46, 154, 254, 0.45);color:var(--m-Sky-glow);"
        title="Open 7 Destination & Activity Field Guides"
      >
        <span>📖 Guides ({DESTINATION_GUIDES.length})</span>
      </a>
      <button
        type="button"
        class="sheet-sync-btn"
        id="btn-top-checklist"
        style="border-color:rgba(16, 185, 129, 0.45);color:#10B981;cursor:pointer;"
        title="Open 30-Item Travel & Track Checklist"
      >
        <span>🎒 Checklist (<span id="top-checklist-badge">0/{totalPackingItems}</span>)</span>
      </button>
      <a
        class="sheet-sync-btn"
        href="https://docs.google.com/spreadsheets/d/1OrCABb_TqMRWFFenlpoUbLRfmU9W5rxHlB7B2sXCkdY/edit?usp=drivesdk"
        target="_blank"
        rel="noopener noreferrer"
      >
        <span>📊 Sheet</span>
      </a>
    </div>
  </header>

  <!-- 7 Destination Hub Selector Strip -->
  <nav class="hub-nav-strip" aria-label="Destination Hubs">
    <button class="hub-tab-btn" id="btn-overview-all" type="button">
      <span class="num">ALL</span>
      <span>🇵🇭 All 7 Hubs</span>
    </button>
    {DESTINATION_HUBS.map((hub, idx) => (
      <button
        class={`hub-tab-btn hub-selector ${idx === 0 ? 'active' : ''}`}
        data-hub-id={hub.id}
        type="button"
      >
        <span class="num">{hub.number}</span>
        <span>{hub.name.split(':')[0]}</span>
        <span style="font-size:0.65rem;opacity:0.75;">({hub.hotels.length})</span>
      </button>
    ))}
  </nav>

  <!-- Main Balanced Split-Screen iDrive Cockpit -->
  <main class="cockpit-grid">
    <!-- LEFT COLUMN: Sticky Interactive Map + Live 7-Hub Budget Telemetry -->
    <aside class="map-column" id="section-map">
      <div class="map-frame-card">
        <div class="map-toolbar">
          <div class="map-toolbar-title">
            <span class="live-dot"></span>
            <span id="map-status-label">///M Telemetry Map · Tap Any Hub, Stay, Car Show or Roadtrip</span>
          </div>
          <div class="map-control-group">
            <button class="map-btn" id="btn-toggle-map-expand" type="button" title="Toggle Compact or Fullscreen Map">⛶ Expand</button>
            <button class="map-btn" id="btn-fit-archipelago" type="button">🗺️ All Islands</button>
            <button class="map-btn" id="btn-roadtrip-zoom" type="button">🛣️ Cebu→Bohol</button>
            <button class="map-btn" id="btn-cycle-basemap" type="button">🌑 Dark Map</button>
            <button class="map-btn active" id="btn-toggle-flights" type="button">✈️ Vectors</button>
            <button class="map-btn m-sport-btn" id="btn-play-tour" type="button">▶ Tour</button>
          </div>
        </div>

        <div id="ph-interactive-map"></div>

        <div class="map-legend-footer">
          <div class="legend-items">
            <span class="legend-item"><i class="legend-swatch" style="background:#0066B1;"></i> 5★ Flagship</span>
            <span class="legend-item"><i class="legend-swatch" style="background:#6366F1;"></i> Somerset / Serviced</span>
            <span class="legend-item"><i class="legend-swatch" style="background:#10B981;"></i> Luxury Airbnb / Boutique</span>
            <span class="legend-item"><i class="legend-swatch" style="background:#E30613;"></i> ///M Car Show / Circuit</span>
          </div>
          <span>1 DKK ≈ 8.4 PHP</span>
        </div>
      </div>

      <!-- Sticky Left Telemetry Bar: Live 29-Night Budget Gauge & 7-Hub Breakdown -->
      <div class="left-telemetry-card">
        <div class="budget-meter-labels">
          <span>29N Lodging Total: <strong style="color:var(--m-Sky-glow);" id="meter-current-total">28,260 DKK</strong></span>
          <span style="color:var(--nordic-mint);">🎯 Target: 25,000–30,000 DKK</span>
          <span>5★ Max: 51,065 DKK</span>
        </div>
        <div class="budget-bar-track">
          <div class="budget-target-zone" title="Target Budget Zone: 25,000 to 30,000 DKK"></div>
          <div class="budget-bar-fill" id="budget-bar-fill" style="width: 52%;"></div>
        </div>
        <div class="hub-breakdown-grid" id="hub-breakdown-grid"></div>
      </div>
    </aside>

    <!-- RIGHT COLUMN: Segmented M-Drive Mode Deck (No More 8,000px Scroll) -->
    <section class="right-deck-column" id="right-deck">
      <!-- BMW M Drive Mode Selector Bar -->
      <div class="m-drive-mode-bar" role="tablist" aria-label="Cockpit Display Mode">
        <div class="m-mode-tabs">
          <button type="button" class="m-mode-btn active" data-drive-mode="stays">
            <span>🏨 01 · Stays &amp; Budget ({totalHotels})</span>
          </button>
          <button type="button" class="m-mode-btn m-red-tab" data-drive-mode="msport">
            <span>🏎️ 02 · ///M Auto Shows &amp; Cebu→Bohol Roadtrip</span>
          </button>
          <button type="button" class="m-mode-btn" data-drive-mode="schedule">
            <span>🗓️ 03 · 32-Day Log</span>
          </button>
          <button type="button" class="m-mode-btn" data-drive-mode="flights">
            <span>✈️ 04 · Flights &amp; RORO</span>
          </button>
          <button type="button" class="m-mode-btn" data-drive-mode="packing">
            <span>🎒 05 · Travel Checklist ({totalPackingItems})</span>
          </button>
          <button type="button" class="m-mode-btn" data-drive-mode="guides">
            <span>📖 06 · Field Guides ({DESTINATION_GUIDES.length})</span>
          </button>
          <button type="button" class="m-mode-btn" data-drive-mode="all">
            <span>⚡ All</span>
          </button>
        </div>
      </div>

      <!-- =====================================================================
           DRIVE MODE 01: STAYS & 25k–30k DKK ACCOMMODATION BUDGET OPTIMIZER
           ===================================================================== -->
      <div class="deck-mode-section mode-active" id="mode-panel-stays" data-mode-panel="stays">
        <!-- TOP RIGHT COCKPIT WIDGET: Travel Readiness, Checklist & Essential Apps (GCash, Grab, eTravel) -->
        <div class="home-checklist-card" id="home-checklist-widget">
          <div class="home-checklist-header">
            <div class="home-checklist-title">
              <span class="m-badge-inline"><span class="m-slash-1">/</span><span class="m-slash-2">/</span><span class="m-slash-3">/</span>MC</span>
              <span>🎒 32-Day Travel Readiness, Checklist &amp; Essential Apps</span>
            </div>
            <div style="display:flex;align-items:center;gap:0.75rem;">
              <span class="home-checklist-progress" id="home-checklist-progress">0 / {totalPackingItems} Packed</span>
              <button type="button" class="map-btn" id="btn-jump-full-checklist" style="font-size:0.68rem;padding:0.25rem 0.6rem;">
                View All {totalPackingItems} Items ↗
              </button>
            </div>
          </div>

          <div class="home-subtab-bar">
            <button type="button" class="home-subtab-btn active" id="subtab-btn-checklist" data-home-subtab="checklist">
              🎒 Travel Checklist (<span id="home-checklist-tab-badge">0/{totalPackingItems}</span>)
            </button>
            <button type="button" class="home-subtab-btn" id="subtab-btn-apps" data-home-subtab="apps">
              📱 Essential Apps · GCash, Grab &amp; More ({ESSENTIAL_APPS.length})
            </button>
          </div>

          <!-- Subtab 1: Checklist -->
          <div id="home-subtab-content-checklist">
            <div class="home-checklist-bar-track">
              <div class="home-checklist-bar-fill" id="home-checklist-bar-fill" style="width:0%;"></div>
            </div>
            <div class="home-checklist-grid">
              {PACKING_CATEGORIES.slice(0, 4).map((cat) => {
                const topItem = cat.items[0];
                const secondItem = cat.items[1];
                return (
                  <div class="home-checklist-col">
                    <div class="home-checklist-col-title">
                      <span>{cat.icon}</span> <span>{cat.title}</span>
                    </div>
                    <label class="pack-item-label" for={`home-pack-${cat.id}-0`}>
                      <input type="checkbox" id={`home-pack-${cat.id}-0`} class="pack-checkbox home-pack-synced" data-pack-id={`pack-${cat.id}-0`} />
                      <span>{topItem}</span>
                    </label>
                    {secondItem && (
                      <label class="pack-item-label" for={`home-pack-${cat.id}-1`}>
                        <input type="checkbox" id={`home-pack-${cat.id}-1`} class="pack-checkbox home-pack-synced" data-pack-id={`pack-${cat.id}-1`} />
                        <span>{secondItem}</span>
                      </label>
                    )}
                  </div>
                );
              })}
            </div>
          </div>

          <!-- Subtab 2: Essential Apps (GCash, Grab, eTravel, etc.) -->
          <div id="home-subtab-content-apps" style="display:none;">
            <div style="font-size:0.75rem;color:var(--text-secondary);margin-bottom:0.4rem;">
              Crucial mobile apps for cashless payments (QR Ph), on-demand transport, immigration clearance, and island roaming across the Philippines:
            </div>
            <div class="apps-bento-grid">
              {ESSENTIAL_APPS.map((app) => (
                <div class="app-card">
                  <div>
                    <div class="app-card-head">
                      <div class="app-name-wrap">
                        <span>{app.icon}</span>
                        <span>{app.name}</span>
                      </div>
                      <span class="app-badge-tag">{app.badge}</span>
                    </div>
                    <p class="app-desc">{app.purpose}</p>
                    <div class="app-tip-box">
                      <strong>💡 Tip:</strong> {app.tip}
                    </div>
                  </div>
                  <div class="app-links">
                    {app.webUrl && (
                      <a href={app.webUrl} target="_blank" rel="noopener noreferrer" class="app-link-btn">
                        Web ↗
                      </a>
                    )}
                    {app.iosUrl && (
                      <a href={app.iosUrl} target="_blank" rel="noopener noreferrer" class="app-link-btn">
                        App Store ↗
                      </a>
                    )}
                    {app.androidUrl && (
                      <a href={app.androidUrl} target="_blank" rel="noopener noreferrer" class="app-link-btn">
                        Google Play ↗
                      </a>
                    )}
                  </div>
                </div>
              ))}
            </div>
          </div>
        </div>

        <div class="budget-optimizer-card" id="budget-optimizer">
          <div class="budget-opt-header">
            <div class="budget-opt-title">
              <span class="m-badge-inline"><span class="m-slash-1">/</span><span class="m-slash-2">/</span><span class="m-slash-3">/</span>M</span>
              <span>Accommodation Budget Optimizer (29 Nights · Flights Unchanged)</span>
            </div>
            <span class="budget-status-pill" id="budget-status-indicator">
