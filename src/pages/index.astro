---
import { DESTINATION_HUBS, FLIGHT_ROUTES, DAILY_ITINERARY, PACKING_CATEGORIES } from '../data/tourData';

const totalHotels = DESTINATION_HUBS.reduce((acc, h) => acc + h.hotels.length, 0);
const totalPackingItems = PACKING_CATEGORIES.reduce((acc, c) => acc + c.items.length, 0);
const cartoApiKey = import.meta.env.PUBLIC_CARTO_API_KEY || '';
---

<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0, viewport-fit=cover" />
  <meta name="theme-color" content="#006972" />
  <meta name="apple-mobile-web-app-capable" content="yes" />
  <meta name="apple-mobile-web-app-status-bar-style" content="black-translucent" />
  <title>KAPULUAN OS · Philippines 32-Day Personal Travel Guide (MC & Christian)</title>
  <link rel="icon" type="image/svg+xml" href="./favicon.svg" />
  <link rel="manifest" href="./manifest.webmanifest" />

  <!-- Google Fonts: Fraunces (Editorial Display), Plus Jakarta Sans (Clean Modern Philippine UI), JetBrains Mono (Flight Telemetry & Rates) -->
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Fraunces:ital,opsz,wght@0,9..144,500;0,9..144,700;1,9..144,400&family=JetBrains+Mono:wght@400;500;600;700&family=Plus+Jakarta+Sans:wght@400;500;600;700&display=swap" rel="stylesheet">

  <!-- Leaflet Interactive Map CSS & JS -->
  <link rel="stylesheet" href="https://unpkg.com/leaflet@1.9.4/dist/leaflet.css" integrity="sha256-p4NxAoJBhIIN+hmNHrzRCf9tD/miZyoHS5obTRR9BMY=" crossorigin="" />
  <script is:inline src="https://unpkg.com/leaflet@1.9.4/dist/leaflet.js" integrity="sha256-20nQCchB9co0qIjJZRGuk2/Z9VM+kNiyxNV1lvTlZBo=" crossorigin=""></script>

  <style>
    :root {
      --bg-abyss: #051117;
      --bg-panel: #091b24;
      --bg-card: #0d2430;
      --bg-card-hover: #133140;
      --bg-glass: rgba(9, 27, 36, 0.9);
      --teal-brand: #006972;
      --teal-glow: #14b8a6;
      --cyan-lagoon: #38bdf8;
      --cebpac-gold: #facc15;
      --cebpac-amber: #f59e0b;
      --coral-sunset: #fb7185;
      --capiz-cream: #f8fafc;
      --text-secondary: #94a3b8;
      --text-muted: #64748b;
      --border-subtle: rgba(56, 189, 248, 0.16);
      --border-gold: rgba(250, 204, 21, 0.38);
      --font-display: 'Fraunces', Georgia, serif;
      --font-sans: 'Plus Jakarta Sans', -apple-system, BlinkMacSystemFont, sans-serif;
      --font-mono: 'JetBrains Mono', monospace;
    }

    * {
      box-sizing: border-box;
      margin: 0;
      padding: 0;
      -webkit-tap-highlight-color: transparent;
    }

    html {
      scroll-behavior: smooth;
    }

    body {
      background-color: var(--bg-abyss);
      background-image:
        radial-gradient(circle at 12% 8%, rgba(20, 184, 166, 0.14), transparent 38%),
        radial-gradient(circle at 88% 15%, rgba(250, 204, 21, 0.08), transparent 35%),
        linear-gradient(180deg, #040d12 0%, #071821 100%);
      color: var(--capiz-cream);
      font-family: var(--font-sans);
      line-height: 1.5;
      overflow-x: hidden;
      padding-bottom: 84px; /* space for mobile bottom nav */
    }

    /* Philippine Banig / Hablon geometric weave accent bar */
    .banig-top-strip {
      height: 5px;
      background: repeating-linear-gradient(
        90deg,
        #006972 0px,
        #006972 24px,
        #14b8a6 24px,
        #14b8a6 48px,
        #facc15 48px,
        #facc15 60px,
        #0284c7 60px,
        #0284c7 84px
      );
    }

    /* Header / Telemetry Bar */
    .top-command-bar {
      display: flex;
      flex-wrap: wrap;
      justify-content: space-between;
      align-items: center;
      gap: 0.9rem;
      padding: 0.9rem 1.5rem;
      background: rgba(5, 17, 23, 0.94);
      backdrop-filter: blur(16px);
      border-bottom: 1px solid var(--border-subtle);
      position: sticky;
      top: 0;
      z-index: 1000;
    }

    .brand-cluster {
      display: flex;
      align-items: center;
      gap: 0.85rem;
    }

    .sun-emblem {
      width: 42px;
      height: 42px;
      border-radius: 11px;
      background: linear-gradient(135deg, #006972 0%, #0d9488 100%);
      border: 1px solid rgba(250, 204, 21, 0.55);
      display: grid;
      place-items: center;
      box-shadow: 0 0 20px rgba(20, 184, 166, 0.25);
      flex-shrink: 0;
    }

    .brand-titles h1 {
      font-family: var(--font-display);
      font-size: 1.28rem;
      font-weight: 700;
      letter-spacing: -0.02em;
      color: var(--capiz-cream);
      display: flex;
      flex-wrap: wrap;
      align-items: center;
      gap: 0.5rem;
    }

    .badge-pill {
      font-family: var(--font-mono);
      font-size: 0.68rem;
      font-weight: 600;
      text-transform: uppercase;
      letter-spacing: 0.06em;
      padding: 0.18rem 0.5rem;
      border-radius: 999px;
      background: rgba(20, 184, 166, 0.16);
      color: #5eead4;
      border: 1px solid rgba(20, 184, 166, 0.35);
    }

    .badge-cebpac {
      background: rgba(250, 204, 21, 0.15);
      color: var(--cebpac-gold);
      border-color: rgba(250, 204, 21, 0.4);
    }

    .brand-titles p {
      font-size: 0.78rem;
      color: var(--text-secondary);
    }

    .kpi-ribbon {
      display: flex;
      flex-wrap: wrap;
      gap: 0.55rem;
      align-items: center;
    }

    .kpi-chip {
      background: var(--bg-card);
      border: 1px solid var(--border-subtle);
      border-radius: 10px;
      padding: 0.35rem 0.75rem;
      display: flex;
      flex-direction: column;
    }

    .kpi-chip span.label {
      font-family: var(--font-mono);
      font-size: 0.62rem;
      text-transform: uppercase;
      letter-spacing: 0.08em;
      color: var(--text-secondary);
    }

    .kpi-chip span.val {
      font-family: var(--font-mono);
      font-size: 0.86rem;
      font-weight: 700;
      color: var(--capiz-cream);
    }

    .kpi-chip.gold span.val {
      color: var(--cebpac-gold);
    }

    /* Currency Toggle Switch */
    .currency-toggle {
      display: inline-flex;
      background: var(--bg-card);
      border: 1px solid var(--border-gold);
      border-radius: 10px;
      overflow: hidden;
    }

    .curr-btn {
      font-family: var(--font-mono);
      font-size: 0.74rem;
      font-weight: 700;
      padding: 0.45rem 0.65rem;
      border: none;
      background: transparent;
      color: var(--text-secondary);
      cursor: pointer;
      transition: all 0.15s ease;
    }

    .curr-btn.active {
      background: var(--cebpac-gold);
      color: #051117;
    }

    .sheet-sync-btn {
      display: inline-flex;
      align-items: center;
      gap: 0.4rem;
      padding: 0.5rem 0.9rem;
      border-radius: 10px;
      font-size: 0.78rem;
      font-weight: 600;
      text-decoration: none;
      background: linear-gradient(135deg, #006972 0%, #0284c7 100%);
      color: #ffffff;
      border: 1px solid rgba(56, 189, 248, 0.4);
      transition: all 0.2s ease;
      white-space: nowrap;
    }

    .sheet-sync-btn:hover {
      transform: translateY(-1px);
      box-shadow: 0 6px 20px rgba(2, 132, 199, 0.35);
    }

    /* Destination Hub Selector Bar */
    .hub-nav-strip {
      display: flex;
      align-items: center;
      gap: 0.5rem;
      padding: 0.65rem 1.5rem;
      background: rgba(9, 27, 36, 0.9);
      border-bottom: 1px solid var(--border-subtle);
      overflow-x: auto;
      scroll-snap-type: x mandatory;
      -webkit-overflow-scrolling: touch;
      scrollbar-width: none;
    }

    .hub-nav-strip::-webkit-scrollbar {
      display: none;
    }

    .hub-tab-btn {
      scroll-snap-align: start;
      display: flex;
      align-items: center;
      gap: 0.5rem;
      padding: 0.52rem 0.9rem;
      border-radius: 10px;
      background: var(--bg-card);
      border: 1px solid var(--border-subtle);
      color: var(--text-secondary);
      font-family: var(--font-sans);
      font-size: 0.8rem;
      font-weight: 600;
      cursor: pointer;
      white-space: nowrap;
      transition: all 0.2s ease;
      flex-shrink: 0;
    }

    .hub-tab-btn:hover {
      background: var(--bg-card-hover);
      color: var(--capiz-cream);
      border-color: rgba(20, 184, 166, 0.45);
    }

    .hub-tab-btn.active {
      background: linear-gradient(135deg, rgba(0, 105, 114, 0.92), rgba(14, 116, 144, 0.92));
      color: #ffffff;
      border-color: var(--cebpac-gold);
      box-shadow: 0 0 16px rgba(20, 184, 166, 0.32);
    }

    .hub-tab-btn .num {
      font-family: var(--font-mono);
      font-size: 0.68rem;
      padding: 0.1rem 0.38rem;
      border-radius: 6px;
      background: rgba(5, 17, 23, 0.65);
      color: var(--cebpac-gold);
    }

    /* Main Split Cockpit Layout */
    .cockpit-grid {
      display: grid;
      grid-template-columns: 1.05fr 1fr;
      gap: 1.25rem;
      padding: 1.25rem 1.5rem;
      max-width: 1920px;
      margin: 0 auto;
    }

    /* Left Column: Interactive Map + SVG Flight Schematic */
    .map-column {
      display: flex;
      flex-direction: column;
      gap: 1.25rem;
    }

    .map-frame-card {
      background: var(--bg-panel);
      border: 1px solid var(--border-subtle);
      border-radius: 16px;
      overflow: hidden;
      box-shadow: 0 18px 40px rgba(0, 0, 0, 0.45);
      display: flex;
      flex-direction: column;
    }

    .map-toolbar {
      display: flex;
      flex-wrap: wrap;
      justify-content: space-between;
      align-items: center;
      gap: 0.65rem;
      padding: 0.8rem 1.1rem;
      background: var(--bg-card);
      border-bottom: 1px solid var(--border-subtle);
    }

    .map-toolbar-title {
      display: flex;
      align-items: center;
      gap: 0.55rem;
      font-size: 0.84rem;
      font-weight: 700;
    }

    .live-dot {
      width: 9px;
      height: 9px;
      border-radius: 50%;
      background: #10b981;
      box-shadow: 0 0 10px #10b981;
      animation: pulseDot 2s infinite;
      flex-shrink: 0;
    }

    @keyframes pulseDot {
      0%, 100% { transform: scale(1); opacity: 1; }
      50% { transform: scale(1.35); opacity: 0.55; }
    }

    .map-control-group {
      display: flex;
      flex-wrap: wrap;
      gap: 0.4rem;
    }

    .map-btn {
      font-family: var(--font-mono);
      font-size: 0.72rem;
      font-weight: 600;
      padding: 0.42rem 0.72rem;
      border-radius: 8px;
      border: 1px solid var(--border-subtle);
      background: var(--bg-panel);
      color: var(--capiz-cream);
      cursor: pointer;
      transition: all 0.18s ease;
    }

    .map-btn:hover, .map-btn.active {
      background: var(--teal-brand);
      border-color: var(--cyan-lagoon);
    }

    .map-btn.gold {
      background: rgba(250, 204, 21, 0.15);
      border-color: rgba(250, 204, 21, 0.5);
      color: var(--cebpac-gold);
    }

    .map-btn.gold:hover {
      background: rgba(250, 204, 21, 0.28);
    }

    #ph-interactive-map {
      width: 100%;
      height: 510px;
      background: #041016;
      z-index: 1;
    }

    #ph-interactive-map.map-filter-dark :global(.leaflet-tile-pane) {
      filter: invert(100%) hue-rotate(185deg) brightness(92%) contrast(94%) saturate(135%);
    }

    .map-legend-footer {
      display: flex;
      flex-wrap: wrap;
      justify-content: space-between;
      align-items: center;
      gap: 0.65rem;
      padding: 0.65rem 1.1rem;
      background: rgba(5, 17, 23, 0.92);
      border-top: 1px solid var(--border-subtle);
      font-size: 0.74rem;
      color: var(--text-secondary);
    }

    .legend-items {
      display: flex;
      flex-wrap: wrap;
      gap: 0.85rem;
      align-items: center;
    }

    .legend-item {
      display: flex;
      align-items: center;
      gap: 0.35rem;
    }

    .legend-swatch {
      width: 11px;
      height: 11px;
      border-radius: 50%;
      display: inline-block;
    }

    /* Cebu Pacific Flight Vector & Island Transit Card */
    .flight-schematic-card {
      background: var(--bg-panel);
      border: 1px solid var(--border-subtle);
      border-radius: 16px;
      padding: 1.15rem;
      box-shadow: 0 14px 32px rgba(0, 0, 0, 0.35);
    }

    .section-header-row {
      display: flex;
      flex-wrap: wrap;
      justify-content: space-between;
      align-items: center;
      gap: 0.65rem;
      margin-bottom: 0.9rem;
    }

    .section-header-row h2 {
      font-family: var(--font-display);
      font-size: 1.15rem;
      font-weight: 700;
      color: var(--capiz-cream);
      display: flex;
      align-items: center;
      gap: 0.5rem;
    }

    /* SVG Animated Flight Arc Diagram */
    .svg-flight-banner {
      width: 100%;
      background: linear-gradient(180deg, rgba(4, 15, 22, 0.95) 0%, rgba(9, 31, 43, 0.9) 100%);
      border: 1px solid rgba(250, 204, 21, 0.25);
      border-radius: 12px;
      padding: 0.65rem;
      margin-bottom: 0.95rem;
      overflow-x: auto;
    }

    .svg-flight-banner svg {
      min-width: 640px;
    }

    .flight-arc-line {
      stroke-dasharray: 7 5;
      animation: dashFlow 18s linear infinite;
    }

    @keyframes dashFlow {
      to {
        stroke-dashoffset: -240;
      }
    }

    .flight-legs-grid {
      display: grid;
      grid-template-columns: repeat(auto-fill, minmax(255px, 1fr));
      gap: 0.75rem;
    }

    .flight-leg-card {
      background: var(--bg-card);
      border: 1px solid var(--border-subtle);
      border-radius: 12px;
      padding: 0.85rem;
      display: flex;
      flex-direction: column;
      justify-content: space-between;
      gap: 0.5rem;
      cursor: pointer;
      transition: all 0.2s ease;
    }

    .flight-leg-card:hover {
      border-color: var(--cebpac-gold);
      transform: translateY(-2px);
      background: var(--bg-card-hover);
    }

    .flight-leg-top {
      display: flex;
      justify-content: space-between;
      align-items: center;
    }

    .route-code {
      font-family: var(--font-mono);
      font-size: 0.9rem;
      font-weight: 700;
      color: var(--cebpac-gold);
    }

    .fare-tag {
      font-family: var(--font-mono);
      font-size: 0.76rem;
      font-weight: 700;
      padding: 0.15rem 0.5rem;
      border-radius: 6px;
      background: rgba(20, 184, 166, 0.16);
      color: #5eead4;
    }

    .carrier-line {
      font-size: 0.78rem;
      font-weight: 600;
      color: var(--capiz-cream);
    }

    .flight-notes {
      font-size: 0.73rem;
      color: var(--text-secondary);
    }

    .baggage-tip {
      font-size: 0.7rem;
      color: #bae6fd;
      background: rgba(56, 189, 248, 0.08);
      padding: 0.3rem 0.5rem;
      border-radius: 6px;
      border-left: 2px solid var(--cyan-lagoon);
    }

    .flight-leg-actions {
      display: flex;
      justify-content: space-between;
      align-items: center;
      margin-top: 0.2rem;
      padding-top: 0.45rem;
      border-top: 1px solid rgba(255, 255, 255, 0.06);
    }

    .flight-duration {
      font-family: var(--font-mono);
      font-size: 0.7rem;
      color: var(--text-secondary);
    }

    .cebpac-book-link {
      font-family: var(--font-mono);
      font-size: 0.72rem;
      font-weight: 700;
      color: #051117;
      background: var(--cebpac-gold);
      padding: 0.28rem 0.62rem;
      border-radius: 6px;
      text-decoration: none;
      transition: all 0.15s ease;
    }

    .cebpac-book-link:hover {
      background: #fde047;
      box-shadow: 0 0 12px rgba(250, 204, 21, 0.5);
    }

    /* Right Column: Active Destination Hub Spotlight & Minimum 6 Curated 4-5★ Hotel Cards */
    .hotels-column {
      display: flex;
      flex-direction: column;
      gap: 1.25rem;
    }

    /* Accommodation Budget Optimizer & Filter Card */
    .budget-optimizer-card {
      background: linear-gradient(145deg, rgba(9, 27, 36, 0.98) 0%, rgba(13, 36, 48, 0.95) 100%);
      border: 1px solid var(--border-gold);
      border-radius: 16px;
      padding: 1.15rem 1.25rem;
      box-shadow: 0 16px 36px rgba(0, 0, 0, 0.42);
      display: flex;
      flex-direction: column;
      gap: 0.85rem;
    }

    .budget-opt-header {
      display: flex;
      flex-wrap: wrap;
      justify-content: space-between;
      align-items: center;
      gap: 0.65rem;
    }

    .budget-opt-title {
      font-family: var(--font-display);
      font-size: 1.14rem;
      font-weight: 700;
      color: var(--capiz-cream);
      display: flex;
      align-items: center;
      gap: 0.5rem;
    }

    .budget-status-pill {
      font-family: var(--font-mono);
      font-size: 0.75rem;
      font-weight: 700;
      padding: 0.3rem 0.7rem;
      border-radius: 999px;
      background: rgba(16, 185, 129, 0.18);
      border: 1px solid rgba(16, 185, 129, 0.5);
      color: #6ee7b7;
    }

    .budget-status-pill.over-target {
      background: rgba(251, 113, 133, 0.16);
      border-color: rgba(251, 113, 133, 0.45);
      color: #fda4af;
    }

    .preset-grid {
      display: grid;
      grid-template-columns: repeat(auto-fit, minmax(210px, 1fr));
      gap: 0.55rem;
    }

    .preset-btn {
      background: var(--bg-card);
      border: 1px solid var(--border-subtle);
      border-radius: 11px;
      padding: 0.62rem 0.78rem;
      text-align: left;
      cursor: pointer;
      transition: all 0.18s ease;
      display: flex;
      flex-direction: column;
      gap: 0.2rem;
      color: var(--capiz-cream);
    }

    .preset-btn:hover {
      background: var(--bg-card-hover);
      border-color: var(--teal-glow);
      transform: translateY(-1px);
    }

    .preset-btn.active {
      background: linear-gradient(135deg, rgba(0, 105, 114, 0.55), rgba(250, 204, 21, 0.14));
      border-color: var(--cebpac-gold);
      box-shadow: 0 0 16px rgba(250, 204, 21, 0.22);
    }

    .preset-btn .p-top {
      display: flex;
      justify-content: space-between;
      align-items: center;
      font-family: var(--font-mono);
      font-size: 0.72rem;
      font-weight: 700;
    }

    .preset-btn .p-price {
      color: var(--cebpac-gold);
    }

    .preset-btn .p-desc {
      font-size: 0.72rem;
      color: var(--text-secondary);
      line-height: 1.3;
    }

    .budget-meter-wrap {
      background: rgba(5, 17, 23, 0.75);
      border: 1px solid rgba(255, 255, 255, 0.08);
      border-radius: 10px;
      padding: 0.6rem 0.8rem;
    }

    .budget-meter-labels {
      display: flex;
      justify-content: space-between;
      font-family: var(--font-mono);
      font-size: 0.69rem;
      color: var(--text-secondary);
      margin-bottom: 0.35rem;
    }

    .budget-bar-track {
      height: 10px;
      background: #041016;
      border-radius: 999px;
      position: relative;
      overflow: hidden;
      border: 1px solid rgba(255, 255, 255, 0.1);
    }

    .budget-target-zone {
      position: absolute;
      top: 0;
      bottom: 0;
      left: 45%;
      width: 12%;
      background: rgba(16, 185, 129, 0.28);
      border-left: 1px dashed #10b981;
      border-right: 1px dashed #10b981;
      z-index: 1;
    }

    .budget-bar-fill {
      height: 100%;
      background: linear-gradient(90deg, #14b8a6 0%, #facc15 100%);
      border-radius: 999px;
      transition: width 0.35s ease;
    }

    .stay-filter-bar {
      display: flex;
      flex-wrap: wrap;
      align-items: center;
      justify-content: space-between;
      gap: 0.5rem;
      padding-top: 0.45rem;
      border-top: 1px solid rgba(255, 255, 255, 0.08);
    }

    .stay-filter-pills {
      display: flex;
      flex-wrap: wrap;
      gap: 0.38rem;
    }

    .stay-filter-btn {
      font-family: var(--font-mono);
      font-size: 0.69rem;
      font-weight: 600;
      padding: 0.32rem 0.62rem;
      border-radius: 8px;
      border: 1px solid var(--border-subtle);
      background: var(--bg-card);
      color: var(--text-secondary);
      cursor: pointer;
      transition: all 0.15s ease;
    }

    .stay-filter-btn.active, .stay-filter-btn:hover {
      background: var(--teal-brand);
      color: #ffffff;
      border-color: var(--cyan-lagoon);
    }

    .hub-breakdown-grid {
      display: grid;
      grid-template-columns: repeat(auto-fit, minmax(175px, 1fr));
      gap: 0.45rem;
      margin-top: 0.25rem;
    }

    .hub-mini-summary {
      background: rgba(5, 17, 23, 0.65);
      border: 1px solid rgba(56, 189, 248, 0.16);
      border-radius: 8px;
      padding: 0.4rem 0.58rem;
      font-size: 0.7rem;
      cursor: pointer;
      transition: border-color 0.15s ease;
    }

    .hub-mini-summary:hover {
      border-color: var(--cebpac-gold);
    }

    .hotel-card.filtered-out {
      display: none !important;
    }

    .tier-tag-serviced {
      background: rgba(56, 189, 248, 0.18);
      color: #7dd3fc;
      border-color: rgba(56, 189, 248, 0.45);
    }

    .tier-tag-airbnb {
      background: rgba(251, 113, 133, 0.18);
      color: #fda4af;
      border-color: rgba(251, 113, 133, 0.45);
    }

    .hub-spotlight-panel {
      display: none;
      flex-direction: column;
      gap: 0.95rem;
      background: var(--bg-panel);
      border: 1px solid var(--border-subtle);
      border-radius: 16px;
      padding: 1.25rem;
      box-shadow: 0 18px 40px rgba(0, 0, 0, 0.45);
    }

    .hub-spotlight-panel.active {
      display: flex;
    }

    .hub-banner-head {
      display: flex;
      flex-wrap: wrap;
      justify-content: space-between;
      align-items: flex-start;
      gap: 0.85rem;
      padding-bottom: 0.9rem;
      border-bottom: 1px solid var(--border-subtle);
    }

    .hub-title-block .region-kicker {
      font-family: var(--font-mono);
      font-size: 0.7rem;
      text-transform: uppercase;
      letter-spacing: 0.1em;
      color: var(--teal-glow);
    }

    .hub-title-block h2 {
      font-family: var(--font-display);
      font-size: 1.55rem;
      font-weight: 700;
      color: var(--capiz-cream);
      margin-top: 0.1rem;
    }

    .hub-title-block p.tagline {
      font-size: 0.84rem;
      color: var(--text-secondary);
      margin-top: 0.15rem;
    }

    .hub-meta-badges {
      display: flex;
      flex-wrap: wrap;
      gap: 0.45rem;
      align-items: center;
    }

    .hub-dates-pill {
      font-family: var(--font-mono);
      font-size: 0.74rem;
      font-weight: 600;
      padding: 0.35rem 0.7rem;
      border-radius: 9px;
      background: rgba(0, 105, 114, 0.35);
      border: 1px solid var(--cyan-lagoon);
      color: var(--capiz-cream);
    }

    .hub-weather-pill {
      font-family: var(--font-mono);
      font-size: 0.72rem;
      padding: 0.35rem 0.7rem;
      border-radius: 9px;
      background: rgba(250, 204, 21, 0.1);
      border: 1px solid rgba(250, 204, 21, 0.3);
      color: #fde047;
    }

    /* Dual Highlight Strip (Motorsport + Romance/Culture + Cebu Pacific Gateway) */
    .dual-highlights-grid {
      display: grid;
      grid-template-columns: repeat(auto-fit, minmax(210px, 1fr));
      gap: 0.7rem;
    }

    .highlight-box {
      background: var(--bg-card);
      border: 1px solid var(--border-subtle);
      border-radius: 12px;
      padding: 0.72rem 0.85rem;
    }

    .highlight-box.cebpac-box {
      border-color: var(--border-gold);
      background: linear-gradient(135deg, rgba(250, 204, 21, 0.09), rgba(9, 27, 36, 0.92));
    }

    .highlight-box .h-label {
      font-family: var(--font-mono);
      font-size: 0.67rem;
      font-weight: 700;
      text-transform: uppercase;
      letter-spacing: 0.06em;
      margin-bottom: 0.22rem;
      display: flex;
      align-items: center;
      gap: 0.35rem;
    }

    .highlight-box p {
      font-size: 0.78rem;
      color: var(--capiz-cream);
    }

    /* Landmarks Chip Row */
    .landmarks-bar {
      display: flex;
      flex-wrap: wrap;
      align-items: center;
      gap: 0.45rem;
      font-size: 0.75rem;
    }

    .landmark-chip {
      background: rgba(56, 189, 248, 0.12);
      border: 1px solid rgba(56, 189, 248, 0.35);
      color: #bae6fd;
      padding: 0.3rem 0.65rem;
      border-radius: 999px;
      cursor: pointer;
      transition: all 0.15s ease;
      font-size: 0.73rem;
      text-align: left;
    }

    .landmark-chip:hover {
      background: rgba(56, 189, 248, 0.28);
      color: #ffffff;
    }

    /* 6+ Hotel Options Grid */
    .hotels-grid {
      display: grid;
      grid-template-columns: repeat(auto-fill, minmax(270px, 1fr));
      gap: 0.8rem;
    }

    .hotel-card {
      background: var(--bg-card);
      border: 1px solid var(--border-subtle);
      border-radius: 13px;
      padding: 0.9rem;
      display: flex;
      flex-direction: column;
      justify-content: space-between;
      gap: 0.55rem;
      transition: all 0.2s ease;
      position: relative;
    }

    .hotel-card:hover {
      border-color: var(--teal-glow);
      background: var(--bg-card-hover);
      transform: translateY(-2px);
      box-shadow: 0 10px 24px rgba(0, 0, 0, 0.35);
    }

    .hotel-card.selected-stay {
      border-color: var(--cebpac-gold);
      box-shadow: 0 0 18px rgba(250, 204, 21, 0.22);
    }

    .hotel-card-header {
      display: flex;
      justify-content: space-between;
      align-items: flex-start;
      gap: 0.45rem;
    }

    .option-badge {
      font-family: var(--font-mono);
      font-size: 0.66rem;
      font-weight: 700;
      padding: 0.15rem 0.48rem;
      border-radius: 6px;
      background: rgba(0, 105, 114, 0.55);
      color: #5eead4;
      border: 1px solid rgba(20, 184, 166, 0.4);
    }

    .rate-pill {
      font-family: var(--font-mono);
      font-size: 0.84rem;
      font-weight: 700;
      color: var(--cebpac-gold);
      background: rgba(250, 204, 21, 0.12);
      border: 1px solid rgba(250, 204, 21, 0.35);
      padding: 0.16rem 0.52rem;
      border-radius: 7px;
      white-space: nowrap;
    }

    .hotel-name {
      font-family: var(--font-display);
      font-size: 1.02rem;
      font-weight: 700;
      color: var(--capiz-cream);
      line-height: 1.25;
    }

    .stars-line {
      font-family: var(--font-mono);
      font-size: 0.7rem;
      color: #38bdf8;
      margin-top: 0.1rem;
    }

    .proximity-box {
      background: rgba(5, 17, 23, 0.65);
      border-left: 3px solid var(--teal-glow);
      padding: 0.42rem 0.6rem;
      border-radius: 0 8px 8px 0;
      font-size: 0.74rem;
    }

    .proximity-box strong {
      color: #5eead4;
      display: block;
      font-size: 0.69rem;
      text-transform: uppercase;
      letter-spacing: 0.04em;
    }

    .hotel-highlight {
      font-size: 0.75rem;
      color: var(--text-secondary);
    }

    .hotel-card-footer {
      display: flex;
      flex-wrap: wrap;
      justify-content: space-between;
      align-items: center;
      gap: 0.4rem;
      padding-top: 0.48rem;
      border-top: 1px solid rgba(255, 255, 255, 0.07);
    }

    .locate-pin-btn, .shortlist-btn {
      font-family: var(--font-mono);
      font-size: 0.7rem;
      font-weight: 600;
      padding: 0.32rem 0.58rem;
      border-radius: 7px;
      border: 1px solid var(--border-subtle);
      background: rgba(56, 189, 248, 0.1);
      color: #bae6fd;
      cursor: pointer;
      transition: all 0.15s ease;
    }

    .locate-pin-btn:hover, .shortlist-btn:hover {
      background: var(--teal-brand);
      color: #ffffff;
    }

    .shortlist-btn.active {
      background: rgba(250, 204, 21, 0.22);
      border-color: var(--cebpac-gold);
      color: var(--cebpac-gold);
    }

    .hotel-book-btn {
      font-family: var(--font-mono);
      font-size: 0.71rem;
      font-weight: 700;
      padding: 0.34rem 0.68rem;
      border-radius: 7px;
      background: linear-gradient(135deg, #006972, #0d9488);
      color: #ffffff;
      text-decoration: none;
      border: 1px solid rgba(94, 234, 212, 0.4);
      transition: all 0.15s ease;
    }

    .hotel-book-btn:hover {
      background: linear-gradient(135deg, #0d9488, #14b8a6);
      box-shadow: 0 0 12px rgba(20, 184, 166, 0.45);
    }

    /* Curated Culinary & Coffee Strip per Hub */
    .dining-strip {
      margin-top: 0.35rem;
      padding-top: 0.85rem;
      border-top: 1px solid var(--border-subtle);
    }

    .dining-grid {
      display: grid;
      grid-template-columns: repeat(auto-fit, minmax(210px, 1fr));
      gap: 0.65rem;
      margin-top: 0.55rem;
    }

    .dining-card {
      background: rgba(5, 17, 23, 0.55);
      border: 1px solid rgba(255, 255, 255, 0.08);
      border-radius: 10px;
      padding: 0.65rem 0.8rem;
      font-size: 0.75rem;
    }

    .dining-cat {
      font-family: var(--font-mono);
      font-size: 0.65rem;
      color: var(--cebpac-gold);
      text-transform: uppercase;
      letter-spacing: 0.06em;
    }

    /* Secondary Full-Width Sections (32-Day Timeline + Packing & Prep Guide) */
    .fullwidth-section {
      padding: 0 1.5rem 1.5rem;
      max-width: 1920px;
      margin: 0 auto;
    }

    .surface-card {
      background: var(--bg-panel);
      border: 1px solid var(--border-subtle);
      border-radius: 16px;
      padding: 1.25rem;
      box-shadow: 0 18px 40px rgba(0, 0, 0, 0.45);
    }

    .filter-pills {
      display: flex;
      flex-wrap: wrap;
      gap: 0.4rem;
    }

    .filter-pill {
      font-family: var(--font-mono);
      font-size: 0.71rem;
      padding: 0.35rem 0.7rem;
      border-radius: 999px;
      border: 1px solid var(--border-subtle);
      background: var(--bg-card);
      color: var(--text-secondary);
      cursor: pointer;
    }

    .filter-pill.active, .filter-pill:hover {
      background: var(--teal-brand);
      color: #ffffff;
      border-color: var(--cyan-lagoon);
    }

    .itinerary-table-wrap {
      overflow-x: auto;
      margin-top: 0.9rem;
      border-radius: 12px;
      border: 1px solid var(--border-subtle);
    }

    table.itinerary-table {
      width: 100%;
      border-collapse: collapse;
      font-size: 0.8rem;
    }

    table.itinerary-table th {
      background: #005b63;
      color: #ffffff;
      font-family: var(--font-mono);
      font-size: 0.7rem;
      text-transform: uppercase;
      letter-spacing: 0.06em;
      padding: 0.7rem 0.85rem;
      text-align: left;
      border-bottom: 1px solid var(--border-subtle);
    }

    table.itinerary-table td {
      padding: 0.7rem 0.85rem;
      border-bottom: 1px solid rgba(255, 255, 255, 0.06);
      vertical-align: top;
    }

    table.itinerary-table tr.day-row {
      cursor: pointer;
      transition: background 0.15s ease;
    }

    table.itinerary-table tr.day-row:nth-child(even) {
      background: rgba(13, 36, 48, 0.55);
    }

    table.itinerary-table tr.day-row:hover {
      background: rgba(20, 184, 166, 0.18);
    }

    .day-badge {
      font-family: var(--font-mono);
      font-weight: 700;
      color: var(--cebpac-gold);
      white-space: nowrap;
    }

    /* Packing & Pre-Departure Interactive Checklist Grid */
    .packing-grid {
      display: grid;
      grid-template-columns: repeat(auto-fit, minmax(280px, 1fr));
      gap: 0.9rem;
      margin-top: 0.9rem;
    }

    .packing-box {
      background: var(--bg-card);
      border: 1px solid var(--border-subtle);
      border-radius: 12px;
      padding: 0.95rem;
    }

    .packing-box h3 {
      font-family: var(--font-display);
      font-size: 1rem;
      margin-bottom: 0.65rem;
      color: var(--capiz-cream);
      display: flex;
      align-items: center;
      gap: 0.45rem;
    }

    .pack-item-label {
      display: flex;
      align-items: flex-start;
      gap: 0.55rem;
      font-size: 0.78rem;
      color: var(--capiz-cream);
      padding: 0.35rem 0;
      cursor: pointer;
      border-bottom: 1px solid rgba(255, 255, 255, 0.04);
    }

    .pack-item-label input[type="checkbox"] {
      margin-top: 0.2rem;
      accent-color: var(--teal-glow);
      width: 15px;
      height: 15px;
      flex-shrink: 0;
    }

    .pack-item-label.checked span {
      text-decoration: line-through;
      color: var(--text-muted);
    }

    /* Sticky Mobile Bottom Navigation Bar */
    .mobile-bottom-dock {
      display: none;
      position: fixed;
      bottom: 0;
      left: 0;
      right: 0;
      background: rgba(5, 17, 23, 0.96);
      backdrop-filter: blur(16px);
      border-top: 1px solid var(--border-subtle);
      padding: 0.45rem 0.5rem calc(0.45rem + env(safe-area-inset-bottom));
      z-index: 1500;
      justify-content: space-around;
      align-items: center;
    }

    .dock-btn {
      display: flex;
      flex-direction: column;
      align-items: center;
      gap: 0.15rem;
      background: none;
      border: none;
      color: var(--text-secondary);
      font-family: var(--font-mono);
      font-size: 0.65rem;
      font-weight: 600;
      text-decoration: none;
      padding: 0.3rem 0.6rem;
      border-radius: 8px;
      cursor: pointer;
    }

    .dock-btn.active, .dock-btn:hover {
      color: var(--cebpac-gold);
      background: rgba(250, 204, 21, 0.1);
    }

    .dock-btn span.icon {
      font-size: 1.05rem;
    }

    /* Responsive Breakpoints & Mobile Touch Optimizations */
    @media (max-width: 1200px) {
      .cockpit-grid {
        grid-template-columns: 1fr;
      }
    }

    @media (max-width: 768px) {
      .top-command-bar {
        padding: 0.75rem 1rem;
      }
      .brand-titles h1 {
        font-size: 1.08rem;
      }
      .kpi-ribbon {
        width: 100%;
        justify-content: space-between;
      }
      .kpi-chip {
        padding: 0.3rem 0.55rem;
      }
      .hub-nav-strip {
        padding: 0.55rem 1rem;
        position: sticky;
        top: 66px;
        z-index: 990;
      }
      .cockpit-grid {
        padding: 0.85rem 1rem;
        gap: 1rem;
      }
      #ph-interactive-map {
        height: 360px;
      }
      .fullwidth-section {
        padding: 0 1rem 1.25rem;
      }
      .mobile-bottom-dock {
        display: flex;
      }
      /* Convert 32-day table into mobile cards on narrow screens */
      table.itinerary-table thead {
        display: none;
      }
      table.itinerary-table,
      table.itinerary-table tbody,
      table.itinerary-table tr,
      table.itinerary-table td {
        display: block;
        width: 100%;
      }
      table.itinerary-table tr.day-row {
        padding: 0.65rem;
        border-bottom: 1px solid var(--border-subtle);
      }
      table.itinerary-table td {
        padding: 0.25rem 0.4rem;
        border: none;
      }
    }

    /* Custom Leaflet Popup Styling */
    :global(.leaflet-popup-content-wrapper) {
      background: #091b24 !important;
      color: #f8fafc !important;
      border: 1px solid rgba(20, 184, 166, 0.5);
      border-radius: 12px !important;
      box-shadow: 0 12px 28px rgba(0, 0, 0, 0.65) !important;
    }
    :global(.leaflet-popup-tip) {
      background: #091b24 !important;
    }
    :global(.custom-pin-marker) {
      display: flex;
      align-items: center;
      justify-content: center;
      border-radius: 50%;
      font-family: 'JetBrains Mono', monospace;
      font-weight: 700;
      font-size: 11px;
      color: #051117;
      box-shadow: 0 0 12px rgba(0, 0, 0, 0.7);
      border: 2px solid #ffffff;
    }
  </style>
</head>
<body>
  <div class="banig-top-strip"></div>

  <!-- Top Telemetry & KPI Header -->
  <header class="top-command-bar" id="top-cockpit">
    <div class="brand-cluster">
      <div class="sun-emblem" title="Philippine Archipelago Travel OS">
        <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="#facc15" stroke-width="2">
          <circle cx="12" cy="12" r="4" fill="#facc15" />
          <path d="M12 2v3M12 19v3M2 12h3M19 12h3M4.93 4.93l2.12 2.12M16.95 16.95l2.12 2.12M19.07 4.93l-2.12 2.12M7.05 16.95l-2.12 2.12" />
        </svg>
      </div>
      <div class="brand-titles">
        <h1>
          KAPULUAN TRAVEL OS
          <span class="badge-pill">MC &amp; Christian</span>
          <span class="badge-pill badge-cebpac">Cebu Pacific 5J · DG · T6</span>
        </h1>
        <p>Philippines 32-Day Personal Guide · {totalHotels} Vetted 4–5★ Landmark Hotels (6+ / Hub) · Nov 8 – Dec 9</p>
      </div>
    </div>

    <div class="kpi-ribbon">
      <div class="kpi-chip">
        <span class="label">Duration</span>
        <span class="val">32 Days · 7 Hubs</span>
      </div>
      <div class="kpi-chip">
        <span class="label">4–5★ Hotels</span>
        <span class="val">{totalHotels} Options (6+ / Hub)</span>
      </div>
      <div class="kpi-chip gold">
        <span class="label">Shortlisted Budget</span>
        <span class="val" id="shortlist-total-badge">7 Hubs Ready</span>
      </div>
      <div class="currency-toggle" role="group" aria-label="Currency Converter">
        <button type="button" class="curr-btn active" data-curr="DKK">DKK</button>
        <button type="button" class="curr-btn" data-curr="PHP">PHP (₱)</button>
        <button type="button" class="curr-btn" data-curr="EUR">EUR (€)</button>
      </div>
      <a
        class="sheet-sync-btn"
        href="https://docs.google.com/spreadsheets/d/1OrCABb_TqMRWFFenlpoUbLRfmU9W5rxHlB7B2sXCkdY/edit?usp=drivesdk"
        target="_blank"
        rel="noopener noreferrer"
      >
        <span>📊 Google Sheet</span>
      </a>
    </div>
  </header>

  <!-- Destination Hub Navigation Strip -->
  <nav class="hub-nav-strip" aria-label="Destination Hubs">
    <button class="hub-tab-btn" id="btn-overview-all" type="button">
      <span class="num">ALL</span>
      <span>🇵🇭 All 7 Hubs</span>
    </button>
    {DESTINATION_HUBS.map((hub, idx) => (
      <button
        class={`hub-tab-btn hub-selector ${idx === 0 ? 'active' : ''}`}
        data-hub-id={hub.id}
        type="button"
      >
        <span class="num">{hub.number}</span>
        <span>{hub.name}</span>
        <span style="font-size:0.68rem; opacity:0.75;">({hub.hotels.length}★)</span>
      </button>
    ))}
  </nav>

  <!-- Main Interactive Split Cockpit -->
  <main class="cockpit-grid">
    <!-- LEFT COLUMN: Interactive Leaflet Map + Cebu Pacific Vector Flight Matrix -->
    <section class="map-column" id="section-map">
      <div class="map-frame-card">
        <div class="map-toolbar">
          <div class="map-toolbar-title">
            <span class="live-dot"></span>
            <span id="map-status-label">Interactive Archipelago Map · Tap Any Hub, Hotel, Landmark or Flight Arc</span>
          </div>
          <div class="map-control-group">
            <button class="map-btn" id="btn-fit-archipelago" type="button">🗺️ Fit All Islands</button>
            <button class="map-btn" id="btn-cycle-basemap" type="button">🌑 Style: Dark Matter</button>
            <button class="map-btn active" id="btn-toggle-flights" type="button">✈️ Flight Arcs</button>
            <button class="map-btn gold" id="btn-play-tour" type="button">▶ Play 7-Hub Flyover</button>
          </div>
        </div>

        <div id="ph-interactive-map"></div>

        <div class="map-legend-footer">
          <div class="legend-items">
            <span class="legend-item"><i class="legend-swatch" style="background:#facc15;"></i> 5★ Flagship</span>
            <span class="legend-item"><i class="legend-swatch" style="background:#38bdf8;"></i> Somerset / Serviced</span>
            <span class="legend-item"><i class="legend-swatch" style="background:#c084fc;"></i> Luxury Airbnb</span>
            <span class="legend-item"><i class="legend-swatch" style="background:#14b8a6;"></i> 4★+ Boutique</span>
            <span class="legend-item"><i class="legend-swatch" style="background:#fb7185;"></i> Landmark</span>
          </div>
          <span style="font-family:var(--font-mono);">1 DKK ≈ 8.4 PHP · Tap any pin for booking links</span>
        </div>
      </div>

      <!-- Cebu Pacific & Island Transit Schematic + Cards -->
      <div class="flight-schematic-card" id="section-flights">
        <div class="section-header-row">
          <h2>
            <span>✈️ Cebu Pacific (5J / DG / T6) &amp; Island Transit Network</span>
          </h2>
          <a
            href="https://www.cebupacificair.com/en-PH/pages/plan/book-flights"
            target="_blank"
            rel="noopener noreferrer"
            class="cebpac-book-link"
          >
            Book on CebuPacificAir.com ↗
          </a>
        </div>

        <!-- Custom Philippine Flight Vector SVG Diagram -->
        <div class="svg-flight-banner">
          <svg viewBox="0 0 860 135" width="100%" height="135" xmlns="http://www.w3.org/2000/svg">
            <line x1="20" y1="95" x2="840" y2="95" stroke="rgba(56,189,248,0.2)" stroke-width="1" />
            <path d="M 55 95 Q 115 35 175 95" fill="none" stroke="#38bdf8" stroke-width="2" class="flight-arc-line" />
            <path d="M 175 95 Q 245 20 315 95" fill="none" stroke="#facc15" stroke-width="2.5" class="flight-arc-line" />
            <path d="M 315 95 Q 385 35 455 95" fill="none" stroke="#14b8a6" stroke-width="2" class="flight-arc-line" />
            <path d="M 455 95 Q 525 18 595 95" fill="none" stroke="#facc15" stroke-width="2.5" class="flight-arc-line" />
            <path d="M 595 95 Q 665 40 735 95" fill="none" stroke="#38bdf8" stroke-width="2" class="flight-arc-line" />
            <path d="M 735 95 Q 775 20 815 95" fill="none" stroke="#facc15" stroke-width="2.5" class="flight-arc-line" />

            <g transform="translate(55,95)">
              <circle r="7" fill="#006972" stroke="#facc15" stroke-width="2" />
              <text y="-14" text-anchor="middle" fill="#facc15" font-family="JetBrains Mono" font-size="10" font-weight="700">MNL T3</text>
