  </nav>

  <!-- Client-side Interactive Controller -->
  <script is:inline define:vars={{ hubsData: DESTINATION_HUBS, flightsData: FLIGHT_ROUTES, totalPackCount: totalPackingItems, cartoKey: cartoApiKey, rcVenuesData: RC_CAR_VENUES, museumsData: TOP_MUSEUMS }}>
    document.addEventListener('DOMContentLoaded', () => {
      // 1. Initialize Leaflet Map with Watermark-Free Multi-Basemap Engine
      const mapEl = document.getElementById('ph-interactive-map');
      const map = L.map('ph-interactive-map', {
        center: [12.35, 121.65],
        zoom: 6,
        zoomControl: true,
        scrollWheelZoom: false
      });

      const keyQuery = cartoKey ? `?key=${encodeURIComponent(cartoKey.trim())}` : '';
      const basemapStyles = [
        {
          id: 'osm-dark',
          label: '🌑 Dark Map',
          darkFilter: true,
          url: 'https://tile.openstreetmap.org/{z}/{x}/{y}.png',
          attribution: '&copy; OpenStreetMap | MC Travel OS'
        },
        {
          id: 'osm-light',
          label: '☀️ Nordic Map',
          darkFilter: false,
          url: 'https://tile.openstreetmap.org/{z}/{x}/{y}.png',
          attribution: '&copy; OpenStreetMap | MC Travel OS'
        },
        {
          id: 'esri-satellite',
          label: '🛰️ Satellite',
          darkFilter: false,
          url: 'https://server.arcgisonline.com/ArcGIS/rest/services/World_Imagery/MapServer/tile/{z}/{y}/{x}',
          attribution: '&copy; Esri | MC Travel OS'
        },
        {
          id: 'carto-voyager',
          label: '🗺️ CARTO',
          darkFilter: false,
          url: `https://{s}.basemaps.cartocdn.com/rastertiles/voyager/{z}/{x}/{y}{r}.png${keyQuery}`,
          attribution: '&copy; OpenStreetMap &copy; CARTO'
        }
      ];
      let currentStyleIdx = 0;

      function applyBasemapStyle(idx) {
        const style = basemapStyles[idx];
        mapEl?.classList.toggle('map-filter-dark', Boolean(style.darkFilter));
        return L.tileLayer(style.url, {
          attribution: style.attribution,
          subdomains: 'abcd',
          maxZoom: 19
        });
      }

      let activeTileLayer = applyBasemapStyle(0).addTo(map);
      const styleBtn = document.getElementById('btn-cycle-basemap');

      function setMapStyleByIndex(idx) {
        currentStyleIdx = idx % basemapStyles.length;
        map.removeLayer(activeTileLayer);
        activeTileLayer = applyBasemapStyle(currentStyleIdx).addTo(map);
        if (styleBtn) styleBtn.textContent = basemapStyles[currentStyleIdx].label;
      }

      styleBtn?.addEventListener('click', () => {
        setMapStyleByIndex(currentStyleIdx + 1);
      });

      // Theme Toggle: BMW M Carbon Dark <-> Nordic Alpine Daylight
      const themeBtn = document.getElementById('btn-theme-toggle');
      const themeLabel = document.getElementById('theme-toggle-label');
      let isNordicLight = localStorage.getItem('kapuluan_theme') === 'nordic-light';

      function syncThemeUI() {
        document.body.classList.toggle('theme-nordic-light', isNordicLight);
        if (themeLabel) {
          themeLabel.textContent = isNordicLight ? '🌑 ///M Carbon' : '☀️ Nordic Light';
        }
        setMapStyleByIndex(isNordicLight ? 1 : 0);
      }
      if (isNordicLight) syncThemeUI();

      themeBtn?.addEventListener('click', () => {
        isNordicLight = !isNordicLight;
        localStorage.setItem('kapuluan_theme', isNordicLight ? 'nordic-light' : 'm-carbon');
        syncThemeUI();
      });

      // BMW M Drive Mode Switcher (Stays / ///M Auto & Roadtrip / 32-Day Log / Flights / Packing / All)
      function activateDriveMode(modeKey) {
        document.querySelectorAll('.m-mode-btn').forEach((btn) => {
          btn.classList.toggle('active', btn.getAttribute('data-drive-mode') === modeKey);
        });
        document.querySelectorAll('.dock-btn').forEach((btn) => {
          btn.classList.toggle('active', btn.getAttribute('data-mobile-mode') === modeKey);
        });
        document.querySelectorAll('.deck-mode-section').forEach((sec) => {
          const panelKey = sec.getAttribute('data-mode-panel');
          sec.classList.toggle('mode-active', modeKey === 'all' || panelKey === modeKey);
        });
        setTimeout(() => map.invalidateSize(), 150);
      }

      document.querySelectorAll('.m-mode-btn').forEach((btn) => {
        btn.addEventListener('click', () => {
          const modeKey = btn.getAttribute('data-drive-mode') || 'stays';
          activateDriveMode(modeKey);
        });
      });

      document.querySelectorAll('.dock-btn').forEach((btn) => {
        btn.addEventListener('click', () => {
          const modeKey = btn.getAttribute('data-mobile-mode');
          if (modeKey) {
            activateDriveMode(modeKey);
            document.getElementById('right-deck')?.scrollIntoView({ behavior: 'smooth' });
          }
        });
      });

      document.getElementById('dock-btn-map')?.addEventListener('click', () => {
        document.getElementById('section-map')?.scrollIntoView({ behavior: 'smooth', block: 'start' });
      });

      // Mobile Map Expand / Compact Toggle
      const toggleExpandBtn = document.getElementById('btn-toggle-map-expand');
      toggleExpandBtn?.addEventListener('click', () => {
        const isExpanded = mapEl?.classList.toggle('map-expanded');
        if (toggleExpandBtn) {
          toggleExpandBtn.textContent = isExpanded ? '⤢ Compact' : '⛶ Expand';
          toggleExpandBtn.classList.toggle('active', Boolean(isExpanded));
        }
        setTimeout(() => map.invalidateSize(), 320);
      });

      const hotelMarkersLayer = L.layerGroup().addTo(map);
      const landmarkMarkersLayer = L.layerGroup().addTo(map);
      const flightArcsLayer = L.layerGroup().addTo(map);
      const roadtripLayer = L.layerGroup().addTo(map);

      const hotelMarkersByCoord = {};

      function getCurvedPoints(start, end, offsetCurve = 0.22) {
        const lat1 = start[0], lng1 = start[1];
        const lat2 = end[0], lng2 = end[1];
        const midLat = (lat1 + lat2) / 2 + (lng2 - lng1) * offsetCurve;
        const midLng = (lng1 + lng2) / 2 - (lat2 - lat1) * offsetCurve;
        const pts = [];
        for (let t = 0; t <= 1; t += 0.04) {
          const lat = (1 - t) * (1 - t) * lat1 + 2 * (1 - t) * t * midLat + t * t * lat2;
          const lng = (1 - t) * (1 - t) * lng1 + 2 * (1 - t) * t * midLng + t * t * lng2;
          pts.push([lat, lng]);
        }
        return pts;
      }

      // Render Flight Route Polylines in M-Sport Colors
      flightsData.forEach((fl) => {
        const curvePts = getCurvedPoints(fl.fromCoords, fl.toCoords, 0.18);
        const color = fl.mode === 'cebu-pacific' || fl.mode === 'airswift-cebpac'
          ? '#2E9AFE'
          : (fl.mode === 'paraw-sail' ? '#10B981' : '#E30613');

        const poly = L.polyline(curvePts, {
          color,
          weight: 2.5,
          opacity: 0.85,
          dashArray: '7, 5'
        }).addTo(flightArcsLayer);

        poly.bindPopup(`
          <div style="font-family:'Plus Jakarta Sans',sans-serif;min-width:210px;">
            <div style="font-family:'JetBrains Mono',monospace;font-size:11px;font-weight:700;color:#2E9AFE;">
              ${fl.code} · ~${fl.fareDkk} DKK
            </div>
            <div style="font-weight:700;margin:3px 0;">${fl.carrier} (${fl.flightNo})</div>
            <div style="font-size:11px;color:#cbd5e1;margin-bottom:6px;">${fl.notes}</div>
            <a href="${fl.bookingUrl}" target="_blank" rel="noopener" style="display:inline-block;padding:4px 9px;background:#0066B1;color:#fff;font-weight:700;font-size:11px;border-radius:5px;text-decoration:none;">
              Book Flight / Ferry ↗
            </a>
          </div>
        `);
      });

      // Render Cebu -> Bohol -> Siquijor 4x4 Roadtrip Driving Polylines
      const cebuTranscentralCoords = [
        [10.3075, 123.9794], // CEB Airport
        [10.3418, 123.8962], // Nivel Hills / Marco Polo
        [10.3712, 123.8708], // Tops Lookout / Busay
        [10.4425, 123.7750], // Balamban Twisties
        [10.2785, 123.8965], // CCLEX Sea Bridge
        [10.2929, 123.9090]  // Cebu Pier 1
      ];
      const boholRoadtripCoords = [
        [9.9518, 123.9622],  // Tubigon RORO Port
        [9.8297, 124.1397],  // Carmen Chocolate Hills
        [9.6872, 124.0815],  // Bilar Man-Made Mahogany Forest
        [9.6365, 124.0310],  // Loboc River
        [9.6496, 123.8554],  // Tagbilaran Port
        [9.5488, 123.7772]   // Panglao Island
      ];
      const siquijorRingCoords = [
        [9.2145, 123.5135],  // Siquijor Port
        [9.1468, 123.5112],  // San Juan Sunset Coast
        [9.1412, 123.6265],  // Lazi & Cambugahay Falls
        [9.2120, 123.6810],  // Salagdoong Cliff Coast
        [9.2145, 123.5135]   // Complete 72km Loop
      ];

      L.polyline(cebuTranscentralCoords, { color: '#FF2836', weight: 3.5, opacity: 0.9 }).addTo(roadtripLayer)
        .bindPopup('<strong>🛣️ Cebu Roadtrip Loop:</strong> CEB → Transcentral Highway (Busay–Balamban Twisties) → CCLEX Bridge → Pier 1');
      L.polyline(boholRoadtripCoords, { color: '#FF2836', weight: 3.5, opacity: 0.9 }).addTo(roadtripLayer)
        .bindPopup('<strong>🛣️ Bohol 4x4 Roadtrip:</strong> Tubigon/Tagbilaran → Loboc → 2km Bilar Mahogany Forest → Chocolate Hills → Panglao');
      L.polyline(siquijorRingCoords, { color: '#10B981', weight: 3, opacity: 0.88 }).addTo(roadtripLayer)
        .bindPopup('<strong>🛣️ Siquijor 72km Coastal Ring Road:</strong> Zero-traffic full island coastal drive');

      // Render Landmarks & All Hotel Pins
      hubsData.forEach((hub) => {
        hub.primaryLandmarks.forEach((lm) => {
          const lmIcon = L.divIcon({
            className: 'custom-pin-marker',
            html: `<div style="width:22px;height:22px;border-radius:50%;background:#E30613;color:#fff;display:grid;place-items:center;font-size:11px;border:1.5px solid #fff;box-shadow:0 0 8px #E30613;">🎯</div>`,
            iconSize: [22, 22],
            iconAnchor: [11, 11]
          });
          const m = L.marker([lm.lat, lm.lng], { icon: lmIcon }).addTo(landmarkMarkersLayer);
          m.bindPopup(`
            <div style="font-family:'Plus Jakarta Sans',sans-serif;">
              <div style="font-size:10px;font-family:'JetBrains Mono',monospace;color:#FF2836;font-weight:700;">///M LANDMARK · ${hub.name}</div>
              <div style="font-size:13px;font-weight:700;margin:2px 0;">${lm.name}</div>
              <div style="font-size:11px;color:#94a3b8;">${lm.category} · ${lm.openHours}</div>
            </div>
          `);
        });

      // Render Premier RC Car Tracks & Drift Arenas
      if (Array.isArray(rcVenuesData)) {
        rcVenuesData.forEach((rc) => {
          const rcIcon = L.divIcon({
            className: 'custom-pin-marker',
            html: `<div style="width:24px;height:24px;border-radius:50%;background:#0066B1;color:#fff;display:grid;place-items:center;font-size:12px;border:1.5px solid #2E9AFE;box-shadow:0 0 9px rgba(46,154,254,0.85);" title="${rc.name}">🏎️</div>`,
            iconSize: [24, 24],
            iconAnchor: [12, 12]
          });
          const m = L.marker([rc.lat, rc.lng], { icon: rcIcon }).addTo(landmarkMarkersLayer);
          m.bindPopup(`
            <div style="font-family:'Plus Jakarta Sans',sans-serif;min-width:210px;">
              <div style="font-size:10px;font-family:'JetBrains Mono',monospace;color:#2E9AFE;font-weight:700;">🏎️ RC TRACK · ${rc.city.toUpperCase()}</div>
              <div style="font-size:12px;font-weight:800;margin:2px 0;">${rc.name}</div>
              <div style="font-size:11px;color:#94a3b8;margin-bottom:3px;">${rc.trackType}</div>
              <div style="font-size:11px;color:#cbd5e1;line-height:1.35;margin-bottom:4px;">${rc.highlight}</div>
              <div style="font-size:10px;font-family:'JetBrains Mono',monospace;color:#94a3b8;">🕒 ${rc.openHours}</div>
              <div style="font-size:10px;color:#10B981;margin-top:2px;">💡 ${rc.tip}</div>
            </div>
          `);
        });
      }

      // Render Curated City Museums & Cultural Heritage on Map
      if (Array.isArray(museumsData)) {
        museumsData.forEach((mus) => {
          const musIcon = L.divIcon({
            className: 'custom-pin-marker',
            html: `<div style="width:24px;height:24px;border-radius:50%;background:#4F46E5;color:#fff;display:grid;place-items:center;font-size:12px;border:1.5px solid #A5B4FC;box-shadow:0 0 9px rgba(99,102,241,0.85);" title="${mus.name}">🏛️</div>`,
            iconSize: [24, 24],
            iconAnchor: [12, 12]
          });
          const m = L.marker([mus.lat, mus.lng], { icon: musIcon }).addTo(landmarkMarkersLayer);
          m.bindPopup(`
            <div style="font-family:'Plus Jakarta Sans',sans-serif;min-width:220px;">
              <div style="font-size:10px;font-family:'JetBrains Mono',monospace;color:#818CF8;font-weight:700;">🏛️ MUSEUM · ${mus.city.toUpperCase()}</div>
              <div style="font-size:12px;font-weight:800;margin:2px 0;">${mus.name}</div>
              <div style="font-size:10px;font-family:'JetBrains Mono',monospace;color:#F59E0B;margin-bottom:3px;">${mus.badge}</div>
              <div style="font-size:11px;color:#cbd5e1;line-height:1.35;margin-bottom:4px;">${mus.highlight}</div>
              <div style="font-size:10px;color:#94a3b8;margin-bottom:3px;">✨ <strong>Key Exhibit:</strong> ${mus.keyExhibit}</div>
              <div style="display:flex;justify-content:space-between;align-items:center;margin-top:4px;font-size:10px;font-family:'JetBrains Mono',monospace;">
                <span style="color:#94a3b8;">🕒 ${mus.openHours}</span>
                <span style="color:#10B981;font-weight:700;">${mus.admission}</span>
              </div>
              <div style="font-size:10px;color:#10B981;margin-top:3px;">💡 ${mus.tip}</div>
            </div>
          `);
        });
      }

        hub.hotels.forEach((hotel) => {
          const isFiveStar = hotel.stars.includes('5★');
          const bgColor = hotel.tier === 'Luxury Airbnb'
            ? '#10B981'
            : (hotel.tier === '4-Star Serviced' ? '#6366F1' : (isFiveStar ? '#0066B1' : '#0284C7'));
          const icon = L.divIcon({
            className: 'custom-pin-marker',
            html: `<div style="width:24px;height:24px;border-radius:6px;background:${bgColor};color:#fff;display:grid;place-items:center;font-weight:800;font-size:10px;border:1.5px solid #fff;">H${hotel.rank}</div>`,
            iconSize: [24, 24],
            iconAnchor: [12, 12]
          });

          const marker = L.marker([hotel.lat, hotel.lng], { icon }).addTo(hotelMarkersLayer);
          marker.bindPopup(`
            <div style="font-family:'Plus Jakarta Sans',sans-serif;min-width:220px;">
              <div style="font-family:'JetBrains Mono',monospace;font-size:10px;color:#2E9AFE;font-weight:700;">
                ${hub.name} · #${hotel.rank} (${hotel.tier})
              </div>
              <div style="font-size:14px;font-weight:700;margin:3px 0;color:#fff;">${hotel.name}</div>
              <div style="font-family:'JetBrains Mono',monospace;font-size:12px;color:#10B981;font-weight:700;margin-bottom:5px;">
                ${hotel.rateDkk.toLocaleString()} DKK / night (${(hotel.rateDkk * hub.nights).toLocaleString()} DKK for ${hub.nights}N)
              </div>
              <div style="font-size:11px;color:#cbd5e1;margin-bottom:4px;">
                <strong>📍 ${hotel.distance}:</strong> ${hotel.landmark}
              </div>
              <div style="font-size:11px;color:#94a3b8;margin-bottom:8px;">${hotel.highlight}</div>
              <a href="${hotel.url}" target="_blank" rel="noopener" style="display:inline-block;padding:4px 10px;background:#0066B1;color:#fff;font-weight:700;font-size:11px;border-radius:5px;text-decoration:none;">
                Hotels.com Points ↗
              </a>
            </div>
          `);

          hotelMarkersByCoord[`${hotel.lat},${hotel.lng}`] = marker;
        });
      });

      // 2. Hub Activation
      function activateHub(hubId, flyMap = true) {
        const hub = hubsData.find((h) => h.id === hubId);
        if (!hub) return;

        document.querySelectorAll('.hub-selector').forEach((btn) => {
          btn.classList.toggle('active', btn.getAttribute('data-hub-id') === hubId);
        });
        document.getElementById('btn-overview-all')?.classList.remove('active');

        const activeTab = document.querySelector(`.hub-selector[data-hub-id="${hubId}"]`);
        if (activeTab) {
          activeTab.scrollIntoView({ behavior: 'smooth', block: 'nearest', inline: 'center' });
        }

        document.querySelectorAll('.hub-spotlight-panel').forEach((panel) => {
          panel.classList.toggle('active', panel.getAttribute('data-hub-panel') === hubId);
        });

        const statusLabel = document.getElementById('map-status-label');
        if (statusLabel) {
          statusLabel.textContent = `Hub ${hub.number}: ${hub.name} (${hub.hotels.length} Stays)`;
        }

        if (flyMap) {
          map.flyTo(hub.center, hub.zoom, { duration: 1.15 });
        }
      }

      document.querySelectorAll('.hub-selector').forEach((btn) => {
        btn.addEventListener('click', () => {
          const hubId = btn.getAttribute('data-hub-id');
          if (hubId) {
            activateDriveMode('stays');
            activateHub(hubId, true);
          }
        });
      });

      const fitArchipelago = () => {
        map.flyTo([12.25, 121.5], 6, { duration: 1.1 });
        const statusLabel = document.getElementById('map-status-label');
        if (statusLabel) {
          statusLabel.textContent = 'Full Philippine Archipelago · 7 Hubs & ///M Roadtrip Telemetry';
        }
      };

      document.getElementById('btn-overview-all')?.addEventListener('click', fitArchipelago);
      document.getElementById('btn-fit-archipelago')?.addEventListener('click', fitArchipelago);

      // Zoom directly to Cebu -> Bohol -> Siquijor Roadtrip Corridor
      const zoomCebuBoholRoadtrip = () => {
        activateDriveMode('msport');
        if (window.innerWidth <= 1180) {
          document.getElementById('section-map')?.scrollIntoView({ behavior: 'smooth', block: 'start' });
        }
        map.flyToBounds([[9.08, 123.45], [10.48, 124.22]], { padding: [30, 30], duration: 1.2 });
        const statusLabel = document.getElementById('map-status-label');
        if (statusLabel) {
          statusLabel.textContent = '🛣️ Cebu Transcentral Hwy → Bohol Mahogany Forest & Chocolate Hills → Siquijor 72km Ring';
        }
      };

      document.getElementById('btn-roadtrip-zoom')?.addEventListener('click', zoomCebuBoholRoadtrip);
      document.querySelectorAll('.roadtrip-focus-card').forEach((card) => {
        card.addEventListener('click', zoomCebuBoholRoadtrip);
      });

      let flightsVisible = true;
      document.getElementById('btn-toggle-flights')?.addEventListener('click', (e) => {
        flightsVisible = !flightsVisible;
        if (flightsVisible) {
          flightArcsLayer.addTo(map);
          e.currentTarget.classList.add('active');
        } else {
          map.removeLayer(flightArcsLayer);
          e.currentTarget.classList.remove('active');
        }
      });

      document.querySelectorAll('.locate-pin-btn').forEach((btn) => {
        btn.addEventListener('click', () => {
          const lat = parseFloat(btn.getAttribute('data-lat'));
          const lng = parseFloat(btn.getAttribute('data-lng'));
          if (window.innerWidth <= 1180) {
            document.getElementById('section-map')?.scrollIntoView({ behavior: 'smooth', block: 'start' });
          }
          map.flyTo([lat, lng], 16, { duration: 1.0 });
          const marker = hotelMarkersByCoord[`${lat},${lng}`];
          if (marker) {
            setTimeout(() => marker.openPopup(), 550);
          }
        });
      });

      document.querySelectorAll('.landmark-chip').forEach((chip) => {
        chip.addEventListener('click', () => {
          const lat = parseFloat(chip.getAttribute('data-lat'));
          const lng = parseFloat(chip.getAttribute('data-lng'));
          if (!isNaN(lat) && !isNaN(lng)) {
            if (window.innerWidth <= 1180) {
              document.getElementById('section-map')?.scrollIntoView({ behavior: 'smooth', block: 'start' });
            }
            map.flyTo([lat, lng], 15, { duration: 1.0 });
          }
        });
      });

      document.querySelectorAll('[data-guide-hub]').forEach((btn) => {
        btn.addEventListener('click', () => {
          const hubId = btn.getAttribute('data-guide-hub');
          if (hubId) {
            activateDriveMode('stays');
            activateHub(hubId, true);
            if (window.innerWidth <= 1180) {
              document.getElementById('section-map')?.scrollIntoView({ behavior: 'smooth', block: 'start' });
            }
          }
        });
      });

      document.querySelectorAll('.flight-leg-card').forEach((card) => {
        card.addEventListener('click', () => {
          const lat1 = parseFloat(card.getAttribute('data-from-lat'));
          const lng1 = parseFloat(card.getAttribute('data-from-lng'));
          const lat2 = parseFloat(card.getAttribute('data-to-lat'));
          const lng2 = parseFloat(card.getAttribute('data-to-lng'));
          if (window.innerWidth <= 1180) {
            document.getElementById('section-map')?.scrollIntoView({ behavior: 'smooth', block: 'start' });
          }
          map.flyToBounds([[lat1, lng1], [lat2, lng2]], { padding: [45, 45], duration: 1.1 });
        });
      });

      // 3. Guided 7-Hub Flyover Tour
      let tourTimer = null;
      let tourIdx = 0;
      const playBtn = document.getElementById('btn-play-tour');
      playBtn?.addEventListener('click', () => {
        if (tourTimer) {
          clearInterval(tourTimer);
          tourTimer = null;
          playBtn.textContent = '▶ 7-Hub Flyover';
          return;
        }
        tourIdx = 0;
        playBtn.textContent = '⏹ Stop';
        activateHub(hubsData[tourIdx].id, true);
        tourTimer = setInterval(() => {
          tourIdx = (tourIdx + 1) % hubsData.length;
          activateHub(hubsData[tourIdx].id, true);
        }, 3600);
      });

      // 4. Live Currency Switcher (DKK / PHP / EUR)
      const rates = { DKK: 1, PHP: 8.4, EUR: 0.134 };
      let currentCurr = 'DKK';

      function formatCurrency(dkkVal, curr) {
        const converted = Math.round(dkkVal * rates[curr]);
        if (curr === 'PHP') return `₱${converted.toLocaleString()}`;
        if (curr === 'EUR') return `€${converted.toLocaleString()}`;
        return `${converted.toLocaleString()} DKK`;
      }

      document.querySelectorAll('.curr-btn').forEach((btn) => {
        btn.addEventListener('click', () => {
          currentCurr = btn.getAttribute('data-curr') || 'DKK';
          document.querySelectorAll('.curr-btn').forEach((b) => b.classList.remove('active'));
          btn.classList.add('active');

          document.querySelectorAll('.price-convertible').forEach((el) => {
            const dkk = parseFloat(el.getAttribute('data-dkk'));
            const suffix = el.getAttribute('data-suffix') || '';
            const prefix = suffix === '' ? '~' : '';
            el.textContent = `${prefix}${formatCurrency(dkk, currentCurr)}${suffix}`;
          });
          updateShortlistSummary();
        });
      });

      // 5. Interactive Hotel Shortlist & 25k-30k DKK Budget Presets
      const budgetPresets = {
        'target-somerset': {
          'makati-bgc': 7,     // Somerset Central Salcedo Makati (780 DKK/n × 8N = 6,240 DKK)
          'manila-bay': 3,     // Admiral Hotel Manila - MGallery (920 DKK/n × 2N = 1,840 DKK)
          'clark': 3,          // Hilton Clark Sun Valley Resort (950 DKK/n × 1N = 950 DKK)
          'coron': 1,          // Paolyn Houseboats Coron Island (1,340 DKK/n × 5N = 6,700 DKK)
          'el-nido': 6,        // Las Cabañas Beach Resort (1,050 DKK/n × 6N = 6,300 DKK)
          'cebu-mactan': 1,    // Fili Hotel at NUSTAR Cebu (890 DKK/n × 3N = 2,670 DKK)
          'bohol-siquijor': 4  // Coco Grove Beach Resort, Siquijor (890 DKK/n × 4N = 3,560 DKK) -> Total = 28,260 DKK
        },
        'target-citadines': {
          'makati-bgc': 6,     // Citadines Salcedo Makati (740 DKK/n × 8N = 5,920 DKK)
          'manila-bay': 3,     // Admiral Hotel Manila - MGallery (920 DKK/n × 2N = 1,840 DKK)
          'clark': 3,          // Hilton Clark Sun Valley Resort (950 DKK/n × 1N = 950 DKK)
          'coron': 4,          // The Funny Lion - Coron (890 DKK/n × 5N = 4,450 DKK)
          'el-nido': 7,        // Piece Lio (MICHELIN Guide · Lio Beach, 950 DKK/n × 6N = 5,700 DKK)
          'cebu-mactan': 1,    // Fili Hotel at NUSTAR Cebu (890 DKK/n × 3N = 2,670 DKK)
          'bohol-siquijor': 4  // Coco Grove Beach Resort, Siquijor (890 DKK/n × 4N = 3,560 DKK) -> Total = 25,090 DKK
        },
        'value-airbnb': {
          'makati-bgc': 4,     // Airbnb: Paseo Parkview Suites / The Ellis (490 DKK/n × 8N = 3,920 DKK)
          'manila-bay': 6,     // Airbnb: Shore 2/3 Luxury Bayfront Balcony Suite (390 DKK/n × 2N = 780 DKK)
          'clark': 5,          // Park Inn by Radisson Clark (680 DKK/n × 1N = 680 DKK)
          'coron': 5,          // Bacau Bay Resort Coron (760 DKK/n × 5N = 3,800 DKK)
          'el-nido': 9,        // Balai Adlao / Isla Amara (Lio Beach, 820 DKK/n × 6N = 4,920 DKK)
          'cebu-mactan': 3,    // Marco Polo Plaza Cebu (690 DKK/n × 3N = 2,070 DKK)
          'bohol-siquijor': 6  // White Villas Resort, Siquijor (650 DKK/n × 4N = 2,600 DKK) -> Total = 18,770 DKK
        },
        'flagship-51k': {
          'makati-bgc': 1,     // The Peninsula Manila (1,450 DKK/n × 8N = 11,600 DKK)
          'manila-bay': 1,     // The Manila Hotel (980 DKK/n × 2N = 1,960 DKK)
          'clark': 1,          // Clark Marriott Hotel (1,205 DKK/n × 1N = 1,205 DKK)
          'coron': 3,          // Club Paradise Palawan (1,650 DKK/n × 5N = 8,250 DKK)
          'el-nido': 1,        // Pangulasian Island Resort (3,350 DKK/n × 6N = 20,100 DKK)
          'cebu-mactan': 1,    // Fili Hotel at NUSTAR Cebu (890 DKK/n × 3N = 2,670 DKK)
          'bohol-siquijor': 1  // Amorita Resort, Panglao Bohol (1,320 DKK/n × 4N = 5,280 DKK) -> Total = 51,065 DKK
        }
      };

      const shortlistedByHub = JSON.parse(localStorage.getItem('kapuluan_shortlist_v3') || '{}');

      function applyPresetSelection(presetKey) {
        const presetMap = budgetPresets[presetKey] || budgetPresets['target-somerset'];
        hubsData.forEach((h) => {
          const targetRank = presetMap[h.id] || 1;
          const chosen = h.hotels.find((ht) => ht.rank === targetRank) || h.hotels[0];
          shortlistedByHub[h.id] = {
            name: chosen.name,
            rateDkk: chosen.rateDkk,
            nights: h.nights
          };
        });
        localStorage.setItem('kapuluan_shortlist_v3', JSON.stringify(shortlistedByHub));
        document.querySelectorAll('.preset-btn').forEach((b) => {
          b.classList.toggle('active', b.getAttribute('data-preset') === presetKey);
        });
        updateShortlistSummary();
      }

      if (Object.keys(shortlistedByHub).length === 0) {
        applyPresetSelection('target-somerset');
      }

      function updateShortlistSummary() {
        let totalDkk = 0;
        const breakdownGrid = document.getElementById('hub-breakdown-grid');
        if (breakdownGrid) breakdownGrid.innerHTML = '';

        hubsData.forEach((h) => {
          const item = shortlistedByHub[h.id] || {
            name: h.hotels[0].name,
            rateDkk: h.hotels[0].rateDkk,
            nights: h.nights
          };
          const subDkk = (item.rateDkk || 0) * (item.nights || 1);
          totalDkk += subDkk;

          if (breakdownGrid) {
            const div = document.createElement('div');
            div.className = 'hub-mini-summary';
            const shortName = item.name.split('(')[0].replace('Airbnb: ', '').replace('Hotel ', '').trim();
            div.innerHTML = `
              <div style="display:flex;justify-content:space-between;font-family:'JetBrains Mono',monospace;font-size:0.56rem;color:#2E9AFE;font-weight:700;">
                <span>H${h.number}</span>
                <span style="color:#10B981;">${formatCurrency(subDkk, currentCurr)}</span>
              </div>
              <div style="white-space:nowrap;overflow:hidden;text-overflow:ellipsis;font-weight:700;font-size:0.6rem;margin-top:2px;color:var(--text-secondary);" title="${item.name} (${h.nights}N)">
                ${shortName}
              </div>
            `;
            div.addEventListener('click', () => {
              activateDriveMode('stays');
              activateHub(h.id, true);
            });
            breakdownGrid.appendChild(div);
          }
        });

        // Render Shortlist Total Badge (Dynamic Live Stays vs Mid Benchmark)
        const badgeMode = localStorage.getItem('kapuluan_badge_mode') || 'dynamic';
        const MID_BENCHMARK_DKK = 28260; // Target Somerset mid-point

        const badge = document.getElementById('shortlist-total-badge');
        const labelText = document.getElementById('shortlist-label-text');
        const toggleBtn = document.getElementById('btn-toggle-badge-mode');
        const chipEl = document.getElementById('kpi-shortlist-chip');

        if (badge) {
          if (badgeMode === 'mid') {
            if (labelText) labelText.textContent = '29N Lodging · Mid Target';
            if (toggleBtn) {
              toggleBtn.textContent = '🎯 Mid (28k)';
              toggleBtn.className = 'badge-mini-toggle mid-mode';
            }
            badge.textContent = `${formatCurrency(MID_BENCHMARK_DKK, currentCurr)} (Mid)`;
            if (chipEl) chipEl.className = 'kpi-chip target-green';
          } else {
            // Dynamic mode
            let zoneTag = '🎯 Mid';
            let chipClass = 'kpi-chip target-green';
            if (totalDkk < 25000) {
              zoneTag = '💚 Value';
              chipClass = 'kpi-chip target-green';
            } else if (totalDkk > 30000) {
              zoneTag = '💎 Flagship';
              chipClass = 'kpi-chip target-red';
            }

            if (labelText) labelText.textContent = `29N Lodging · Dynamic (${zoneTag})`;
            if (toggleBtn) {
              toggleBtn.textContent = '⚡ Dynamic';
              toggleBtn.className = 'badge-mini-toggle';
            }
            badge.textContent = `${formatCurrency(totalDkk, currentCurr)} (29N)`;
            if (chipEl) chipEl.className = chipClass;
          }
        }

        const meterTotal = document.getElementById('meter-current-total');
        if (meterTotal) {
          meterTotal.textContent = `${formatCurrency(totalDkk, currentCurr)}`;
        }

        const fillEl = document.getElementById('budget-bar-fill');
        if (fillEl) {
          const pct = Math.min(100, Math.max(8, Math.round((totalDkk / 55000) * 100)));
          fillEl.style.width = `${pct}%`;
        }

        const statusPill = document.getElementById('budget-status-indicator');
        if (statusPill) {
          if (totalDkk >= 25000 && totalDkk <= 30000) {
            statusPill.className = 'budget-status-pill';
            statusPill.textContent = `🎯 Target Zone (${formatCurrency(totalDkk, currentCurr)})`;
          } else if (totalDkk < 25000) {
            statusPill.className = 'budget-status-pill';
            statusPill.textContent = `💚 Value Zone (${formatCurrency(totalDkk, currentCurr)})`;
          } else {
            statusPill.className = 'budget-status-pill over-target';
            const diff = totalDkk - 30000;
            statusPill.textContent = `///M +${formatCurrency(diff, currentCurr)} Above 30k`;
          }
        }

        document.querySelectorAll('.shortlist-btn').forEach((btn) => {
          const hubId = btn.getAttribute('data-hub-id');
          const hName = btn.getAttribute('data-hotel-name');
          const isSelected = shortlistedByHub[hubId] && shortlistedByHub[hubId].name === hName;
          btn.classList.toggle('active', Boolean(isSelected));
          btn.textContent = isSelected ? '★ Selected' : '⭐ Select';
          const card = btn.closest('.hotel-card');
          if (card) card.classList.toggle('selected-stay', Boolean(isSelected));
        });
      }

      document.querySelectorAll('.preset-btn').forEach((btn) => {
        btn.addEventListener('click', () => {
          const presetKey = btn.getAttribute('data-preset');
          if (presetKey) applyPresetSelection(presetKey);
        });
      });

      document.querySelectorAll('.shortlist-btn').forEach((btn) => {
        btn.addEventListener('click', () => {
          const hubId = btn.getAttribute('data-hub-id');
          const name = btn.getAttribute('data-hotel-name');
          const rateDkk = parseFloat(btn.getAttribute('data-rate-dkk'));
          const nights = parseInt(btn.getAttribute('data-nights'), 10);
          shortlistedByHub[hubId] = { name, rateDkk, nights };
          localStorage.setItem('kapuluan_shortlist_v3', JSON.stringify(shortlistedByHub));
          document.querySelectorAll('.preset-btn').forEach((b) => b.classList.remove('active'));
          updateShortlistSummary();
        });
      });

      // Toggle shortlist badge mode between Dynamic and Mid Target
      document.getElementById('btn-toggle-badge-mode')?.addEventListener('click', (e) => {
        e.stopPropagation();
        const currentMode = localStorage.getItem('kapuluan_badge_mode') || 'dynamic';
        const newMode = currentMode === 'dynamic' ? 'mid' : 'dynamic';
        localStorage.setItem('kapuluan_badge_mode', newMode);
        updateShortlistSummary();
      });

      document.getElementById('kpi-shortlist-chip')?.addEventListener('click', () => {
        activateDriveMode('stays');
        const opt = document.getElementById('budget-optimizer');
        if (opt) opt.scrollIntoView({ behavior: 'smooth', block: 'start' });
      });

      // Filter Hotel Cards & Map Pins
      document.querySelectorAll('.stay-filter-btn').forEach((btn) => {
        btn.addEventListener('click', () => {
          document.querySelectorAll('.stay-filter-btn').forEach((b) => b.classList.remove('active'));
          btn.classList.add('active');
          const mode = btn.getAttribute('data-stay-filter') || 'all';

          document.querySelectorAll('.hotel-card').forEach((card) => {
            const rate = parseFloat(card.getAttribute('data-rate-dkk') || '0');
            const tier = card.getAttribute('data-tier') || '';
            const band = card.getAttribute('data-budget-band') || '';
            const lat = card.getAttribute('data-lat');
            const lng = card.getAttribute('data-lng');
            const marker = hotelMarkersByCoord[`${lat},${lng}`];

            let show = true;
            if (mode === 'under-1100') {
              show = rate <= 1100;
            } else if (mode === 'serviced-airbnb') {
              show = tier === '4-Star Serviced' || tier === 'Luxury Airbnb';
            } else if (mode === 'value-under-750') {
              show = rate <= 750;
            } else if (mode === 'flagship') {
              show = band === 'flagship' || tier === '5-Star Flagship';
            }

            card.classList.toggle('filtered-out', !show);
            if (marker) {
              if (show) {
                if (!hotelMarkersLayer.hasLayer(marker)) hotelMarkersLayer.addLayer(marker);
              } else {
                if (hotelMarkersLayer.hasLayer(marker)) hotelMarkersLayer.removeLayer(marker);
              }
            }
          });
        });
      });

      updateShortlistSummary();

      // 6. 32-Day Itinerary Filter & Row Click
      document.querySelectorAll('.filter-pill').forEach((pill) => {
        pill.addEventListener('click', () => {
          document.querySelectorAll('.filter-pill').forEach((p) => p.classList.remove('active'));
          pill.classList.add('active');
          const filterHub = pill.getAttribute('data-day-filter');
          document.querySelectorAll('#itinerary-tbody tr.day-row').forEach((row) => {
            const rowHub = row.getAttribute('data-hub-id');
            row.style.display = (filterHub === 'all' || rowHub === filterHub) ? '' : 'none';
          });
          if (filterHub && filterHub !== 'all') {
            activateHub(filterHub, true);
          }
        });
      });

      document.querySelectorAll('#itinerary-tbody tr.day-row').forEach((row) => {
        row.addEventListener('click', () => {
          const hubId = row.getAttribute('data-hub-id');
          const lat = parseFloat(row.getAttribute('data-lat'));
          const lng = parseFloat(row.getAttribute('data-lng'));
          const title = row.getAttribute('data-day-title');
          const desc = row.getAttribute('data-day-desc');
          if (hubId) activateHub(hubId, false);
          if (window.innerWidth <= 1180) {
            document.getElementById('section-map')?.scrollIntoView({ behavior: 'smooth', block: 'start' });
          }
          map.flyTo([lat, lng], 14, { duration: 1.05 });
          L.popup()
            .setLatLng([lat, lng])
            .setContent(`
              <div style="font-family:'Plus Jakarta Sans',sans-serif;max-width:230px;">
                <div style="font-family:'JetBrains Mono',monospace;font-size:10px;color:#2E9AFE;font-weight:700;">${title}</div>
                <div style="font-size:11px;margin-top:3px;color:#e2e8f0;">${desc}</div>
              </div>
            `)
            .openOn(map);
        });
      });

      // 7. Persistent Packing Checklist
      const savedPack = JSON.parse(localStorage.getItem('kapuluan_packing') || '{}');
      function updatePackingProgress() {
        let count = 0;
        document.querySelectorAll('.pack-checkbox').forEach((cb) => {
          const id = cb.getAttribute('data-pack-id');
          const checked = Boolean(savedPack[id]);
          cb.checked = checked;
          if (checked) count++;
          cb.closest('.pack-item-label')?.classList.toggle('checked', checked);
        });
        const progEl = document.getElementById('pack-progress-text');
        if (progEl) progEl.textContent = `${count} / ${totalPackCount} packed`;

        const topBadge = document.getElementById('top-checklist-badge');
        if (topBadge) topBadge.textContent = `${count}/${totalPackCount}`;

        const homeProg = document.getElementById('home-checklist-progress');
        if (homeProg) homeProg.textContent = `${count} / ${totalPackCount} Packed`;

        const tabBadge = document.getElementById('home-checklist-tab-badge');
        if (tabBadge) tabBadge.textContent = `${count}/${totalPackCount}`;

        const homeBar = document.getElementById('home-checklist-bar-fill');
        if (homeBar) homeBar.style.width = `${Math.round((count / totalPackCount) * 100)}%`;
      }

      // Home Widget Subtabs (Checklist vs Essential Apps)
      const subtabChecklistBtn = document.getElementById('subtab-btn-checklist');
      const subtabAppsBtn = document.getElementById('subtab-btn-apps');
      const subtabChecklistContent = document.getElementById('home-subtab-content-checklist');
      const subtabAppsContent = document.getElementById('home-subtab-content-apps');

      if (subtabChecklistBtn && subtabAppsBtn) {
        subtabChecklistBtn.addEventListener('click', () => {
          subtabChecklistBtn.classList.add('active');
          subtabAppsBtn.classList.remove('active');
          if (subtabChecklistContent) subtabChecklistContent.style.display = 'block';
          if (subtabAppsContent) subtabAppsContent.style.display = 'none';
        });

        subtabAppsBtn.addEventListener('click', () => {
          subtabAppsBtn.classList.add('active');
          subtabChecklistBtn.classList.remove('active');
          if (subtabAppsContent) subtabAppsContent.style.display = 'block';
          if (subtabChecklistContent) subtabChecklistContent.style.display = 'none';
        });
      }

      document.querySelectorAll('.pack-checkbox').forEach((cb) => {
        cb.addEventListener('change', () => {
          const id = cb.getAttribute('data-pack-id');
          savedPack[id] = cb.checked;
          localStorage.setItem('kapuluan_packing', JSON.stringify(savedPack));
          updatePackingProgress();
        });
      });

      // Quick launcher buttons for checklist
      const jumpToFullChecklist = () => {
        activateDriveMode('packing');
        const packingEl = document.getElementById('mode-panel-packing');
        if (packingEl) {
          packingEl.scrollIntoView({ behavior: 'smooth', block: 'start' });
        }
      };

      document.getElementById('btn-top-checklist')?.addEventListener('click', jumpToFullChecklist);
      document.getElementById('btn-jump-full-checklist')?.addEventListener('click', jumpToFullChecklist);

      document.getElementById('btn-reset-packing')?.addEventListener('click', () => {
        Object.keys(savedPack).forEach((k) => delete savedPack[k]);
        localStorage.removeItem('kapuluan_packing');
        updatePackingProgress();
      });

      updatePackingProgress();

      // Check URL query parameters (e.g. ?hub=el-nido)
      const urlParams = new URLSearchParams(window.location.search);
      const queryHub = urlParams.get('hub');
      if (queryHub && hubsData.some((h) => h.id === queryHub)) {
        activateDriveMode('stays');
        activateHub(queryHub, true);
      }
    });
  </script>
</body>
</html>
