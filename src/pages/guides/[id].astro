      transform: translateY(-1px);
    }

    /* 02: Automotive Bento */
    .events-bento {
      display: grid;
      grid-template-columns: repeat(auto-fit, minmax(360px, 1fr));
      gap: 1.5rem;
    }

    .event-card {
      background: var(--bg-card);
      border: 1px solid rgba(227, 6, 19, 0.25);
      border-radius: var(--radius-card);
