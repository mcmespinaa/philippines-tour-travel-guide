---
import { DESTINATION_GUIDES, DESTINATION_HUBS } from '../../data/tourData';

export async function getStaticPaths() {
  return DESTINATION_GUIDES.map((guide, idx) => {
    const prevGuide = idx > 0 ? DESTINATION_GUIDES[idx - 1] : DESTINATION_GUIDES[DESTINATION_GUIDES.length - 1];
    const nextGuide = idx < DESTINATION_GUIDES.length - 1 ? DESTINATION_GUIDES[idx + 1] : DESTINATION_GUIDES[0];
    const hubInfo = DESTINATION_HUBS.find((h) => h.id === guide.id);
    return {
      params: { id: guide.id },
      props: { guide, prevGuide, nextGuide, hubInfo }
    };
  });
}

const { guide, prevGuide, nextGuide, hubInfo } = Astro.props;

function resolveAsset(url: string | undefined): string {
  if (!url) return '';
  if (url.startsWith('http')) return url;
  if (url.startsWith('./')) return '../../' + url.slice(2);
  if (url.startsWith('/')) return '../..' + url;
  return '../../' + url;
}

function getDirectionsUrl(title: string, location?: string, coords?: [number, number]): string {
  if (coords && coords[0] && coords[1]) {
    return `https://www.google.com/maps/dir/?api=1&destination=${coords[0]},${coords[1]}`;
  }
  const query = location ? `${title}, ${location}, Philippines` : `${title}, Philippines`;
  return `https://www.google.com/maps/dir/?api=1&destination=${encodeURIComponent(query)}`;
}

const heroImgSrc = resolveAsset(guide.heroImage);
const hubCenterCoords = hubInfo?.center || [14.5567, 121.0245];
const hubDirectionsUrl = `https://www.google.com/maps/dir/?api=1&destination=${hubCenterCoords[0]},${hubCenterCoords[1]}`;
