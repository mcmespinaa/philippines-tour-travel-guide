    .dining-area {
      font-size: 0.76rem;
      color: var(--text-muted);
      font-family: var(--font-mono);
      margin-bottom: 0.75rem;
    }

    .dining-order-box {
      background: var(--bg-elevated);
      padding: 0.65rem 0.85rem;
      border-radius: var(--radius-sm);
      margin-bottom: 0.65rem;
      font-size: 0.84rem;
      color: var(--text-primary);
      line-height: 1.45;
    }

    .dining-vibe {
      font-size: 0.82rem;
      color: var(--text-secondary);
      font-style: italic;
      line-height: 1.45;
      margin-bottom: 0.95rem;
    }

    .dining-action-row {
      margin-top: auto;
      padding-top: 0.75rem;
      border-top: 1px solid var(--border-hairline);
    }

    /* 04: Practical Logistics */
    .logistics-grid {
      display: grid;
      grid-template-columns: repeat(auto-fit, minmax(260px, 1fr));
      gap: 1.35rem;
    }

    .logistics-box {
      background: var(--bg-card);
      border: 1px solid var(--border-hairline);
      border-radius: var(--radius-card);
      padding: 1.4rem;
      box-shadow: var(--shadow-airbnb);
    }
    .logistics-title {
      font-family: var(--font-mono);
      font-size: 0.78rem;
      font-weight: 800;
      color: var(--m-Sky-glow);
      text-transform: uppercase;
      letter-spacing: 0.06em;
      margin-bottom: 0.6rem;
      display: flex;
      align-items: center;
      gap: 0.4rem;
    }
    .logistics-content {
      font-size: 0.88rem;
      color: var(--text-secondary);
      line-height: 1.6;
    }

    /* Footer Pagination */
    .guide-pagination {
      display: grid;
      grid-template-columns: 1fr auto 1fr;
      align-items: center;
      gap: 1.25rem;
      margin-top: 4rem;
      padding-top: 2rem;
      border-top: 1px solid var(--border-hairline);
    }

    .page-link {
      display: flex;
      flex-direction: column;
      gap: 0.25rem;
      text-decoration: none;
      color: var(--text-primary);
      background: var(--bg-card);
      padding: 1rem 1.4rem;
      border-radius: var(--radius-card);
      border: 1px solid var(--border-hairline);
      box-shadow: var(--shadow-airbnb);
      transition: all 0.2s ease;
    }
    .page-link:hover {
      border-color: var(--m-Sky-glow);
      transform: translateY(-2px);
    }
    .page-link .dir {
      font-family: var(--font-mono);
      font-size: 0.72rem;
      color: var(--text-muted);
      text-transform: uppercase;
      letter-spacing: 0.05em;
    }
    .page-link .target-title {
      font-size: 0.95rem;
      font-weight: 800;
    }

    @media (max-width: 900px) {
      .activity-card {
        grid-template-columns: 1fr;
      }
      .act-thumb-wrap {
        height: 220px;
        min-height: auto;
      }
      .guide-pagination {
        grid-template-columns: 1fr;
        gap: 0.85rem;
      }
      .page-link {
        text-align: left !important;
      }
    }

    @media (max-width: 768px) {
      .top-bar {
        padding: 0.65rem 1rem;
        gap: 0.5rem;
      }
      .breadcrumb-nav {
        font-size: 0.72rem;
      }
      .nav-actions {
        width: 100%;
        display: flex;
        justify-content: space-between;
        gap: 0.4rem;
      }
      .btn-action {
        font-size: 0.72rem;
        padding: 0.45rem 0.75rem;
        flex: 1;
        justify-content: center;
      }
      .guide-wrapper {
        padding: 0 1rem;
        margin: 1.25rem auto 3rem;
      }
      .hero-banner-image-wrap {
        height: 280px;
      }
      .hero-floating-content {
        padding: 1.25rem;
      }
      .hero-title {
        font-size: 1.75rem;
      }
      .hero-tagline {
        font-size: 0.92rem;
      }
      .hero-details-container {
        padding: 1.25rem;
      }
      .quick-jump-bar {
        top: 50px;
        padding: 0.5rem 0.75rem;
      }
      .jump-pill {
        font-size: 0.72rem;
        padding: 0.35rem 0.75rem;
      }
      .act-content-box {
        padding: 1.25rem;
      }
      .act-title {
        font-size: 1.15rem;
      }
      .events-bento {
        grid-template-columns: 1fr;
      }
      .culinary-grid,
      .logistics-grid {
        grid-template-columns: 1fr;
      }
    }
  </style>
</head>
<body>
  <div class="m-tricolor-strip"></div>

  <!-- Top Bar -->
  <header class="top-bar">
    <nav class="breadcrumb-nav" aria-label="Breadcrumb">
      <a href="../../">MC Travel OS</a>
      <span>/</span>
      <a href="../">Field Guides</a>
      <span>/</span>
      <span class="breadcrumb-current">Hub {guide.hubNumber}</span>
    </nav>

    <div class="nav-actions">
      <a href={`../../?hub=${guide.id}`} class="btn-action btn-primary">
        <span>🗺️ Cockpit Map</span>
      </a>
      <a href="../" class="btn-action">
        <span>📖 All 7 Guides</span>
      </a>
      <button type="button" class="btn-action" id="theme-btn">
        <span id="theme-text">☀️ Nordic Light</span>
      </button>
    </div>
  </header>

  <main class="guide-wrapper">
    <!-- Hero Banner Panel -->
    <section class="hero-panel">
      <div class="hero-banner-image-wrap">
        {heroImgSrc && (
          <img src={heroImgSrc} alt={guide.name} class="hero-banner-img" />
        )}
        <div class="hero-scrim"></div>
        <div class="hero-floating-content">
          <div class="hub-kicker-strip">
            <span class="hub-number-badge">HUB {guide.hubNumber}</span>
            <span class="hub-region-badge">{guide.region}</span>
          </div>
          <h1 class="hero-title">{guide.name}</h1>
          <p class="hero-tagline">{guide.tagline}</p>
        </div>
      </div>

      <div class="hero-details-container">
        <div class="telemetry-row">
          <div class="telemetry-pill">
            <span>📅</span>
            <span>{guide.dates}</span>
          </div>
          <div class="telemetry-pill">
            <span>🌙</span>
            <span>{guide.nights} Nights</span>
          </div>
          {hubInfo && (
            <div class="telemetry-pill">
              <span>☀️</span>
              <span>{hubInfo.weatherAvg}</span>
            </div>
          )}
          {hubInfo && (
            <div class="telemetry-pill">
              <span>✈️</span>
              <span>{hubInfo.cebuPacGateway}</span>
            </div>
          )}
        </div>

        <div class="hero-actions-row">
          <a href={hubDirectionsUrl} target="_blank" rel="noopener noreferrer" class="btn-hub-directions">
            <span>🧭 Turn-by-Turn Directions to Hub ↗</span>
          </a>
          <a href={`../../?hub=${guide.id}`} class="btn-action">
            <span>🗺️ Open in Live Cockpit</span>
          </a>
        </div>

        <div class="vibe-box">
          <strong>Vibe Check:</strong> {guide.vibeCheck}
        </div>
      </div>
    </section>

    <!-- Sticky Quick Jump Bar -->
    <nav class="quick-jump-bar" aria-label="Section Quick Jump">
      <a href="#activities" class="jump-pill">🎯 Curated Activities ({guide.keyActivities.length})</a>
      {guide.automotiveAndEvents.length > 0 && (
        <a href="#automotive" class="jump-pill">🏎️ ///M Meets &amp; Drives ({guide.automotiveAndEvents.length})</a>
      )}
      <a href="#dining" class="jump-pill">☕ Culinary &amp; Coffee ({guide.culinaryGuide.length})</a>
      <a href="#logistics" class="jump-pill">🧭 Practical Logistics</a>
    </nav>

    <!-- 01: Curated Day Activities -->
    <section id="activities">
      <div class="section-title-bar">
        <h3>
          <span>🎯</span>
          <span>Curated Day Activities &amp; Anchors ({guide.keyActivities.length})</span>
        </h3>
        <span class="section-subtitle">Two-Anchor Daily Ceiling · Google Maps Directions Enabled</span>
      </div>

      <div class="activities-grid">
        {guide.keyActivities.map((act) => {
          const actImgSrc = resolveAsset(act.imageUrl);
          const actDirectionsUrl = getDirectionsUrl(act.title, act.location, act.coords);
          const googleSearchUrl = `https://www.google.com/search?tbm=isch&q=${encodeURIComponent(act.title + ' ' + act.location + ' Philippines')}`;

          return (
            <article class="activity-card">
              <div class="act-thumb-wrap">
                {actImgSrc && (
                  <img src={actImgSrc} alt={act.title} class="act-img" loading="lazy" />
                )}
                <span class="act-category-badge">{act.category}</span>
              </div>

              <div class="act-content-box">
                <div>
                  <div class="act-header">
                    <h4 class="act-title">{act.title}</h4>
                    <span class="act-timing-pill">⏰ {act.timeOfDay} · {act.duration}</span>
                  </div>

                  <div class="act-location">
                    <span>📍</span>
                    <span>{act.location}</span>
                  </div>

                  <p class="act-desc">{act.description}</p>

                  <div class="act-tip-box">
                    <strong>💡 Verified Insider Tip:</strong> {act.insiderTip}
                  </div>
                </div>

                <div class="act-action-row">
                  <a href={actDirectionsUrl} target="_blank" rel="noopener noreferrer" class="btn-act-directions" title="Turn-by-turn navigation via Google Maps">
                    <span>🧭 Directions ↗</span>
                  </a>
                  <a href={googleSearchUrl} target="_blank" rel="noopener noreferrer" class="btn-act-photos" title="View live photo galleries on Google Images">
                    <span>🔎 Live Photos ↗</span>
                  </a>
                  {act.bookingRequired && act.bookingUrl && (
                    <a href={act.bookingUrl} target="_blank" rel="noopener noreferrer" class="btn-act-book">
                      <span>🎫 Book Portal ↗</span>
                    </a>
                  )}
                </div>
              </div>
            </article>
          );
        })}
      </div>
    </section>

    <!-- 02: Automotive & Live Events -->
    {guide.automotiveAndEvents.length > 0 && (
      <section id="automotive">
        <div class="section-title-bar">
          <h3>
            <span>🏎️</span>
            <span>Automotive Culture, Car Meets &amp; Scenic Passes</span>
          </h3>
          <span class="section-subtitle" style="color:var(--m-red-glow);">///M Performance Intel</span>
        </div>

        <div class="events-bento">
          {guide.automotiveAndEvents.map((evt) => {
            const evtDirectionsUrl = getDirectionsUrl(evt.title, evt.venue);

            return (
              <article class="event-card">
                <div>
                  <div class="event-top-tag">{evt.badge}</div>
                  <h4 class="event-title">{evt.title}</h4>
                  <div class="event-meta">
                    <span>📍 {evt.venue}</span> · <span>📅 {evt.dates}</span>
                  </div>
                  <p class="event-desc-text">{evt.description}</p>
                  <div class="event-pro-tip">
                    <strong>Pro-Tip:</strong> {evt.proTip}
                  </div>
                </div>

                <div class="event-action-row">
                  <a href={evtDirectionsUrl} target="_blank" rel="noopener noreferrer" class="btn-act-directions">
                    <span>🧭 Directions to Venue ↗</span>
                  </a>
                </div>
              </article>
            );
          })}
        </div>
      </section>
    )}

    <!-- 03: Culinary & Third-Wave Coffee Anchors -->
    <section id="dining">
      <div class="section-title-bar">
        <h3>
          <span>☕</span>
          <span>Culinary &amp; Specialty Coffee Anchors</span>
        </h3>
        <span class="section-subtitle" style="color:var(--amber-telemetry);">Tested &amp; Recommended</span>
      </div>

      <div class="culinary-grid">
        {guide.culinaryGuide.map((din) => {
          const diningDirectionsUrl = getDirectionsUrl(din.name, din.area);

          return (
            <article class="dining-card">
              <div>
                <div class="dining-type">{din.type}</div>
                <h4 class="dining-name">{din.name}</h4>
                <div class="dining-area">📍 {din.area}</div>
                <div class="dining-order-box">
                  <strong>Must-Order:</strong> {din.mustOrder}
                </div>
                <div class="dining-vibe">
                  "{din.vibe}"
                </div>
              </div>

              <div class="dining-action-row">
                <a href={diningDirectionsUrl} target="_blank" rel="noopener noreferrer" class="btn-act-directions">
                  <span>🧭 Directions ↗</span>
                </a>
              </div>
            </article>
          );
        })}
      </div>
    </section>

    <!-- 04: Practical Logistics & Field Intelligence -->
    <section id="logistics">
      <div class="section-title-bar">
        <h3>
          <span>🧭</span>
          <span>Practical Field Logistics</span>
        </h3>
        <span class="section-subtitle" style="color:var(--nordic-mint);">Local Protocols</span>
      </div>

      <div class="logistics-grid">
        <div class="logistics-box">
          <div class="logistics-title">🚗 Getting Around</div>
          <div class="logistics-content">{guide.insiderLogistics.gettingAround}</div>
        </div>
        <div class="logistics-box">
          <div class="logistics-title">📶 Connectivity (eSIM)</div>
          <div class="logistics-content">{guide.insiderLogistics.connectivity}</div>
        </div>
        <div class="logistics-box">
          <div class="logistics-title">💳 Cash vs Cards</div>
          <div class="logistics-content">{guide.insiderLogistics.cashVsCards}</div>
        </div>
        <div class="logistics-box">
          <div class="logistics-title">👔 Dress Code</div>
          <div class="logistics-content">{guide.insiderLogistics.dressCode}</div>
        </div>
        <div class="logistics-box" style="grid-column: 1 / -1;">
          <div class="logistics-title" style="color:var(--amber-telemetry);">☔ Weather &amp; Rainy Day Backup Plan</div>
          <div class="logistics-content">{guide.insiderLogistics.weatherBackup}</div>
        </div>
      </div>
    </section>

    <!-- Navigation Pagination -->
    <nav class="guide-pagination" aria-label="Guides Navigation">
      <a href={`../${prevGuide.id}/`} class="page-link">
        <span class="dir">← Previous Destination</span>
        <span class="target-title">Hub {prevGuide.hubNumber}: {prevGuide.name.split(':')[0]}</span>
      </a>

      <a href={`../../?hub=${guide.id}`} class="btn-action btn-primary" style="padding:0.8rem 1.6rem; justify-content:center;">
        <span>🗺️ Open in Live Cockpit Map</span>
      </a>

      <a href={`../${nextGuide.id}/`} class="page-link" style="text-align:right;">
        <span class="dir">Next Destination →</span>
        <span class="target-title">Hub {nextGuide.hubNumber}: {nextGuide.name.split(':')[0]}</span>
      </a>
    </nav>
  </main>

  <script is:inline>
    // Theme Switcher Sync
    const themeBtn = document.getElementById('theme-btn');
    const themeText = document.getElementById('theme-text');
    const savedTheme = localStorage.getItem('kapuluan_theme') || 'dark';

    if (savedTheme === 'light') {
      document.body.classList.add('theme-nordic-light');
      if (themeText) themeText.textContent = '🌑 ///M Dark';
    }

    themeBtn?.addEventListener('click', () => {
      const isLight = document.body.classList.toggle('theme-nordic-light');
      localStorage.setItem('kapuluan_theme', isLight ? 'light' : 'dark');
      if (themeText) themeText.textContent = isLight ? '🌑 ///M Dark' : '☀️ Nordic Light';
    });
  </script>
</body>
</html>
