---
import { DESTINATION_GUIDES, DESTINATION_HUBS } from '../../data/tourData';

const totalActivities = DESTINATION_GUIDES.reduce((acc, g) => acc + g.keyActivities.length, 0);
const totalEvents = DESTINATION_GUIDES.reduce((acc, g) => acc + g.automotiveAndEvents.length, 0);

function resolveAsset(url: string | undefined): string {
  if (!url) return '';
  if (url.startsWith('http')) return url;
  if (url.startsWith('./')) return '../' + url.slice(2);
  if (url.startsWith('/')) return '..' + url;
  return '../' + url;
}

function getHubCenter(id: string): [number, number] {
  const hub = DESTINATION_HUBS.find((h) => h.id === id);
  if (hub && hub.center) return hub.center;
  return [14.5567, 121.0245];
}
---

<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0, viewport-fit=cover" />
  <meta name="theme-color" content="#0A0D12" />
  <title>Destination &amp; Activity Guides · MC TRAVEL OS (Maria &amp; Christian)</title>
  <link rel="icon" type="image/svg+xml" href="../favicon.svg" />
  <link rel="manifest" href="../manifest.webmanifest" />

  <!-- Google Fonts: Plus Jakarta Sans & JetBrains Mono -->
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=JetBrains+Mono:wght@400;500;600;700&family=Plus+Jakarta+Sans:wght@400;500;600;700;800&display=swap" rel="stylesheet">

  <style>
    :root {
      --bg-canvas: #0A0D12;
      --bg-panel: #111620;
      --bg-card: #151C29;
      --bg-card-hover: #1B2435;
      --bg-elevated: #0E131C;
      --bg-glass: rgba(14, 19, 28, 0.88);
      --text-primary: #F8FAFC;
      --text-secondary: #94A3B8;
      --text-muted: #64748B;
      --border-hairline: rgba(255, 255, 255, 0.08);
      --border-strong: rgba(255, 255, 255, 0.16);

      --m-light-blue: #0066B1;
      --m-Sky-glow: #2E9AFE;
      --m-violet-navy: #1C2674;
      --m-indigo-pill: #6366F1;
      --m-red: #E30613;
      --m-red-glow: #FF2836;
      --nordic-mint: #10B981;
      --amber-telemetry: #F59E0B;

      --radius-sm: 8px;
      --radius-card: 22px;
      --radius-pill: 9999px;
      --shadow-airbnb: 0 16px 36px -6px rgba(0, 0, 0, 0.35);

      --font-sans: 'Plus Jakarta Sans', -apple-system, BlinkMacSystemFont, sans-serif;
      --font-mono: 'JetBrains Mono', monospace;
    }

    body.theme-nordic-light {
      --bg-canvas: #F6F8FB;
      --bg-panel: #FFFFFF;
      --bg-card: #FFFFFF;
      --bg-card-hover: #F1F5F9;
      --bg-elevated: #F8FAFC;
      --bg-glass: rgba(255, 255, 255, 0.92);
      --text-primary: #0F172A;
      --text-secondary: #475569;
      --text-muted: #64748B;
      --border-hairline: rgba(15, 23, 42, 0.08);
      --border-strong: rgba(15, 23, 42, 0.15);
      --shadow-airbnb: 0 14px 34px -4px rgba(15, 23, 42, 0.08);
    }

    * {
      box-sizing: border-box;
      margin: 0;
      padding: 0;
      -webkit-tap-highlight-color: transparent;
    }

    body {
      background-color: var(--bg-canvas);
      color: var(--text-primary);
      font-family: var(--font-sans);
      line-height: 1.6;
      min-height: 100vh;
      padding-bottom: 90px;
      transition: background-color 0.25s ease, color 0.25s ease;
      -webkit-font-smoothing: antialiased;
    }

    .m-tricolor-strip {
      height: 4px;
      width: 100%;
      background: linear-gradient(
        90deg,
        #0066B1 0%,
        #0066B1 33.3%,
        #1C2674 33.3%,
        #1C2674 66.6%,
        #E30613 66.6%,
        #E30613 100%
      );
      position: sticky;
      top: 0;
      z-index: 1100;
    }

    .top-bar {
      display: flex;
      flex-wrap: wrap;
      justify-content: space-between;
      align-items: center;
      gap: 0.85rem;
      padding: 0.85rem 1.75rem;
      background: var(--bg-glass);
      backdrop-filter: blur(20px);
      -webkit-backdrop-filter: blur(20px);
      border-bottom: 1px solid var(--border-hairline);
      position: sticky;
      top: 4px;
      z-index: 1050;
      box-shadow: 0 4px 20px rgba(0, 0, 0, 0.08);
    }

    .brand-group {
      display: flex;
      align-items: center;
      gap: 0.85rem;
    }

    .m-logo {
      display: inline-flex;
      align-items: center;
      gap: 3px;
      font-family: var(--font-mono);
      font-weight: 800;
      font-style: italic;
      font-size: 0.95rem;
      padding: 0.4rem 0.75rem;
      background: var(--bg-card);
      border: 1px solid var(--border-strong);
      border-radius: var(--radius-pill);
      text-decoration: none;
      color: var(--text-primary);
      box-shadow: 0 2px 8px rgba(0,0,0,0.1);
      transition: transform 0.15s ease;
    }
    .m-logo:hover {
      transform: scale(1.03);
    }

    .brand-title {
      font-size: 0.96rem;
      font-weight: 800;
      letter-spacing: -0.02em;
    }
    .brand-subtitle {
      font-size: 0.72rem;
      color: var(--text-muted);
      font-family: var(--font-mono);
    }

    .nav-actions {
      display: flex;
      align-items: center;
      gap: 0.6rem;
    }

    .btn-action {
      display: inline-flex;
      align-items: center;
      gap: 0.45rem;
      font-family: var(--font-mono);
      font-size: 0.76rem;
      font-weight: 700;
      padding: 0.5rem 0.95rem;
      border-radius: var(--radius-pill);
      text-decoration: none;
      border: 1px solid var(--border-strong);
      background: var(--bg-card);
      color: var(--text-primary);
      cursor: pointer;
      transition: all 0.2s cubic-bezier(0.16, 1, 0.3, 1);
    }
    .btn-action:hover {
      background: var(--bg-card-hover);
      border-color: var(--m-Sky-glow);
      transform: translateY(-1px);
    }
    .btn-primary {
      background: linear-gradient(135deg, #0066B1, #1C2674);
      color: #FFFFFF;
      border-color: rgba(46, 154, 254, 0.5);
      box-shadow: 0 4px 14px rgba(0, 102, 177, 0.3);
    }
    .btn-primary:hover {
      box-shadow: 0 6px 18px rgba(0, 102, 177, 0.45);
      color: #FFFFFF;
    }

    /* Hero Section */
    .hero-container {
      max-width: 1360px;
      margin: 2.5rem auto 1.75rem;
      padding: 0 1.75rem;
    }

    .telemetry-pill-strip {
      display: inline-flex;
      flex-wrap: wrap;
      align-items: center;
      gap: 0.5rem;
      font-family: var(--font-mono);
      font-size: 0.74rem;
      font-weight: 700;
      letter-spacing: 0.05em;
      color: var(--m-Sky-glow);
      background: rgba(46, 154, 254, 0.08);
      padding: 0.35rem 0.85rem;
      border-radius: var(--radius-pill);
      border: 1px solid rgba(46, 154, 254, 0.22);
      margin-bottom: 1rem;
    }
    .telemetry-pill-strip .sep {
      color: var(--text-muted);
      opacity: 0.5;
    }

    .hero-title {
      font-size: 2.6rem;
      font-weight: 800;
      letter-spacing: -0.035em;
      line-height: 1.15;
      margin-bottom: 0.65rem;
    }

    .hero-subtitle {
      font-size: 1.1rem;
      color: var(--text-secondary);
      max-width: 860px;
      line-height: 1.6;
    }

    /* Filter Bar - Airbnb Style */
    .filter-bar {
      display: flex;
      flex-wrap: wrap;
      gap: 0.65rem;
      margin-top: 2rem;
      padding-bottom: 1.25rem;
      border-bottom: 1px solid var(--border-hairline);
    }

    .filter-btn {
      font-family: var(--font-mono);
      font-size: 0.78rem;
      font-weight: 700;
      padding: 0.55rem 1.15rem;
      border-radius: var(--radius-pill);
      background: var(--bg-card);
      color: var(--text-secondary);
      border: 1px solid var(--border-hairline);
      cursor: pointer;
      transition: all 0.2s cubic-bezier(0.16, 1, 0.3, 1);
      box-shadow: 0 2px 6px rgba(0,0,0,0.05);
    }
    .filter-btn:hover {
      background: var(--bg-card-hover);
      color: var(--text-primary);
      border-color: var(--border-strong);
      transform: translateY(-1px);
    }
    .filter-btn.active {
      background: var(--text-primary);
      color: var(--bg-canvas);
      border-color: var(--text-primary);
      box-shadow: 0 4px 14px rgba(0, 0, 0, 0.2);
    }

    /* Guides Grid */
    .guides-grid {
      display: grid;
      grid-template-columns: repeat(auto-fill, minmax(430px, 1fr));
      gap: 2rem;
      max-width: 1360px;
      margin: 2rem auto 4rem;
      padding: 0 1.75rem;
    }

    .guide-card {
      background: var(--bg-card);
      border: 1px solid var(--border-hairline);
      border-radius: var(--radius-card);
      overflow: hidden;
      display: flex;
      flex-direction: column;
      justify-content: space-between;
      transition: all 0.25s cubic-bezier(0.16, 1, 0.3, 1);
      position: relative;
      box-shadow: var(--shadow-airbnb);
    }
    .guide-card:hover {
      transform: translateY(-4px);
      border-color: var(--border-strong);
      box-shadow: 0 20px 42px -6px rgba(0, 0, 0, 0.42);
    }

    /* Card Banner */
    .banner-container {
      position: relative;
      width: 100%;
      height: 220px;
      overflow: hidden;
      background: var(--bg-elevated);
    }

    .card-banner-img {
      width: 100%;
      height: 100%;
      object-fit: cover;
      display: block;
      transition: transform 0.4s cubic-bezier(0.16, 1, 0.3, 1);
    }
    .guide-card:hover .card-banner-img {
      transform: scale(1.05);
    }

    .banner-overlay-top {
      position: absolute;
      top: 1rem;
      left: 1rem;
      right: 1rem;
      display: flex;
      justify-content: space-between;
      align-items: center;
      gap: 0.5rem;
      z-index: 2;
    }

    .badge-hub-pill {
      font-family: var(--font-mono);
      font-weight: 800;
      font-size: 0.74rem;
      padding: 0.3rem 0.7rem;
      border-radius: var(--radius-pill);
      background: rgba(10, 13, 18, 0.85);
      color: var(--m-Sky-glow);
      backdrop-filter: blur(10px);
      border: 1px solid rgba(46, 154, 254, 0.35);
      box-shadow: 0 2px 8px rgba(0,0,0,0.3);
    }

    .badge-dates-pill {
      font-family: var(--font-mono);
      font-size: 0.72rem;
      font-weight: 600;
      padding: 0.3rem 0.7rem;
      border-radius: var(--radius-pill);
      background: rgba(10, 13, 18, 0.85);
      color: #FFFFFF;
      backdrop-filter: blur(10px);
      border: 1px solid rgba(255, 255, 255, 0.2);
      box-shadow: 0 2px 8px rgba(0,0,0,0.3);
    }

    /* Card Body */
    .card-body {
      padding: 1.75rem;
      display: flex;
      flex-direction: column;
      flex-grow: 1;
    }

    .region-tag {
      font-family: var(--font-mono);
      font-size: 0.7rem;
      font-weight: 700;
      text-transform: uppercase;
      letter-spacing: 0.06em;
      color: var(--m-Sky-glow);
      margin-bottom: 0.4rem;
    }

    .guide-title {
      font-size: 1.45rem;
      font-weight: 800;
      letter-spacing: -0.025em;
      line-height: 1.25;
      margin-bottom: 0.45rem;
    }

    .guide-tagline {
      font-size: 0.88rem;
      color: var(--text-secondary);
      line-height: 1.5;
      margin-bottom: 1.1rem;
    }

    .quote-box {
      font-size: 0.84rem;
      font-style: italic;
      color: var(--text-primary);
      background: var(--bg-elevated);
      border-left: 3px solid var(--m-Sky-glow);
      padding: 0.8rem 1rem;
      border-radius: 0 var(--radius-sm) var(--radius-sm) 0;
      margin-bottom: 1.25rem;
      line-height: 1.5;
    }

    .section-label {
      font-family: var(--font-mono);
      font-size: 0.7rem;
      font-weight: 800;
      letter-spacing: 0.06em;
      text-transform: uppercase;
      color: var(--text-muted);
      margin-bottom: 0.65rem;
      display: flex;
      align-items: center;
      gap: 0.45rem;
    }

    .activities-list {
      list-style: none;
      display: flex;
      flex-direction: column;
      gap: 0.6rem;
      margin-bottom: 1.35rem;
    }

    .activity-item {
      display: flex;
      align-items: baseline;
      justify-content: space-between;
      gap: 0.65rem;
      font-size: 0.85rem;
      color: var(--text-primary);
      padding: 0.45rem 0.65rem;
      background: var(--bg-elevated);
      border-radius: var(--radius-sm);
      border: 1px solid var(--border-hairline);
    }
    .activity-left {
      display: flex;
      align-items: center;
      gap: 0.5rem;
      min-width: 0;
    }
    .activity-left .dot {
      width: 6px;
      height: 6px;
      border-radius: 50%;
      background: var(--m-Sky-glow);
      flex-shrink: 0;
    }
    .activity-left strong {
      white-space: nowrap;
      overflow: hidden;
      text-overflow: ellipsis;
    }
    .activity-badge {
      font-family: var(--font-mono);
      font-size: 0.68rem;
      font-weight: 600;
      padding: 0.15rem 0.45rem;
      border-radius: var(--radius-pill);
      background: rgba(255, 255, 255, 0.08);
      color: var(--text-secondary);
      flex-shrink: 0;
    }

    /* Event Callout */
    .event-callout {
      background: rgba(227, 6, 19, 0.07);
      border: 1px solid rgba(227, 6, 19, 0.25);
      border-radius: 12px;
      padding: 0.85rem 1rem;
      margin-bottom: 1.35rem;
    }
    .event-badge-title {
      font-family: var(--font-mono);
      font-size: 0.74rem;
      font-weight: 800;
      color: var(--m-red-glow);
      display: flex;
      align-items: center;
      gap: 0.45rem;
      margin-bottom: 0.35rem;
    }
    .event-desc {
      font-size: 0.8rem;
      color: var(--text-secondary);
      line-height: 1.45;
    }

    /* Action Buttons Row */
    .card-footer {
      display: flex;
      flex-wrap: wrap;
      align-items: center;
      justify-content: space-between;
      gap: 0.75rem;
      padding-top: 1.15rem;
      border-top: 1px solid var(--border-hairline);
      margin-top: auto;
    }

    .btn-detail {
      font-family: var(--font-mono);
      font-size: 0.78rem;
      font-weight: 700;
      color: #FFFFFF;
      background: linear-gradient(135deg, #0066B1, #1C2674);
      padding: 0.55rem 1.15rem;
      border-radius: var(--radius-pill);
      text-decoration: none;
      display: inline-flex;
      align-items: center;
      gap: 0.45rem;
      transition: all 0.2s cubic-bezier(0.16, 1, 0.3, 1);
      box-shadow: 0 4px 12px rgba(0, 102, 177, 0.35);
    }
    .btn-detail:hover {
      box-shadow: 0 6px 16px rgba(0, 102, 177, 0.5);
      transform: translateY(-1px);
    }

    .actions-subgroup {
      display: flex;
      align-items: center;
      gap: 0.5rem;
    }

    .btn-directions {
      font-family: var(--font-mono);
      font-size: 0.74rem;
      font-weight: 700;
      color: var(--m-Sky-glow);
      background: rgba(46, 154, 254, 0.1);
      border: 1px solid rgba(46, 154, 254, 0.28);
      padding: 0.45rem 0.85rem;
      border-radius: var(--radius-pill);
      text-decoration: none;
      display: inline-flex;
      align-items: center;
      gap: 0.35rem;
      transition: all 0.15s ease;
    }
    .btn-directions:hover {
      background: rgba(46, 154, 254, 0.2);
      border-color: var(--m-Sky-glow);
    }

    .btn-map-link {
      font-family: var(--font-mono);
      font-size: 0.74rem;
      color: var(--text-secondary);
      text-decoration: none;
      display: inline-flex;
      align-items: center;
      gap: 0.35rem;
      padding: 0.45rem 0.75rem;
      border-radius: var(--radius-pill);
      border: 1px solid var(--border-hairline);
      background: var(--bg-elevated);
      transition: all 0.15s ease;
    }
    .btn-map-link:hover {
      color: var(--text-primary);
      border-color: var(--border-strong);
    }

    @media (max-width: 768px) {
      .top-bar {
        padding: 0.65rem 1rem;
        gap: 0.5rem;
      }
      .brand-group {
        gap: 0.5rem;
      }
      .hero-container {
        padding: 0 1rem;
        margin: 1.5rem auto 1.25rem;
      }
      .hero-title {
        font-size: 1.85rem;
      }
      .hero-subtitle {
        font-size: 0.95rem;
      }
      .filter-bar {
        overflow-x: auto;
        flex-wrap: nowrap;
        -webkit-overflow-scrolling: touch;
        padding-bottom: 0.65rem;
        scrollbar-width: none;
        gap: 0.45rem;
      }
      .filter-bar::-webkit-scrollbar {
        display: none;
      }
      .filter-btn {
        flex-shrink: 0;
        min-height: 40px;
        padding: 0.45rem 0.95rem;
        font-size: 0.74rem;
      }
      .guides-grid {
        grid-template-columns: 1fr;
        padding: 0 1rem;
        margin: 1.25rem auto 3rem;
        gap: 1.5rem;
      }
      .card-body {
        padding: 1.25rem;
      }
      .banner-container {
        height: 180px;
      }
      .card-footer {
        flex-direction: column;
        align-items: stretch;
        gap: 0.6rem;
      }
      .btn-detail {
        justify-content: center;
        min-height: 44px;
        font-size: 0.82rem;
      }
      .actions-subgroup {
        display: grid;
        grid-template-columns: 1fr 1fr;
        gap: 0.5rem;
      }
      .btn-directions, .btn-map-link {
        justify-content: center;
        min-height: 40px;
      }
    }
  </style>
</head>
<body>
  <div class="m-tricolor-strip"></div>

  <header class="top-bar">
    <div class="brand-group">
      <a href="../" class="m-logo">
        <span style="color:#2E9AFE;">/</span><span style="color:#6366F1;">/</span><span style="color:#FF2836;">/</span>MC
      </a>
      <div>
        <h1 class="brand-title">MC TRAVEL FIELD GUIDES</h1>
        <p class="brand-subtitle">Nov 8 – Dec 9, 2026 · Maria &amp; Christian</p>
      </div>
    </div>

    <div class="nav-actions">
      <a href="../" class="btn-action btn-primary">
        <span>🗺️ Live Cockpit Map</span>
      </a>
      <button type="button" class="btn-action" id="theme-btn">
        <span id="theme-text">☀️ Nordic Light</span>
      </button>
      <a href="https://docs.google.com/spreadsheets/d/1OrCABb_TqMRWFFenlpoUbLRfmU9W5rxHlB7B2sXCkdY/edit?usp=drivesdk" target="_blank" rel="noopener noreferrer" class="btn-action">
        <span>📊 Sheet</span>
      </a>
    </div>
  </header>

  <main class="hero-container">
    <div class="telemetry-pill-strip">
      <span>7 DESTINATIONS</span>
      <span class="sep">·</span>
      <span>32 DAYS</span>
      <span class="sep">·</span>
      <span>{totalActivities} CURATED ANCHORS</span>
      <span class="sep">·</span>
      <span>{totalEvents} ///M MEETS &amp; EVENTS</span>
    </div>
    <h2 class="hero-title">Destination &amp; Activity Field Guides</h2>
    <p class="hero-subtitle">
      Deep-dive field intelligence, verified morning and afternoon anchors, automotive meets, and culinary pilgrimage routes across the Philippine archipelago.
    </p>

    <div class="filter-bar" role="group" aria-label="Region Filter">
      <button type="button" class="filter-btn active" data-filter="all">All 7 Destinations ({DESTINATION_GUIDES.length})</button>
      <button type="button" class="filter-btn" data-filter="Luzon">Metro Manila &amp; Clark (3)</button>
      <button type="button" class="filter-btn" data-filter="Northern Palawan">Northern Palawan (2)</button>
      <button type="button" class="filter-btn" data-filter="Central Visayas">Visayas Roadtrip (2)</button>
    </div>
  </main>

  <section class="guides-grid" id="guides-container">
    {DESTINATION_GUIDES.map((guide) => {
      const bannerSrc = resolveAsset(guide.heroImage);
      const hubCenter = getHubCenter(guide.id);
      const directionsUrl = `https://www.google.com/maps/dir/?api=1&destination=${hubCenter[0]},${hubCenter[1]}`;

      return (
        <article class="guide-card" data-region={guide.region}>
          <div class="banner-container">
            {bannerSrc && (
              <img src={bannerSrc} alt={guide.name} class="card-banner-img" loading="lazy" />
            )}
            <div class="banner-overlay-top">
              <span class="badge-hub-pill">HUB {guide.hubNumber}</span>
              <span class="badge-dates-pill">{guide.dates.split('(')[0].trim()} · {guide.nights}N</span>
            </div>
          </div>

          <div class="card-body">
            <div class="region-tag">{guide.region}</div>
            <h3 class="guide-title">{guide.name}</h3>
            <p class="guide-tagline">{guide.tagline}</p>

            <div class="quote-box">
              "{guide.highlightsQuote}"
            </div>

            <div class="section-label">
              <span>🎯 TOP CURATED ACTIVITIES</span>
            </div>
            <ul class="activities-list">
              {guide.keyActivities.slice(0, 3).map((act) => (
                <li class="activity-item">
                  <div class="activity-left">
                    <span class="dot"></span>
                    <strong>{act.title}</strong>
                  </div>
                  <span class="activity-badge">{act.duration}</span>
                </li>
              ))}
            </ul>

            {guide.automotiveAndEvents.length > 0 && (
              <div class="event-callout">
                <div class="event-badge-title">
                  <span>🏎️</span>
                  <span>{guide.automotiveAndEvents[0].title}</span>
                </div>
                <div class="event-desc">
                  {guide.automotiveAndEvents[0].venue} · {guide.automotiveAndEvents[0].dates}
                </div>
              </div>
            )}

            <div class="card-footer">
              <a href={`./${guide.id}/`} class="btn-detail">
                <span>Explore Field Guide</span>
                <span>→</span>
              </a>
              <div class="actions-subgroup">
                <a href={directionsUrl} target="_blank" rel="noopener noreferrer" class="btn-directions" title="Turn-by-turn navigation via Google Maps">
                  <span>🧭 Directions ↗</span>
                </a>
                <a href={`../?hub=${guide.id}`} class="btn-map-link">
                  <span>🗺️ Map</span>
                </a>
              </div>
            </div>
          </div>
        </article>
      );
    })}
  </section>

  <script is:inline>
    // Theme Switcher Sync
    const themeBtn = document.getElementById('theme-btn');
    const themeText = document.getElementById('theme-text');
    const savedTheme = localStorage.getItem('kapuluan_theme') || 'dark';

    if (savedTheme === 'light') {
      document.body.classList.add('theme-nordic-light');
      if (themeText) themeText.textContent = '🌑 ///M Dark';
    }

    themeBtn?.addEventListener('click', () => {
      const isLight = document.body.classList.toggle('theme-nordic-light');
      localStorage.setItem('kapuluan_theme', isLight ? 'light' : 'dark');
      if (themeText) themeText.textContent = isLight ? '🌑 ///M Dark' : '☀️ Nordic Light';
    });

    // Region Filter Buttons
    document.querySelectorAll('.filter-btn').forEach((btn) => {
      btn.addEventListener('click', () => {
        document.querySelectorAll('.filter-btn').forEach((b) => b.classList.remove('active'));
        btn.classList.add('active');
        const filter = btn.getAttribute('data-filter');

        document.querySelectorAll('.guide-card').forEach((card) => {
          const region = card.getAttribute('data-region') || '';
          if (filter === 'all' || region.includes(filter)) {
            card.style.display = 'flex';
          } else {
            card.style.display = 'none';
          }
        });
      });
    });
  </script>
</body>
</html>
