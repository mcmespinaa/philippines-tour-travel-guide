---
import { DESTINATION_GUIDES, DESTINATION_HUBS } from '../../data/tourData';

const totalActivities = DESTINATION_GUIDES.reduce((acc, g) => acc + g.keyActivities.length, 0);
const totalEvents = DESTINATION_GUIDES.reduce((acc, g) => acc + g.automotiveAndEvents.length, 0);
---

<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0, viewport-fit=cover" />
  <meta name="theme-color" content="#0A0D12" />
  <title>Destination &amp; Activity Guides · MC TRAVEL OS (MC &amp; Christian)</title>
  <link rel="icon" type="image/svg+xml" href="../favicon.svg" />
  <link rel="manifest" href="../manifest.webmanifest" />

  <!-- Google Fonts: Plus Jakarta Sans & JetBrains Mono -->
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=JetBrains+Mono:wght@400;500;600;700&family=Plus+Jakarta+Sans:wght@400;500;600;700;800&display=swap" rel="stylesheet">

  <style>
    :root {
      --bg-canvas: #0A0D12;
      --bg-panel: #111620;
      --bg-card: #161C28;
      --bg-card-hover: #1C2433;
      --bg-elevated: #0D1119;
      --bg-glass: rgba(17, 22, 32, 0.92);
      --text-primary: #F8FAFC;
      --text-secondary: #94A3B8;
      --text-muted: #64748B;
      --border-hairline: rgba(255, 255, 255, 0.08);
      --border-strong: rgba(255, 255, 255, 0.16);

      --m-light-blue: #0066B1;
      --m-Sky-glow: #2E9AFE;
      --m-violet-navy: #1C2674;
      --m-indigo-pill: #6366F1;
      --m-red: #E30613;
      --m-red-glow: #FF2836;
      --nordic-mint: #10B981;
      --amber-telemetry: #F59E0B;

      --font-sans: 'Plus Jakarta Sans', -apple-system, BlinkMacSystemFont, sans-serif;
      --font-mono: 'JetBrains Mono', monospace;
    }

    body.theme-nordic-light {
      --bg-canvas: #F3F5F8;
      --bg-panel: #FFFFFF;
      --bg-card: #F8FAFC;
      --bg-card-hover: #EEF2F6;
      --bg-elevated: #EBF0F5;
      --bg-glass: rgba(255, 255, 255, 0.95);
      --text-primary: #0F172A;
      --text-secondary: #475569;
      --text-muted: #64748B;
      --border-hairline: rgba(15, 23, 42, 0.09);
      --border-strong: rgba(15, 23, 42, 0.18);
    }

    * {
      box-sizing: border-box;
      margin: 0;
      padding: 0;
      -webkit-tap-highlight-color: transparent;
    }

    body {
      background-color: var(--bg-canvas);
      color: var(--text-primary);
      font-family: var(--font-sans);
      line-height: 1.5;
      min-height: 100vh;
      padding-bottom: 80px;
      transition: background-color 0.2s ease, color 0.2s ease;
    }

    .m-tricolor-strip {
      height: 4px;
      width: 100%;
      background: linear-gradient(
        90deg,
        #0066B1 0%,
        #0066B1 33.3%,
        #1C2674 33.3%,
        #1C2674 66.6%,
        #E30613 66.6%,
        #E30613 100%
      );
      position: sticky;
      top: 0;
      z-index: 1100;
    }

    .top-bar {
      display: flex;
      flex-wrap: wrap;
      justify-content: space-between;
      align-items: center;
      gap: 0.75rem;
      padding: 0.75rem 1.5rem;
      background: var(--bg-glass);
      backdrop-filter: blur(18px);
      border-bottom: 1px solid var(--border-hairline);
      position: sticky;
      top: 4px;
      z-index: 1050;
    }

    .brand-group {
      display: flex;
      align-items: center;
      gap: 0.85rem;
    }

    .m-logo {
      display: inline-flex;
      align-items: center;
      gap: 2px;
      font-family: var(--font-mono);
      font-weight: 800;
      font-style: italic;
      font-size: 0.95rem;
      padding: 0.35rem 0.65rem;
      background: var(--bg-card);
      border: 1px solid var(--border-strong);
      border-radius: 8px;
      text-decoration: none;
      color: var(--text-primary);
    }

    .nav-actions {
      display: flex;
      align-items: center;
      gap: 0.6rem;
    }

    .btn-action {
      display: inline-flex;
      align-items: center;
      gap: 0.4rem;
      font-family: var(--font-mono);
      font-size: 0.78rem;
      font-weight: 700;
      padding: 0.45rem 0.85rem;
      border-radius: 7px;
      text-decoration: none;
      border: 1px solid var(--border-strong);
      background: var(--bg-card);
      color: var(--text-primary);
      cursor: pointer;
      transition: all 0.15s ease;
    }
    .btn-action:hover {
      background: var(--bg-card-hover);
      border-color: var(--m-Sky-glow);
    }
    .btn-primary {
      background: linear-gradient(135deg, #0066B1, #1C2674);
      color: #FFFFFF;
      border-color: rgba(46, 154, 254, 0.4);
    }

    .hero-container {
      max-width: 1360px;
      margin: 2rem auto 1.5rem;
      padding: 0 1.5rem;
    }

    .telemetry-tag {
      display: inline-flex;
      align-items: center;
      gap: 0.5rem;
      font-family: var(--font-mono);
      font-size: 0.72rem;
      font-weight: 700;
      letter-spacing: 0.08em;
      text-transform: uppercase;
      color: var(--m-Sky-glow);
      background: rgba(46, 154, 254, 0.1);
      padding: 0.3rem 0.7rem;
      border-radius: 6px;
      border: 1px solid rgba(46, 154, 254, 0.25);
      margin-bottom: 0.75rem;
    }

    .hero-title {
      font-size: 2.2rem;
      font-weight: 800;
      letter-spacing: -0.03em;
      line-height: 1.15;
      margin-bottom: 0.5rem;
    }

    .hero-subtitle {
      font-size: 1.05rem;
      color: var(--text-secondary);
      max-width: 820px;
      line-height: 1.55;
    }

    .filter-bar {
      display: flex;
      flex-wrap: wrap;
      gap: 0.5rem;
      margin-top: 1.5rem;
      padding-bottom: 1rem;
      border-bottom: 1px solid var(--border-hairline);
    }

    .filter-btn {
      font-family: var(--font-mono);
      font-size: 0.76rem;
      font-weight: 700;
      padding: 0.4rem 0.85rem;
      border-radius: 6px;
      background: var(--bg-panel);
      color: var(--text-secondary);
      border: 1px solid var(--border-hairline);
      cursor: pointer;
      transition: all 0.15s ease;
    }
    .filter-btn.active, .filter-btn:hover {
      background: var(--bg-card-hover);
      color: var(--text-primary);
      border-color: var(--m-Sky-glow);
    }

    .guides-grid {
      display: grid;
      grid-template-columns: repeat(auto-fill, minmax(420px, 1fr));
      gap: 1.5rem;
      max-width: 1360px;
      margin: 1.5rem auto 3rem;
      padding: 0 1.5rem;
    }

    .guide-card {
      background: var(--bg-panel);
      border: 1px solid var(--border-hairline);
      border-radius: 12px;
      overflow: hidden;
      display: flex;
      flex-direction: column;
      justify-content: space-between;
      transition: transform 0.2s ease, border-color 0.2s ease, box-shadow 0.2s ease;
      position: relative;
    }
    .guide-card:hover {
      transform: translateY(-2px);
      border-color: var(--border-strong);
      box-shadow: 0 12px 28px rgba(0, 0, 0, 0.35);
    }

    .card-banner-img {
      width: 100%;
      height: 160px;
      object-fit: cover;
      background: var(--bg-card);
      border-bottom: 1px solid var(--border-hairline);
    }

    .card-body {
      padding: 1.4rem;
      display: flex;
      flex-direction: column;
      flex-grow: 1;
    }

    .card-top {
      display: flex;
      justify-content: space-between;
      align-items: flex-start;
      gap: 0.75rem;
      margin-bottom: 0.75rem;
    }

    .hub-number-badge {
      font-family: var(--font-mono);
      font-weight: 800;
      font-size: 0.8rem;
      padding: 0.2rem 0.55rem;
      border-radius: 6px;
      background: rgba(46, 154, 254, 0.12);
      color: var(--m-Sky-glow);
      border: 1px solid rgba(46, 154, 254, 0.3);
    }

    .hub-dates {
      font-family: var(--font-mono);
      font-size: 0.72rem;
      color: var(--text-muted);
    }

    .guide-title {
      font-size: 1.35rem;
      font-weight: 800;
      letter-spacing: -0.02em;
      margin-bottom: 0.35rem;
    }

    .guide-tagline {
      font-size: 0.85rem;
      color: var(--text-secondary);
      line-height: 1.45;
      margin-bottom: 0.9rem;
    }

    .quote-box {
      font-size: 0.8rem;
      font-style: italic;
      color: var(--text-primary);
      background: var(--bg-elevated);
      border-left: 2px solid var(--m-Sky-glow);
      padding: 0.6rem 0.85rem;
      border-radius: 0 6px 6px 0;
      margin-bottom: 1rem;
      line-height: 1.45;
    }

    .section-label {
      font-family: var(--font-mono);
      font-size: 0.68rem;
      font-weight: 700;
      letter-spacing: 0.05em;
      text-transform: uppercase;
      color: var(--text-muted);
      margin-bottom: 0.45rem;
      display: flex;
      align-items: center;
      gap: 0.4rem;
    }

    .activities-list {
      list-style: none;
      display: flex;
      flex-direction: column;
      gap: 0.45rem;
      margin-bottom: 1rem;
    }

    .activity-item {
      display: flex;
      align-items: baseline;
      gap: 0.5rem;
      font-size: 0.82rem;
      color: var(--text-primary);
    }
    .activity-item .dot {
      width: 5px;
      height: 5px;
      border-radius: 50%;
      background: var(--m-Sky-glow);
      flex-shrink: 0;
    }
    .activity-badge {
      font-family: var(--font-mono);
      font-size: 0.62rem;
      padding: 0.1rem 0.35rem;
      border-radius: 4px;
      background: rgba(255, 255, 255, 0.06);
      color: var(--text-secondary);
      flex-shrink: 0;
    }

    .event-callout {
      background: rgba(227, 6, 19, 0.08);
      border: 1px solid rgba(227, 6, 19, 0.25);
      border-radius: 8px;
      padding: 0.65rem 0.85rem;
      margin-bottom: 1.1rem;
    }
    .event-badge-title {
      font-family: var(--font-mono);
      font-size: 0.7rem;
      font-weight: 800;
      color: var(--m-red-glow);
      display: flex;
      align-items: center;
      gap: 0.35rem;
      margin-bottom: 0.25rem;
    }
    .event-desc {
      font-size: 0.78rem;
      color: var(--text-secondary);
      line-height: 1.38;
    }

    .card-footer {
      display: flex;
      align-items: center;
      justify-content: space-between;
      gap: 0.75rem;
      padding-top: 0.85rem;
      border-top: 1px solid var(--border-hairline);
      margin-top: auto;
    }

    .btn-detail {
      font-family: var(--font-mono);
      font-size: 0.76rem;
      font-weight: 700;
      color: #FFFFFF;
      background: linear-gradient(135deg, #0066B1, #1C2674);
      padding: 0.45rem 0.9rem;
      border-radius: 6px;
      text-decoration: none;
      display: inline-flex;
      align-items: center;
      gap: 0.35rem;
      transition: opacity 0.15s ease;
    }
    .btn-detail:hover {
      opacity: 0.9;
    }

    .btn-map-link {
      font-family: var(--font-mono);
      font-size: 0.74rem;
      color: var(--text-secondary);
      text-decoration: none;
      display: inline-flex;
      align-items: center;
      gap: 0.3rem;
    }
    .btn-map-link:hover {
      color: var(--m-Sky-glow);
    }

    @media (max-width: 768px) {
      .guides-grid {
        grid-template-columns: 1fr;
      }
      .hero-title {
        font-size: 1.7rem;
      }
    }
  </style>
</head>
<body>
  <div class="m-tricolor-strip"></div>

  <header class="top-bar">
    <div class="brand-group">
      <a href="../" class="m-logo">
        <span style="color:#2E9AFE;">/</span><span style="color:#6366F1;">/</span><span style="color:#FF2836;">/</span>MC
      </a>
      <div>
        <h1 style="font-size:0.95rem;font-weight:800;letter-spacing:-0.02em;">MC TRAVEL FIELD GUIDES</h1>
        <p style="font-size:0.72rem;color:var(--text-muted);font-family:var(--font-mono);">Nov 8 – Dec 9, 2026 · MC &amp; Christian</p>
      </div>
    </div>

    <div class="nav-actions">
      <a href="../" class="btn-action btn-primary">
        <span>🗺️ Live Cockpit Map</span>
      </a>
      <button type="button" class="btn-action" id="theme-btn">
        <span id="theme-text">☀️ Nordic Light</span>
      </button>
      <a href="https://docs.google.com/spreadsheets/d/1OrCABb_TqMRWFFenlpoUbLRfmU9W5rxHlB7B2sXCkdY/edit?usp=drivesdk" target="_blank" rel="noopener noreferrer" class="btn-action">
        <span>📊 Sheet</span>
      </a>
    </div>
  </header>

  <main class="hero-container">
    <div class="telemetry-tag">
      <span>7 DESTINATIONS</span> · <span>32 DAYS</span> · <span>{totalActivities} CURATED ACTIVITIES</span> · <span>{totalEvents} CAR MEETS &amp; EVENTS</span>
    </div>
    <h2 class="hero-title">Destination &amp; Activity Field Guides</h2>
    <p class="hero-subtitle">
      Deep-dive field intelligence, verified morning and afternoon anchors, automotive meets, and culinary pilgrimage routes across the Philippines archipelago.
    </p>

    <div class="filter-bar" role="group" aria-label="Region Filter">
      <button type="button" class="filter-btn active" data-filter="all">All 7 Destinations ({DESTINATION_GUIDES.length})</button>
      <button type="button" class="filter-btn" data-filter="Luzon">Metro Manila &amp; Clark (3)</button>
      <button type="button" class="filter-btn" data-filter="Northern Palawan">Northern Palawan (2)</button>
      <button type="button" class="filter-btn" data-filter="Central Visayas">Visayas Roadtrip (2)</button>
    </div>
  </main>

  <section class="guides-grid" id="guides-container">
    {DESTINATION_GUIDES.map((guide) => (
      <article class="guide-card" data-region={guide.region}>
        {guide.heroImage && (
          <img src={guide.heroImage} alt={guide.name} class="card-banner-img" loading="lazy" />
        )}
        <div class="card-body">
          <div class="card-top">
            <span class="hub-number-badge">HUB {guide.hubNumber}</span>
            <span class="hub-dates">{guide.dates} ({guide.nights}N)</span>
          </div>

          <h3 class="guide-title">{guide.name}</h3>
          <p class="guide-tagline">{guide.tagline}</p>

          <div class="quote-box">
            "{guide.highlightsQuote}"
          </div>

          <div class="section-label">
            <span>🎯 TOP CURATED ACTIVITIES</span>
          </div>
          <ul class="activities-list">
            {guide.keyActivities.slice(0, 3).map((act) => (
              <li class="activity-item">
                <span class="dot"></span>
                <span><strong>{act.title}</strong></span>
                <span class="activity-badge">{act.duration}</span>
              </li>
            ))}
          </ul>

          {guide.automotiveAndEvents.length > 0 && (
            <div class="event-callout">
              <div class="event-badge-title">
                <span>🏎️</span>
                <span>{guide.automotiveAndEvents[0].title}</span>
              </div>
              <div class="event-desc">
                {guide.automotiveAndEvents[0].venue} · {guide.automotiveAndEvents[0].dates}
              </div>
            </div>
          )}

          <div class="card-footer">
            <a href={`./${guide.id}/`} class="btn-detail">
              <span>Open Field Guide</span>
              <span>→</span>
            </a>
            <a href={`../?hub=${guide.id}`} class="btn-map-link">
              <span>🗺️ Map View</span>
            </a>
          </div>
        </div>
      </article>
    ))}
  </section>

  <script is:inline>
    // Theme Switcher Sync
    const themeBtn = document.getElementById('theme-btn');
    const themeText = document.getElementById('theme-text');
    const savedTheme = localStorage.getItem('kapuluan_theme') || 'dark';

    if (savedTheme === 'light') {
      document.body.classList.add('theme-nordic-light');
      if (themeText) themeText.textContent = '🌑 ///M Dark';
    }

    themeBtn?.addEventListener('click', () => {
      const isLight = document.body.classList.toggle('theme-nordic-light');
      localStorage.setItem('kapuluan_theme', isLight ? 'light' : 'dark');
      if (themeText) themeText.textContent = isLight ? '🌑 ///M Dark' : '☀️ Nordic Light';
    });

    // Region Filter Buttons
    document.querySelectorAll('.filter-btn').forEach((btn) => {
      btn.addEventListener('click', () => {
        document.querySelectorAll('.filter-btn').forEach((b) => b.classList.remove('active'));
        btn.classList.add('active');
        const filter = btn.getAttribute('data-filter');

        document.querySelectorAll('.guide-card').forEach((card) => {
          const region = card.getAttribute('data-region') || '';
          if (filter === 'all' || region.includes(filter)) {
            card.style.display = 'flex';
          } else {
            card.style.display = 'none';
          }
        });
      });
    });
  </script>
</body>
</html>

